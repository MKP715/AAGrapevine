{%- set L = lang or "en" -%}
{%- set st = db.status -%}
<footer class="mt-16 border-t border-line bg-surface text-sm text-muted" style="padding-bottom: env(safe-area-inset-bottom)">
  {#- The footer mirrors the header: "Explore" (the top-level pages), one list per dropdown group
      (Get involved, Committee — nav.primary items with children) and "Stay updated" (the official
      aagrapevine.org / aalavina.org sites, the nav.footer entries of group "stay", the RSS and
      calendar feeds). Under the about blurb: About us · neta65.org · e-mail. The other site pages
      of group "site" (Accessibility, Saved pages & app, QR codes & posters, Search, Update status)
      sit on the right of the bottom bar with "Last updated"; the disclaimer takes its left side.
      Phones: the groups sit two per row and every link is a 44px touch target; sm: four across;
      lg+: the about blurb joins the row (the wrapper becomes display:contents so the groups are
      items of the outer grid). -#}
  <div class="site-footer-main container-page grid gap-8 py-10 md:py-12 lg:grid-cols-[minmax(0,1.6fr)_repeat(4,minmax(0,1fr))] lg:gap-6 xl:gap-12">
    <div>
      <a href="{{ '/' | lurl(L) }}" class="inline-flex items-center gap-3 no-underline">
        <span class="grid h-11 place-items-center rounded-lg bg-white px-1.5 ring-1 ring-black/5"><img src="/assets/img/logo-wide.png" alt="NETA 65" width="128" height="63" class="h-9 w-auto" loading="lazy"></span>
        <span class="font-display text-lg font-semibold text-ink">Grapevine / <span class="whitespace-nowrap">La&nbsp;Viña</span></span>
      </a>
      <p class="mt-4 max-w-sm leading-relaxed">{{ "footer.about" | t(L) }}</p>
      {#- About us (the page's own title) and neta65.org share a row, the e-mail gets the row under them:
          a tidy two-row block as wide as the blurb on phones and in the lg+ column (the two short
          buttons stack instead when they can't sit side by side: Spanish at 1024px, larger text —
          min-w-fit keeps each label whole, as larger text lets button labels wrap). From 640px to
          1023px the blurb has the whole width, so the three sit in one row at their own widths. -#}
      <p class="mt-4 flex max-w-sm flex-wrap gap-2 sm:max-w-none lg:max-w-sm">
        <a class="btn-secondary btn-sm min-w-fit flex-1 whitespace-nowrap sm:flex-none lg:flex-1" href="{{ '/about/' | lurl(L) }}"{% if pageKey == "about" %} aria-current="page"{% endif %}>{% icon "info", "size-4 shrink-0" %} {{ "read.about.title" | t(L) }}</a>
        <a class="btn-secondary btn-sm min-w-fit flex-1 whitespace-nowrap sm:flex-none lg:flex-1" href="{{ site.area_website }}" rel="noopener" target="_blank">{% icon "globe", "size-4 shrink-0" %} {{ site.area_website | hostname }}<span class="sr-only"> ({{ 'common.external' | t(L) }})</span></a>
        <a class="btn-secondary btn-sm basis-full sm:basis-auto lg:basis-full" href="mailto:{{ site.contact_email }}">{% icon "mail", "size-4 shrink-0" %} <span class="min-w-0">{{ site.contact_email | replace("@", "@<wbr>") | safe }}</span></a>
      </p>
    </div>
    <div class="site-footer-groups grid grid-cols-2 gap-x-6 gap-y-7 sm:grid-cols-4 lg:contents">
      <div>
        <h2 class="eyebrow mb-2 font-sans sm:mb-3">{{ "footer.explore" | t(L) }}</h2>
        <ul class="grid gap-y-0 sm:gap-y-2">
          {%- for item in nav.primary %}{% if not item.children %}
          <li class="flex"><a class="inline-flex min-h-11 min-w-11 items-center hover:text-gv sm:min-h-0 sm:min-w-0" href="{{ item.url | lurl(L) }}"{% if pageKey == item.page %} aria-current="page"{% endif %}>{{ item.key | t(L) }}</a></li>
          {%- endif %}{% endfor %}
        </ul>
      </div>
      {%- for item in nav.primary %}{% if item.children %}
      <div>
        <h2 class="eyebrow mb-2 font-sans sm:mb-3">{{ item.key | t(L) }}</h2>
        <ul class="grid gap-y-0 sm:gap-y-2">
          {%- for c in item.children %}
          <li class="flex"><a class="inline-flex min-h-11 items-center hover:text-gv sm:min-h-0" href="{{ c.url | lurl(L) }}"{% if pageKey == c.page %} aria-current="page"{% endif %}>{{ c.key | t(L) }}</a></li>
          {%- endfor %}
        </ul>
      </div>
      {%- endif %}{% endfor %}
      <div>
        <h2 class="eyebrow mb-2 font-sans sm:mb-3">{{ "footer.stay_updated" | t(L) }}</h2>
        <ul class="grid gap-y-0 sm:gap-y-2">
          {#- The official sites first (La Viña first on the Spanish pages). They leave this site, among
              links that stay on it, so they carry a small arrow as well as the screen-reader note (not
              below 360px, where the column has no room for it). A long name may wrap before ".org". -#}
          {%- set officialSites = [site.links.lv_home, site.links.gv_home] if L == "es" else [site.links.gv_home, site.links.lv_home] %}
          {%- for u in officialSites %}{% if u %}
          <li class="flex"><a class="inline-flex min-h-11 items-center gap-2 hover:text-gv sm:min-h-0" href="{{ u }}" target="_blank" rel="noopener">{% icon "grapes", "size-4 shrink-0" %} <span class="min-w-0">{{ u | hostname | replace(".", "<wbr>.") | safe }}</span>{% icon "arrow-up-right", "size-3.5 shrink-0 -ml-1 text-faint max-[359px]:hidden" %}<span class="sr-only"> ({{ 'common.external' | t(L) }})</span></a></li>
          {%- endif %}{% endfor %}
          {%- for f in nav.footer %}{% if f.group == "stay" %}
          <li class="flex"><a class="inline-flex min-h-11 items-center gap-2 hover:text-gv sm:min-h-0" href="{{ f.url | lurl(L) }}"{% if pageKey == f.page %} aria-current="page"{% endif %}>{% icon f.icon, "size-4" %} {{ f.key | t(L) }}</a></li>
          {%- endif %}{% endfor %}
          <li class="flex"><a class="inline-flex min-h-11 items-center gap-2 hover:text-gv sm:min-h-0" href="{{ '/feed.xml' | lurl(L) }}">{% icon "rss", "size-4" %} {{ "feeds.rss" | t(L) }}</a></li>
          <li class="flex"><a class="inline-flex min-h-11 items-center gap-2 hover:text-gv sm:min-h-0" href="{{ '/events.ics' | lurl(L) }}">{% icon "calendar-plus", "size-4" %} {{ "feeds.ics" | t(L) }}</a></li>
        </ul>
      </div>
    </div>
  </div>
  {#- Bottom bar. Right: the site pages (Accessibility, Saved pages & app, QR codes & posters, Search,
      Update status) over "Last updated … · ©". Left: the disclaimer. The right block comes first in
      the source (phones: links, time, then the disclaimer, as before); from 768px the grid puts it
      in the right column: as wide as its one-row width, or half the bar when that is less
      (fit-content), right-aligned. There the links and the time are inline runs with balanced lines
      (text-wrap: balance), so a wrapped row splits 2 + 3 instead of leaving "Update status" or the
      last word alone on a line. "Update status" is the link to /status/ (its dot is the live
      status), so the time next to it is text. -#}
  <div class="border-t border-line">
    <div class="container-page grid gap-4 py-6 text-xs leading-relaxed md:grid-cols-[minmax(0,1fr)_fit-content(50%)] md:items-start md:gap-x-10 xl:gap-x-16">
      <div class="md:col-start-2 md:row-start-1 md:text-right">
        <ul class="grid grid-cols-2 gap-x-6 sm:flex sm:flex-wrap sm:gap-y-2 md:-mt-1 md:block md:text-balance">
          {%- for f in nav.footer %}{% if f.group == "site" and f.page != "about" %}
          <li class="flex md:ml-5 md:inline-flex md:py-1 md:align-top"><a class="inline-flex min-h-11 items-center gap-1.5 font-medium hover:text-gv sm:min-h-0" href="{{ f.url | lurl(L) }}"{% if pageKey == f.page %} aria-current="page"{% endif %}>
            {%- if f.page == "status" %}<span class="relative flex size-2 shrink-0" aria-hidden="true"><span class="absolute inline-flex size-full animate-ping rounded-full bg-vine opacity-60"></span><span class="relative inline-flex size-2 rounded-full bg-vine"></span></span>
            {%- else %}{% icon f.icon, "size-3.5 shrink-0" %}{% endif %} {{ f.key | t(L) }}</a></li>
          {%- endif %}{% endfor %}
        </ul>
        <p class="mt-3 md:mt-1">{#- two runs, so a wrapped line breaks at the "·" -#}
          <span class="inline-block">{{ "footer.last_updated" | t(L) }} <time datetime="{{ site.built }}" data-local-time>{{ site.built | fmtDate(L, "datetime") }}</time> <span aria-hidden="true">·</span></span>
          <span class="inline-block">© {{ site.built | year }} {{ site | pick(L, "committee") }}</span></p>
      </div>
      <p class="max-w-4xl text-faint md:col-start-1 md:row-start-1">{{ "footer.disclaimer" | t(L) }}</p>
    </div>
  </div>
</footer>
