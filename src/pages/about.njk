---
pagination: { data: languages, size: 1, alias: lang }
permalink: "{{ '/' if lang == 'en' else '/es/' }}about/index.html"
layout: layouts/base.njk
pageKey: about
titleKey: nav.about
descKey: read.about.meta_desc
---
{#- ABOUT — the two magazines, our NETA 65 committee, how this site keeps itself
    up to date (visual explainer + live numbers from db.status), privacy &
    anonymity, contact, open-source credits. -#}
{% import "macros/ui.njk" as ui with context %}
{%- set st = db.status -%}
{#- The committee's Drive as the last sync saw it: link straight to the CURRENT Panel folder
    (the only one the site reads), never the shared root, which also holds older, unpublished
    folders and files the sync deliberately skips. -#}
{%- set di = st | cmDriveInfo(site) -%}
{%- set counts = [
  { k: "articles", icon: "book-open", n: st | readSourceCount("articles") },
  { k: "pdfs", icon: "file-text", n: st | readSourceCount("pdfs") },
  { k: "podcasts", icon: "headphones", n: st | readSourceCount("podcasts") },
  { k: "youtube", icon: "circle-play", n: st | readSourceCount("youtube") },
  { k: "instagram", icon: "instagram", n: st | readSourceCount("instagram") },
  { k: "drive", icon: "folder-open", n: st | readSourceCount("drive") }
] -%}
{%- set credits_web = [
  ["Eleventy", "https://www.11ty.dev", "MIT", "eleventy"],
  ["Tailwind CSS", "https://tailwindcss.com", "MIT", "tailwind"],
  ["Alpine.js", "https://alpinejs.dev", "MIT", "alpine"],
  ["MiniSearch", "https://github.com/lucaong/minisearch", "MIT", "minisearch"],
  ["GLightbox", "https://github.com/biati-digital/glightbox", "MIT", "glightbox"],
  ["lite-youtube-embed", "https://github.com/paulirish/lite-youtube-embed", "Apache-2.0", "liteyt"],
  ["Lucide", "https://lucide.dev", "ISC", "lucide"],
  ["markdown-it", "https://github.com/markdown-it/markdown-it", "MIT", "markdownit"],
  ["Fraunces", "https://github.com/undercasetype/Fraunces", "OFL-1.1", "fraunces"],
  ["Inter", "https://rsms.me/inter/", "OFL-1.1", "inter"]
] -%}
{%- set credits_bot = [
  ["CTranslate2", "https://github.com/OpenNMT/CTranslate2", "MIT", "ct2"],
  ["Argos Translate", "https://github.com/argosopentech/argos-translate", "MIT", "argos"],
  ["OPUS-MT", "https://github.com/Helsinki-NLP/Opus-MT", "CC-BY-4.0", "opusmt"],
  ["yt-dlp", "https://github.com/yt-dlp/yt-dlp", "Unlicense", "ytdlp"],
  ["feedparser", "https://github.com/kurtmckee/feedparser", "BSD-2-Clause", "feedparser"],
  ["Beautiful Soup", "https://www.crummy.com/software/BeautifulSoup/", "MIT", "bs4"],
  ["pypdfium2", "https://github.com/pypdfium2-team/pypdfium2", "Apache-2.0 / BSD-3", "pdfium"],
  ["Requests", "https://requests.readthedocs.io", "Apache-2.0", "requests"],
  ["Protego", "https://github.com/scrapy/protego", "BSD-3-Clause", "protego"],
  ["Pillow", "https://python-pillow.org", "MIT-CMU", "pillow"]
] -%}

{#- The shared hero (same height on every page). Its buttons are the standard 44px / 14px size
    at every width, like every other page; "read-hero" (read.css) keeps phone heroes within
    24–28rem. -#}
{% call ui.pageHero(lang, "read.about.title" | t(lang), "read.about.subtitle" | t(lang), "info", "read.about.eyebrow" | t(lang), { class: "read-hero" }) %}
  <div class="hero-actions">
    <a class="btn-light" href="#how">{% icon "workflow", "size-4" %} {{ "read.about.how_btn" | t(lang) }}</a>
    <a class="btn-on-dark" href="#contact">{% icon "mail", "size-4" %} {{ "read.about.contact_btn" | t(lang) }}</a>
  </div>
{% endcall %}

{#- ---------- The two magazines ---------- -#}
<section class="container-page page-start" aria-label="{{ 'read.about.mags_title' | t(lang) }}">
  {{ ui.sectionHead("read.about.mags_title" | t(lang), "read.about.mags_sub" | t(lang), "", "", "grapes") }}

  <ol class="read-timeline mb-10 grid grid-cols-1 gap-6 pl-8 md:grid-cols-3 md:pl-0 md:pt-8">
    {% for m in [["1944", "bg-gv", "tl1"], ["1996", "bg-lv", "tl2"], ["read.about.today", "bg-vine", "tl3"]] %}
    <li class="relative">
      <span class="absolute -left-[1.85rem] top-1 size-4 rounded-full border-4 border-paper {{ m[1] }} md:-top-[2.3rem] md:left-0" aria-hidden="true"></span>
      <p class="font-display text-3xl font-semibold text-ink">{{ (m[0] | t(lang)) if m[0].startsWith("read.") else m[0] }}</p>
      <p class="mt-1 text-sm leading-relaxed text-muted">{{ ("read.about." + m[2]) | t(lang) }}</p>
    </li>
    {% endfor %}
  </ol>

  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    {% for p in (["lv", "gv"] if lang == "es" else ["gv", "lv"]) %}
    {%- set isLv = p == "lv" -%}
    {#- @container: when the card is wide (two cards side by side on a big screen) the story
        keeps a readable line length and the facts move into a column beside it -#}
    <article class="card @container overflow-hidden">
      <header class="read-cover {{ 'read-cover--lv' if isLv else 'read-cover--gv' }} relative isolate overflow-hidden px-6 py-6 text-white sm:px-8">
        <svg class="read-cover-art w-36!" viewBox="0 0 200 240" fill="none" aria-hidden="true"><g fill="currentColor"><circle cx="82" cy="96" r="17"/><circle cx="116" cy="96" r="17"/><circle cx="66" cy="126" r="17"/><circle cx="100" cy="126" r="17"/><circle cx="134" cy="128" r="17"/><circle cx="82" cy="156" r="17"/><circle cx="116" cy="156" r="17"/><circle cx="100" cy="186" r="17"/></g></svg>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-white/70">{{ ("read.about.lv_kicker" if isLv else "read.about.gv_kicker") | t(lang) }}</p>
        <h3 class="mt-1 flex items-center gap-2 font-display text-3xl font-semibold">{% icon "grapes", "size-7" %} {{ "La Viña" if isLv else "AA Grapevine" }}</h3>
      </header>
      <div class="grid grid-cols-1 p-6 sm:p-8 @3xl:grid-cols-[minmax(0,1fr)_12rem] @3xl:gap-x-10">
        <div class="measure">
          <p class="leading-relaxed text-ink">{{ ("read.about.lv_p1" if isLv else "read.about.gv_p1") | t(lang) }}</p>
          <p class="mt-3 leading-relaxed text-muted">{{ ("read.about.lv_p2" if isLv else "read.about.gv_p2") | t(lang) }}</p>
        </div>
        <dl class="mt-5 grid grid-cols-3 gap-3 border-t border-line pt-5 text-sm @3xl:mt-0 @3xl:grid-cols-1 @3xl:content-start @3xl:gap-4 @3xl:border-t-0 @3xl:border-l @3xl:pt-0 @3xl:pl-6">
          <div><dt class="text-xs font-semibold uppercase tracking-wider text-muted">{{ "read.about.f_first" | t(lang) }}</dt><dd class="mt-0.5 font-semibold text-ink">{{ ("read.about.lv_first" if isLv else "read.about.gv_first") | t(lang) }}</dd></div>
          <div><dt class="text-xs font-semibold uppercase tracking-wider text-muted">{{ "read.about.f_freq" | t(lang) }}</dt><dd class="mt-0.5 font-semibold text-ink">{{ ("read.subs.f_every2" if isLv else "read.subs.f_monthly") | t(lang) }}</dd></div>
          <div><dt class="text-xs font-semibold uppercase tracking-wider text-muted">{{ "read.about.f_lang" | t(lang) }}</dt><dd class="mt-0.5 font-semibold text-ink">{{ ("common.spanish" if isLv else "common.english") | t(lang) }}</dd></div>
        </dl>
        <a class="link mt-5 inline-flex items-center gap-1 justify-self-start text-sm @3xl:col-span-2" href="{{ site.links.lv_home if isLv else site.links.gv_home }}" target="_blank" rel="noopener">{{ (site.links.lv_home if isLv else site.links.gv_home) | hostname }} {% icon "arrow-up-right", "size-4" %}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a>
      </div>
    </article>
    {% endfor %}
  </div>
</section>

{#- ---------- Our committee ---------- -#}
<section class="border-y border-line bg-surface-2/60" aria-labelledby="committee-title">
  <div class="container-page section grid grid-cols-1 gap-10 lg:grid-cols-[1fr_1.2fr]">
    <div>
      <p class="eyebrow">{{ site | pick(lang, "area") }}</p>
      <h2 id="committee-title" class="h-section mt-2">{{ "read.about.com_title" | t(lang) }}</h2>
      <p class="lead mt-4">{{ "read.about.com_p1" | t(lang) }}</p>
      <p class="mt-3 leading-relaxed text-muted">{{ "read.about.com_p2" | t(lang) }}</p>
      <div class="mt-6 flex flex-wrap gap-2.5">
        <a class="btn-primary" href="{{ '/meetings/' | lurl(lang) }}">{% icon "video", "size-4" %} {{ "read.about.com_meeting" | t(lang) }}</a>
        {% if site.committee_page %}<a class="btn-secondary" href="{{ site.committee_page }}" target="_blank" rel="noopener">{{ "read.about.com_area_page" | t(lang) }} {% icon "arrow-up-right", "size-4" %}</a>{% endif %}
      </div>
      {% if meeting.next %}<p class="mt-4 text-sm text-muted">{% icon "calendar-days", "size-4 inline -mt-0.5 text-gv" %} {{ "read.about.com_next" | t(lang, {date: meeting.next.start | fmtDate(lang, "long"), time: meeting.next.start | fmtDate(lang, "time")}) }}</p>{% endif %}
    </div>
    <div>
      <h3 class="eyebrow mb-3 font-sans">{{ "read.about.serve_title" | t(lang) }}</h3>
      <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
        {% for w in [["house", "bg-gv-soft text-gv", "w1"], ["badge-check", "bg-lv-soft text-lv", "w2"], ["map", "bg-vine-soft text-vine", "w3"], ["languages", "bg-grape-soft text-grape", "w4"]] %}
        <li class="card card-pad">
          <div class="flex items-center gap-3">
            <span class="grid size-11 shrink-0 place-items-center rounded-xl {{ w[1] }}">{% icon w[0], "size-5" %}</span>
            <h4 class="h-card min-w-0 flex-1">{{ ("read.about." + w[2] + "_t") | t(lang) }}</h4>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-muted">{{ ("read.about." + w[2]) | t(lang) }}</p>
        </li>
        {% endfor %}
      </ul>
    </div>
  </div>
</section>

{#- ---------- How this site stays up to date ---------- -#}
<section id="how" class="section container-page scroll-mt-16" aria-labelledby="how-title">
  <div class="mx-auto max-w-3xl text-center">
    <p class="eyebrow">{{ "read.about.how_eyebrow" | t(lang) }}</p>
    <h2 id="how-title" class="h-display mt-2 text-3xl sm:text-4xl">{{ "read.about.how_title" | t(lang) }}</h2>
    <p class="lead mt-4">{{ "read.about.how_sub" | t(lang) }}</p>
  </div>

  <ol class="read-flow mt-12" aria-label="{{ 'read.about.how_title' | t(lang) }}">
    {#- 1. Sources -#}
    <li class="read-flow-step">
      <div class="card card-pad h-full">
        <div class="flex items-center gap-3">
          <span class="read-num grid size-12 shrink-0 place-items-center rounded-2xl bg-gv text-lg font-bold text-white dark:text-paper">1</span>
          <h3 class="h-card">{{ "read.about.s1_t" | t(lang) }}</h3>
        </div>
        <ul class="mt-4 space-y-2 text-sm">
          {% for s in [["grapes", "aagrapevine.org", "src_gv", "text-gv"], ["grapes", "aalavina.org", "src_lv", "text-lv"], ["youtube", "YouTube", "src_yt", "text-grape"], ["headphones", "Podcast", "src_pod", "text-grape"], ["instagram", "Instagram", "src_ig", "text-grape"], ["folder-open", "Google Drive", "src_drive", "text-vine"]] %}
          <li class="flex items-start gap-2.5">
            <span class="mt-0.5 {{ s[3] }}">{% icon s[0], "size-4" %}</span>
            <span><strong class="font-semibold text-ink">{{ s[1] }}</strong> <span class="text-muted">— {{ ("read.about." + s[2]) | t(lang) }}</span></span>
          </li>
          {% endfor %}
        </ul>
      </div>
    </li>
    {#- 2. Daily robot -#}
    <li class="read-flow-step">
      <div class="card card-pad h-full">
        <div class="flex items-center gap-3">
          <span class="read-num grid size-12 shrink-0 place-items-center rounded-2xl bg-grape text-lg font-bold text-white dark:text-paper">2</span>
          <h3 class="h-card">{{ "read.about.s2_t" | t(lang) }}</h3>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-muted">{{ "read.about.s2" | t(lang) }}</p>
        <p class="mt-4 inline-flex items-center gap-2 rounded-full bg-grape-soft px-3 py-1.5 text-xs font-semibold text-grape">
          <span class="read-flow-pulse size-2 rounded-full bg-grape" aria-hidden="true"></span>{{ "read.about.s2_badge" | t(lang) }}
        </p>
      </div>
    </li>
    {#- 3. Translation -#}
    <li class="read-flow-step">
      <div class="card card-pad h-full">
        <div class="flex items-center gap-3">
          <span class="read-num grid size-12 shrink-0 place-items-center rounded-2xl bg-lv text-lg font-bold text-white dark:text-paper">3</span>
          <h3 class="h-card">{{ "read.about.s3_t" | t(lang) }}</h3>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-muted">{{ "read.about.s3" | t(lang) }}</p>
        <p class="mt-4 flex items-center gap-2 text-sm font-semibold text-ink">
          <span class="rounded-md bg-gv-soft px-2 py-0.5 text-xs font-bold text-gv">EN</span>
          {% icon "arrow-left-right", "size-4 text-faint" %}
          <span class="rounded-md bg-lv-soft px-2 py-0.5 text-xs font-bold text-lv">ES</span>
        </p>
        <p class="mt-3">{% icon "languages", "size-3 inline -mt-0.5 text-faint" %} <span class="text-xs text-muted">{{ "read.about.s3_note" | t(lang) }}</span></p>
      </div>
    </li>
    {#- 4. This site -#}
    <li class="read-flow-step">
      <div class="card card-pad h-full ring-2 ring-vine/30">
        <div class="flex items-center gap-3">
          <span class="read-num grid size-12 shrink-0 place-items-center rounded-2xl bg-vine text-lg font-bold text-white dark:text-paper">4</span>
          <h3 class="h-card">{{ "read.about.s4_t" | t(lang) }}</h3>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-muted">{{ "read.about.s4" | t(lang) }}</p>
        <ul class="mt-4 flex flex-wrap gap-1.5 text-xs">
          <li><a class="badge-vine min-h-7 no-underline" href="{{ '/whats-new/' | lurl(lang) }}">{{ "nav.whats_new" | t(lang) }}</a></li>
          <li><a class="badge-vine min-h-7 no-underline" href="{{ '/feed.xml' | lurl(lang) }}">RSS</a></li>
          <li><a class="badge-vine min-h-7 no-underline" href="{{ '/events.ics' | lurl(lang) }}">.ics</a></li>
          <li><a class="badge-vine min-h-7 no-underline" href="{{ '/digest/' | lurl(lang) }}">{{ "nav.digest" | t(lang) }}</a></li>
        </ul>
      </div>
    </li>
  </ol>

  {#- Live numbers from the last update -#}
  <div class="mt-10 card overflow-hidden">
    <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line px-5 py-4 sm:px-6">
      <p class="flex items-center gap-2 text-sm font-semibold text-ink">
        <span class="relative flex size-2.5"><span class="absolute inline-flex size-full animate-ping rounded-full bg-vine opacity-60"></span><span class="relative inline-flex size-2.5 rounded-full bg-vine"></span></span>
        {% if st.generated and (st | readSourceCount("articles") or st | readSourceCount("pdfs") or st | readSourceCount("youtube")) %}
          <span>{{ "read.about.last_sync" | t(lang) }} <time datetime="{{ st.generated }}" data-local-time>{{ st.generated | fmtDate(lang, "datetime") }}</time></span>
        {% else %}
          <span>{{ "read.about.first_sync" | t(lang) }}</span>
        {% endif %}
      </p>
      <a class="inline-flex min-h-10 items-center gap-1 text-sm font-semibold text-gv hover:underline" href="{{ '/status/' | lurl(lang) }}">{{ "read.about.status_link" | t(lang) }} {% icon "arrow-right", "size-4" %}</a>
    </div>
    <dl class="grid grid-cols-2 gap-px bg-line sm:grid-cols-3 lg:grid-cols-6">
      {% for c in counts %}
      <div class="bg-surface p-5">
        <dt class="flex items-center gap-1.5 text-xs font-semibold uppercase tracking-wider text-muted">{% icon c.icon, "size-3.5" %} {{ ("read.about.n_" + c.k) | t(lang) }}</dt>
        {% if c.n %}<dd class="read-num mt-1 font-display text-3xl font-semibold text-ink">{{ c.n }}</dd>
        {% elif c.k == "drive" and st.generated %}<dd class="mt-2 flex items-center gap-1.5 text-sm font-medium leading-snug text-vine">{% icon "folder-up", "size-4 shrink-0" %} {{ "read.about.n_drive_zero" | t(lang) }}</dd>
        {% else %}<dd class="read-num mt-1 font-display text-3xl font-semibold text-ink">—</dd>{% endif %}
      </div>
      {% endfor %}
    </dl>
  </div>

  <div class="mt-6 grid grid-cols-1 gap-4 md:grid-cols-2">
    <div class="rounded-[var(--radius-card)] border border-line bg-surface p-5">
      <p class="flex items-center gap-2 font-semibold text-ink">{% icon "folder-up", "size-5 text-vine" %} {{ "read.about.drive_title" | t(lang) }}</p>
      <p class="mt-1.5 text-sm leading-relaxed text-muted">{{ "read.about.drive_text" | t(lang) }}</p>
      {% if di.panel and di.panel.url %}<a class="link mt-2 inline-block text-sm" href="{{ di.panel.url }}" target="_blank" rel="noopener">{{ "read.about.drive_link" | t(lang, {panel: di.panel.label}) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a>{% endif %}
    </div>
    <div class="rounded-[var(--radius-card)] border border-line bg-surface p-5">
      <p class="flex items-center gap-2 font-semibold text-ink">{% icon "shield-check", "size-5 text-gv" %} {{ "read.about.polite_title" | t(lang) }}</p>
      <p class="mt-1.5 text-sm leading-relaxed text-muted">{{ "read.about.polite_text" | t(lang) }}</p>
    </div>
  </div>
</section>

{#- ---------- Privacy & anonymity + contact ---------- -#}
<section class="section container-page pt-0" aria-labelledby="privacy-title">
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-[1.4fr_1fr]">
    <div class="card card-pad sm:p-8">
      <span class="grid size-12 place-items-center rounded-2xl bg-vine-soft text-vine">{% icon "eye-off", "size-6" %}</span>
      <h2 id="privacy-title" class="mt-4 font-display text-2xl font-semibold">{{ "read.about.privacy_title" | t(lang) }}</h2>
      <ul class="mt-4 space-y-3">
        {% for n in range(1, 6) %}
        <li class="flex gap-3"><span class="mt-0.5 text-vine">{% icon "circle-check", "size-5" %}</span><span class="leading-relaxed text-ink">{{ ("read.about.privacy" + n) | t(lang) }}</span></li>
        {% endfor %}
      </ul>
    </div>
    <div id="contact" class="card card-pad scroll-mt-24 sm:p-8">
      <span class="grid size-12 place-items-center rounded-2xl bg-gv-soft text-gv">{% icon "mail", "size-6" %}</span>
      <h2 class="mt-4 font-display text-2xl font-semibold">{{ "read.about.contact_title" | t(lang) }}</h2>
      <p class="mt-2 leading-relaxed text-muted">{{ "read.about.contact_text" | t(lang) }}</p>
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <a class="btn-primary" href="mailto:{{ site.contact_email }}">{% icon "send", "size-4" %} {{ site.contact_email }}</a>
        <button type="button" class="btn-ghost btn-sm" data-copy="{{ site.contact_email }}">{% icon "copy", "size-4" %} {{ "common.copy" | t(lang) }}</button>
      </div>
      <ul class="mt-5 space-y-2 border-t border-line pt-4 text-sm">
        <li><a class="link" href="{{ '/meetings/' | lurl(lang) }}">{{ "nav.meeting" | t(lang) }}</a></li>
        {% if site.area_website %}<li><a class="link" href="{{ site.area_website }}" target="_blank" rel="noopener">{{ site | pick(lang, "area") }} — {{ site.area_website | hostname }}</a></li>{% endif %}
        <li><a class="link" href="{{ site.links.aa_org_es if lang == 'es' else site.links.aa_org }}" target="_blank" rel="noopener">{{ "read.about.find_meeting" | t(lang) }}</a></li>
      </ul>
    </div>
  </div>
</section>

{#- ---------- Open-source credits ---------- -#}
<section class="section border-t border-line bg-surface-2/60" aria-label="{{ 'read.about.credits_title' | t(lang) }}">
  <div class="container-page">
    {{ ui.sectionHead("read.about.credits_title" | t(lang), "read.about.credits_sub" | t(lang), "", "", "heart") }}
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
      {% for group in [["cr_web", credits_web, "layout-template"], ["cr_bot", credits_bot, "bot"]] %}
      {#- @container: each list splits into two columns when it is wide (read.css .read-credit-list) -#}
      {%- set half = ((group[1].length + 1) / 2) | round(0, "floor") %}
      <div class="@container">
        <h3 class="mb-3 flex items-center gap-2 font-sans text-sm font-semibold uppercase tracking-[0.12em] text-muted">{% icon group[2], "size-4 text-gv" %} {{ ("read.about." + group[0]) | t(lang) }}</h3>
        <ul class="read-credit-list card overflow-hidden" style="--rows: {{ half }}">
          {% for c in group[1] %}
          <li class="{{ 'read-credit-c1' if loop.index <= half }}{{ ' read-credit-c2top' if loop.index == half + 1 }}">
            <a class="group flex min-h-14 items-center gap-3 px-4 py-2.5 no-underline transition hover:bg-surface-2" href="{{ c[1] }}" target="_blank" rel="noopener">
              <span class="min-w-0 flex-1">
                <span class="block font-semibold text-ink group-hover:text-gv">{{ c[0] }}</span>
                <span class="block text-xs text-muted">{{ ("read.about.cr_" + c[3]) | t(lang) }}</span>
              </span>
              <span class="badge-muted shrink-0 font-mono">{{ c[2] }}</span>
            </a>
          </li>
          {% endfor %}
        </ul>
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{#- ---------- Disclaimer + how the site is hosted (two notes side by side from 1024px) ---------- -#}
