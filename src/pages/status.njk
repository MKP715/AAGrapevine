---
pagination: { data: languages, size: 1, alias: lang }
permalink: "{{ '/' if lang == 'en' else '/es/' }}status/index.html"
layout: layouts/base.njk
pageKey: status
titleKey: nav.status
descKey: community.status.meta_desc
pageScripts: ["/assets/js/community.js"]
---
{% import "macros/ui.njk" as ui with context %}
{#- Transparency dashboard built from db.status (written by build_data.py after
    every daily run). States: ok (vine) · failed (danger) · never run (muted);
    every state has an icon + label, never color alone. -#}
{%- set sv = db.status | cmStatus -%}
{%- set total = sv.sources | length -%}
{%- set crawler = site.sources.crawler or {} -%}
{%- set actionsUrl = "https://github.com/MKP715/AAGrapevine/actions" -%}
{%- set srcIcons = { drive: "folder-open", articles: "newspaper", pdfs: "file-text", youtube: "youtube", podcasts: "headphones", instagram: "instagram", editorial: "pen-line", events_external: "calendar-days", announcements: "megaphone", manual_events: "calendar-plus", weekly_open: "video", translations: "languages" } -%}

{% call ui.pageHero(lang, "nav.status" | t(lang), "community.status.hero_sub" | t(lang), "activity", "community.status.eyebrow" | t(lang)) %}
<div class="hero-actions cm-hero-tight">
  {% if not total %}
  <span class="inline-flex min-h-10 items-center gap-2 rounded-full bg-white/10 px-4 text-sm font-semibold text-white ring-1 ring-white/25">{% icon "circle-dashed", "size-4" %} {{ "community.status.not_run" | t(lang) }}</span>
  {% elif sv.failedCount %}
  <span class="inline-flex min-h-10 items-center gap-2.5 rounded-full bg-white/10 py-1 pl-1.5 pr-4 text-sm font-semibold text-white ring-1 ring-white/25"><span class="grid size-7 place-items-center rounded-full bg-danger text-white">{% icon "circle-alert", "size-4" %}</span> {{ "community.status.some_failed" | t(lang, { n: sv.failedCount, total: total }) }}</span>
  {% else %}
  <span class="inline-flex min-h-10 items-center gap-2.5 rounded-full bg-white/10 py-1 pl-1.5 pr-4 text-sm font-semibold text-white ring-1 ring-white/25"><span class="grid size-7 place-items-center rounded-full bg-vine text-white dark:text-paper">{% icon "check", "size-4" %}</span> {{ "community.status.all_ok" | t(lang) }}</span>
  {% endif %}
  {#- phones: this button is at the end of the page ("Behind the scenes"), so the hero keeps its height -#}
  <a class="btn-on-dark btn-sm max-sm:hidden" href="{{ actionsUrl }}" target="_blank" rel="noopener">{% icon "git-branch", "size-4" %} {{ "community.status.actions_btn" | t(lang) }}</a>
</div>
{% endcall %}

{#- ============ KPI row (tucks into the hero's faded edge) ============ -#}
<section class="container-page page-overlap" aria-label="{{ 'nav.status' | t(lang) }}">
  <dl class="grid grid-cols-2 gap-4 lg:grid-cols-4">
    <div class="card card-pad">
      <dt class="text-sm text-muted">{{ "community.status.kpi_build" | t(lang) }}</dt>
      <dd class="mt-1 text-2xl font-semibold text-ink"><time datetime="{{ site.built }}" data-relative>{{ site.built | fmtDate(lang, "datetime") }}</time></dd>
      <dd class="mt-0.5 text-xs text-muted"><time datetime="{{ site.built }}" data-local-time>{{ site.built | fmtDate(lang, "datetime") }}</time></dd>
    </div>
    <div class="card card-pad">
      <dt class="text-sm text-muted">{{ "community.status.kpi_sources" | t(lang) }}</dt>
      <dd class="mt-1 flex items-baseline gap-1.5 text-2xl font-semibold text-ink">{{ sv.okCount }} <span class="text-base font-medium text-muted">{{ "community.status.of" | t(lang, { n: total }) }}</span></dd>
      {% if sv.failedCount %}<dd class="mt-0.5 flex items-center gap-1 text-xs font-semibold text-danger">{% icon "circle-alert", "size-3.5" %} {{ sv.failedCount }} {{ "community.status.state_failed" | t(lang) | lower }}</dd>{% endif %}
    </div>
    <div class="card card-pad">
      <dt class="text-sm text-muted">{{ "community.status.kpi_items" | t(lang) }}</dt>
      <dd class="mt-1 text-2xl font-semibold text-ink">{{ sv.totalItems | cmNum(lang) }}</dd>
    </div>
    <div class="card card-pad">
      <dt class="text-sm text-muted">{{ "community.status.kpi_new" | t(lang) }}</dt>
      <dd class="mt-1 text-2xl font-semibold text-ink">{{ sv.found7d | cmNum(lang) }}</dd>
      <dd class="mt-0.5 text-xs leading-snug text-muted">{{ "community.status.found_help" | t(lang) }}</dd>
    </div>
  </dl>
</section>

{#- ============ Sources + crawl coverage / translations ============
    Below 1536px: the table, then the two cards side by side (from 1024px). From 1536px the
    two cards form a 30rem column next to the table. -#}
<section class="section container-page" aria-labelledby="src-title">
  <div class="mb-6">
    <h2 id="src-title" class="h-section flex items-center gap-2.5"><span class="text-gv">{% icon "radio-tower", "size-6" %}</span>{{ "community.status.sources_title" | t(lang) }}</h2>
    <p class="mt-1.5 max-w-2xl text-muted">{{ "community.status.sources_sub" | t(lang) }}</p>
  </div>
  <div class="cm-st-layout">
  <div class="min-w-0">
  {% if total %}
  <div class="card overflow-hidden">
    <table class="cm-st-table w-full text-left text-sm">
      <thead class="bg-surface-2/70 text-xs uppercase tracking-wider text-muted">
        <tr>
          <th scope="col" class="px-5 py-3 font-semibold">{{ "community.status.col_source" | t(lang) }}</th>
          <th scope="col" class="px-5 py-3 font-semibold">{{ "community.status.col_status" | t(lang) }}</th>
          <th scope="col" class="px-5 py-3 font-semibold">{{ "community.status.col_updated" | t(lang) }}</th>
          <th scope="col" class="px-5 py-3 text-right font-semibold">{{ "community.status.col_count" | t(lang) }}</th>
          <th scope="col" class="px-5 py-3 text-right font-semibold">{{ "community.status.col_new" | t(lang) }}</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line">
        {% for s in sv.sources %}
        {#- Our own wording when we have it; otherwise the pipeline's label (label_es in Spanish). -#}
        {%- set label = ("community.status.src." + s.source) | cmTOr(lang, (s.label_es if lang == "es" and s.label_es else s.label) or s.source) -%}
        <tr class="{{ 'bg-[color-mix(in_srgb,var(--c-danger)_6%,transparent)]' if s.state == 'failed' }}">
          <th scope="row" class="px-5 py-4 font-semibold text-ink">
            <span class="flex items-center gap-3">
              <span class="grid size-9 shrink-0 place-items-center rounded-lg bg-surface-2 text-muted">{% icon srcIcons[s.source] or "database", "size-4" %}</span>
              <span class="min-w-0">
                <span class="block">{{ label }}</span>
                {% if s.hint %}<span class="mt-0.5 block max-w-md text-xs font-normal leading-snug text-muted">{{ ("community.status.hint." + s.hint) | t(lang, { panel: s.panel or ("community.status.hint.panel_generic" | t(lang)) }) }}</span>{% endif %}
              </span>
            </span>
          </th>
          <td class="whitespace-nowrap px-5 py-4" data-label="{{ 'community.status.col_status' | t(lang) }}">
            {% if s.state == "ok" and not s.stale %}<span class="badge-vine">{% icon "circle-check", "size-3.5" %} {{ "community.status.state_ok" | t(lang) }}</span>
            {% elif s.state == "ok" and s.stale %}<span class="badge-muted" title="{{ 'community.status.stale_help' | t(lang, { n: s.ageDays }) }}">{% icon "clock", "size-3.5" %} {{ "community.status.state_stale" | t(lang) }}</span>
            {% elif s.state == "failed" %}<span class="badge bg-danger text-white dark:text-paper">{% icon "circle-x", "size-3.5" %} {{ "community.status.state_failed" | t(lang) }}</span>
            {% else %}<span class="badge-muted">{% icon "circle-dashed", "size-3.5" %} {{ "community.status.state_never" | t(lang) }}</span>{% endif %}
          </td>
          <td class="px-5 py-4" data-label="{{ 'community.status.col_updated' | t(lang) }}">
            {% if s.updated %}
            <time class="block font-medium text-ink" datetime="{{ s.updated | isoDate }}" data-relative>{{ s.updated | fmtDate(lang, "datetime") }}</time>
            <time class="block text-xs text-muted" datetime="{{ s.updated | isoDate }}" data-local-time>{{ s.updated | fmtDate(lang, "datetime") }}</time>
            {% if s.stale %}<span class="mt-0.5 block text-xs text-muted">{{ "community.status.stale_help" | t(lang, { n: s.ageDays }) }}</span>{% endif %}
            {% elif s.state == "failed" and s.attempted %}
            <span class="block text-xs text-muted">{{ "community.status.last_try" | t(lang) }}</span>
            <time class="block font-medium text-ink" datetime="{{ s.attempted | isoDate }}" data-local-time>{{ s.attempted | fmtDate(lang, "datetime") }}</time>
            {% else %}<span class="text-muted">{{ "community.status.never_help" | t(lang) }}</span>{% endif %}
          </td>
          <td class="px-5 py-4 text-right tabular-nums text-ink" data-label="{{ 'community.status.col_count' | t(lang) }}">{{ (s.count or 0) | cmNum(lang) }}</td>
          <td class="px-5 py-4 text-right tabular-nums" data-label="{{ 'community.status.col_new' | t(lang) }}">
            {% if s.new_7d %}<span class="font-semibold text-vine">+{{ s.new_7d | cmNum(lang) }}</span>{% else %}<span class="text-muted">0</span>{% endif %}
          </td>
        </tr>
        {% if s.state == "failed" %}
        {#- Calm, plain-language explanation first; the raw message is tucked away for the maintainer. -#}
        <tr class="cm-st-err bg-[color-mix(in_srgb,var(--c-danger)_6%,transparent)]">
          <td colspan="5" class="px-5 pb-4 pt-0">
            <p class="flex max-w-3xl gap-2 text-sm leading-relaxed text-ink">{% icon "info", "size-4 mt-0.5 shrink-0 text-danger" %}<span>{{ "community.status.failed_calm" | t(lang) }}{% if s.updated and s.ageDays >= 3 %} {{ "community.status.failed_repeat" | t(lang, { n: s.ageDays }) }}{% endif %}</span></p>
            {% if s.updated %}<p class="mt-1 pl-6 text-xs text-muted">{{ "community.status.last_ok" | t(lang) }}: <time datetime="{{ s.updated | isoDate }}" data-local-time>{{ s.updated | fmtDate(lang, "datetime") }}</time></p>{% endif %}
            {% if s.error %}
            <details class="cm-preview mt-2 ml-6 rounded-lg border border-line bg-surface">
              <summary class="flex min-h-10 cursor-pointer items-center gap-2 px-3 text-xs font-semibold text-muted">{{ "community.status.tech_details" | t(lang) }}</summary>
              <pre class="overflow-x-auto whitespace-pre-wrap border-t border-line p-3 font-mono text-xs text-ink">{{ s.error }}</pre>
            </details>
            {% endif %}
          </td>
        </tr>
        {% endif %}
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% else %}
  {{ ui.emptyState("circle-dashed", "community.status.no_sources_title" | t(lang), "community.status.no_sources_text" | t(lang), actionsUrl, "community.status.actions_btn" | t(lang)) }}
  {% endif %}
  <p class="mt-3 text-xs text-muted">{{ "community.status.local_time" | t(lang) }}{% if sv.generated %} · {{ "community.status.data_generated" | t(lang) }}: <time datetime="{{ sv.generated | isoDate }}" data-local-time>{{ sv.generated | fmtDate(lang, "datetime") }}</time>{% endif %}</p>
  </div>

  {#- ============ Crawl coverage + translations ============ -#}
  <div class="cm-st-side grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]" role="group" aria-label="{{ 'community.status.crawl_title' | t(lang) }}">
    <article class="card card-pad sm:p-8">
      <h2 class="h-card flex items-center gap-2 text-xl">{% icon "scan-search", "size-5 text-gv" %} {{ "community.status.crawl_title" | t(lang) }}</h2>
      <p class="measure mt-2 text-sm leading-relaxed text-muted">{{ "community.status.crawl_sub" | t(lang) }}</p>
      {% if sv.crawl.hasData %}
      <div class="mt-6">
        <div class="flex flex-wrap items-baseline justify-between gap-2">
          <p class="text-4xl font-semibold text-ink">{{ sv.crawl.pct | cmPct(lang) }}</p>
          <p class="text-sm text-muted">{{ "community.status.crawl_progress" | t(lang, { done: sv.crawl.crawled | cmNum(lang), total: sv.crawl.known | cmNum(lang) }) }}</p>
        </div>
        <div class="mt-3 h-3 overflow-hidden rounded-full bg-gv-soft" role="progressbar" aria-label="{{ 'community.status.crawl_meter' | t(lang) }}"
             aria-valuemin="0" aria-valuemax="100" aria-valuenow="{{ sv.crawl.pct }}" aria-valuetext="{{ sv.crawl.pct | cmPct(lang) }}">
          <div class="cm-meter-fill h-full rounded-full bg-gv" style="width: {{ sv.crawl.pct }}%"></div>
        </div>
        <p class="mt-3 flex items-center gap-2 text-sm font-semibold text-ink">
          {% icon "hourglass", "size-4 shrink-0 text-gv" %}
          <span>
          {%- if sv.crawl.daysLeft === 0 %}{{ "community.status.crawl_eta_done" | t(lang, { n: crawler.recheck_days or 21 }) }}
          {%- elif sv.crawl.daysLeft == 1 %}{{ "community.status.crawl_eta_one" | t(lang) }}
          {%- elif sv.crawl.daysLeft %}{{ "community.status.crawl_eta" | t(lang, { n: sv.crawl.daysLeft | cmNum(lang) }) }}
          {%- else %}{{ "community.status.crawl_eta_unknown" | t(lang) }}{% endif -%}
          </span>
        </p>
        <dl class="mt-6 grid grid-cols-2 gap-x-3 gap-y-4 border-t border-line pt-5 sm:grid-cols-4 2xl:grid-cols-2">
          <div class="flex flex-col"><dt class="flex-1 text-xs text-muted">{{ "community.status.crawl_pdfs" | t(lang) }}</dt><dd class="text-xl font-semibold tabular-nums text-ink">{{ sv.crawl.pdfs | cmNum(lang) }}</dd></div>
          <div class="flex flex-col"><dt class="flex-1 text-xs text-muted">{{ "community.status.crawl_thumbs" | t(lang) }}</dt><dd class="text-xl font-semibold tabular-nums text-ink">{{ sv.crawl.thumbs | cmNum(lang) }}</dd></div>
          <div class="flex flex-col"><dt class="flex-1 text-xs text-muted">{{ "community.status.crawl_left" | t(lang) }}</dt><dd class="text-xl font-semibold tabular-nums text-ink">{{ sv.crawl.remaining | cmNum(lang) }}</dd></div>
          <div class="flex flex-col"><dt class="flex-1 text-xs text-muted">{{ "community.status.crawl_perrun" | t(lang) }}</dt><dd class="text-xl font-semibold tabular-nums text-ink">{{ sv.crawl.perRun | cmNum(lang) }}</dd></div>
        </dl>
        {% if sv.crawl.errors %}<p class="mt-4 flex gap-2 text-xs leading-relaxed text-muted">{% icon "info", "size-4 shrink-0" %} {{ ("community.status.crawl_errors_one" if sv.crawl.errors == 1 else "community.status.crawl_errors") | t(lang, { n: sv.crawl.errors | cmNum(lang) }) }}</p>{% endif %}
        <p class="mt-4 text-xs leading-relaxed text-muted">{{ "community.status.crawl_note" | t(lang) }}{% if sv.crawl.updated %} · {{ "community.status.crawl_last" | t(lang) }}: <time datetime="{{ sv.crawl.updated | isoDate }}" data-local-time>{{ sv.crawl.updated | fmtDate(lang, "datetime") }}</time>{% endif %}</p>
      </div>
      {% else %}
      <p class="mt-6 rounded-xl border border-dashed border-line p-4 text-sm text-muted">{{ "community.status.crawl_empty" | t(lang) }}</p>
      {% endif %}
    </article>
    <article class="card card-pad sm:p-8">
      <h2 class="h-card flex items-center gap-2 text-xl">{% icon "languages", "size-5 text-grape" %} {{ "community.status.tr_title" | t(lang) }}</h2>
      <p class="mt-4 text-4xl font-semibold tabular-nums text-ink">{{ sv.translations.cached | cmNum(lang) }}</p>
      <p class="text-sm text-muted">{{ "community.status.tr_count" | t(lang) }}</p>
      <p class="mt-4 text-sm leading-relaxed text-muted">{{ "community.status.tr_text" | t(lang) }}</p>
      {% if sv.translations.pending or sv.translations.rejected or sv.translations.glossary %}
      <ul class="mt-4 space-y-2 border-t border-line pt-4 text-xs leading-relaxed text-muted" role="list">
        {% if sv.translations.pending %}<li class="flex gap-2">{% icon "hourglass", "size-4 shrink-0 text-grape" %}<span>{{ ("community.status.tr_pending_one" if sv.translations.pending == 1 else "community.status.tr_pending") | t(lang, { n: sv.translations.pending | cmNum(lang) }) }}</span></li>{% endif %}
        {% if sv.translations.rejected %}<li class="flex gap-2">{% icon "shield-check", "size-4 shrink-0 text-grape" %}<span>{{ ("community.status.tr_rejected_one" if sv.translations.rejected == 1 else "community.status.tr_rejected") | t(lang, { n: sv.translations.rejected | cmNum(lang) }) }}</span></li>{% endif %}
        {% if sv.translations.glossary %}<li class="flex gap-2">{% icon "book-a", "size-4 shrink-0 text-grape" %}<span>{{ "community.status.tr_glossary" | t(lang, { n: sv.translations.glossary | cmNum(lang) }) }}</span></li>{% endif %}
      </ul>
      {% endif %}
    </article>
  </div>
  </div>
</section>

{#- ============ Daily routine ============ -#}
<section class="section container-page" aria-labelledby="sched-title">
  <h2 id="sched-title" class="h-section flex items-center gap-2.5"><span class="text-gv">{% icon "calendar-clock", "size-6" %}</span>{{ "community.status.sched_title" | t(lang) }}</h2>
  <ol class="cm-steps mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4" role="list">
    {% for st in [{ k: "1", icon: "sunrise" }, { k: "2", icon: "cloud-download" }, { k: "3", icon: "languages" }, { k: "4", icon: "rocket" }] %}
    <li class="card card-pad relative">
      <span class="flex items-center gap-3">
        <span class="grid size-10 place-items-center rounded-full bg-gv text-white dark:text-paper">{% icon st.icon, "size-5" %}</span>
        <span class="text-xs font-bold uppercase tracking-wider text-muted">{{ loop.index }} / 4</span>
      </span>
      <h3 class="h-card mt-3">{{ ("community.status.sched_" + st.k + "_t") | t(lang) }}</h3>
      <p class="mt-1 text-sm leading-relaxed text-muted">{{ ("community.status.sched_" + st.k + "_d") | t(lang) }}</p>
    </li>
    {% endfor %}
  </ol>
  <div class="mt-8 flex flex-col gap-4 rounded-2xl border border-line bg-surface p-6 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <h3 class="h-card">{{ "community.status.actions_title" | t(lang) }}</h3>
      <p class="mt-1 max-w-2xl text-sm leading-relaxed text-muted">{{ "community.status.actions_text" | t(lang) }}</p>
    </div>
    <a class="btn-primary shrink-0" href="{{ actionsUrl }}" target="_blank" rel="noopener">{% icon "git-branch", "size-4" %} {{ "community.status.actions_btn" | t(lang) }}</a>
  </div>
</section>
