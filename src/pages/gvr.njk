---
pagination: { data: languages, size: 1, alias: lang }
permalink: "{{ '/' if lang == 'en' else '/es/' }}gvr/index.html"
layout: layouts/base.njk
pageKey: gvr
titleKey: nav.gvr
descKey: read.gvr.meta_desc
pageScripts: ["/assets/js/read.js"]
---
{#- GVR / RLV CORNER — the group representative's home: what the job is, a first-steps
    checklist (saved in the browser), the official GVR and RLV resource kits (db.pdfs,
    category gvr/rlv or found on /gvr-resources and /recursos), ideas for the home group
    and next steps. Flow (docs: ui.njk): hero → page nav → the job → first steps (band) →
    resource kits → ideas → next steps. -#}
{% import "macros/ui.njk" as ui with context %}
{%- set L = site.links -%}
{%- set gvrKit = db.pdfs | readKit("gvr") -%}
{%- set rlvKit = db.pdfs | readKit("rlv") -%}
{%- set gvHandbook = (db.pdfs | readPdfsMatching("\\bhandbook\\b|gvr handbook", 1))[0] -%}
{%- set lvHandbook = (db.pdfs | readPdfsMatching("manual del representante|manual del rlv|\\bmanual\\b", 1))[0] -%}
{%- set handbooks = ([lvHandbook, gvHandbook] if lang == "es" else [gvHandbook, lvHandbook]) | select -%}
{%- set kitOrder = ["rlv", "gvr"] if lang == "es" else ["gvr", "rlv"] -%}
{#- Kit grids (.read-kit-grid in read.css): 1 → 2 (640px) → 3 (1024px) → 4 (1536px) → 5 (1800px)
    columns. Each group shows two full rows (3 files on phones) until "Show all" or a search. -#}
{%- set groupIcons = { news: "newspaper", guides: "book-marked", flyers: "image", forms: "clipboard-list", other: "sparkles" } -%}

{#- One PDF in a kit -#}
{% macro kitCard(p, kit, lang, group="") %}
{%- set info = p | readPdfTitleInfo(lang) -%}
{%- set ex = p.extra or {} -%}
{%- set dl = p | readDocLang -%}
<li data-kit-item data-kit="{{ kit }}" data-text="{{ (info.title + ' ' + (info.gloss or '') + ' ' + (p.title or '') + ' ' + group + ' ' + ((p.tags or []) | join(' '))) | lower }}"
    x-show="match($el)">
  <a href="{{ p.url }}" target="_blank" rel="noopener" class="card card-link group flex h-full items-start gap-3 p-2.5 no-underline sm:p-3">
    <span class="relative aspect-[3/4] w-11 shrink-0 overflow-hidden rounded-lg border border-line bg-surface-2 sm:w-14">
      {% if ex.thumb %}<img src="{{ ex.thumb }}" alt="" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover object-top">
      {% else %}<span class="read-pdf-ph {{ 'read-accent-lv' if kit == 'rlv' else 'read-accent-gv' }} absolute inset-0">{% icon "file-text", "relative size-5" %}</span>{% endif %}
    </span>
    <span class="flex min-w-0 flex-1 flex-col gap-1">
      <span class="line-clamp-2 text-sm font-semibold leading-snug text-ink transition {{ 'group-hover:text-lv' if kit == 'rlv' else 'group-hover:text-gv' }}" lang="{{ info.lang or p.lang }}">{{ info.title }}</span>
      {% if info.gloss and info.machine %}<span class="flex items-center gap-1 text-xs leading-snug text-muted" title="{{ 'common.auto_translated' | t(lang) }} — {{ 'common.auto_translated_help' | t(lang) }}">{% icon "languages", "size-3 shrink-0" %}<span class="sr-only">{{ "common.auto_translated" | t(lang) }}:</span><span class="line-clamp-1" lang="{{ info.glossLang }}">{{ info.gloss }}</span></span>
      {% elif info.gloss %}<span class="flex items-center gap-1 text-xs leading-snug text-muted" title="{{ 'read.title_translation' | t(lang) }}"><span class="sr-only">{{ "read.title_translation" | t(lang) }}:</span><span class="line-clamp-1" lang="{{ info.glossLang }}">{{ info.gloss }}</span></span>{% endif %}
      <span class="flex flex-wrap items-center gap-1.5 text-xs text-muted">
        {% if p.is_new %}<span class="badge-new">{{ "common.new" | t(lang) }}</span>{% endif %}
        {% if dl and dl != lang %}<span class="badge-muted uppercase" title="{{ ('lang.' + dl) | t(lang) }}">{{ dl }}</span>{% endif %}
        {% if ex.upload_month %}<span>{{ ex.upload_month | readMonth(lang) }}</span>{% elif p.date %}<span>{{ p.date | readMonth(lang) }}</span>{% endif %}
        {% if ex.pages %}<span>· {{ ("read.one_page" if ex.pages == 1 else "common.pages") | t(lang, {n: ex.pages}) }}</span>{% endif %}
      </span>
    </span>
    <span class="sr-only">({{ "kind.pdf" | t(lang) | lower }}, {{ "common.external" | t(lang) }})</span>
  </a>
</li>
{% endmacro %}

{#- One official kit (GVR or RLV), grouped by type. Every group is ONE .read-kit-group element
    (the forms pointer included): the kit filter and "Show all" work group by group. -#}
{% macro kitBlock(kit, items, lang) %}
{%- set isLv = kit == "rlv" -%}
<div id="kit-{{ kit }}" x-show="kitVisible('{{ kit }}')">
  <div class="read-cover {{ 'read-cover--lv' if isLv else 'read-cover--gv' }} relative isolate flex flex-wrap items-center justify-between gap-4 overflow-hidden rounded-[var(--radius-card)] px-5 py-5 text-white sm:px-7">
    <svg class="read-cover-art w-32! -bottom-10!" viewBox="0 0 200 240" fill="none" aria-hidden="true"><g fill="currentColor"><circle cx="82" cy="96" r="17"/><circle cx="116" cy="96" r="17"/><circle cx="66" cy="126" r="17"/><circle cx="100" cy="126" r="17"/><circle cx="134" cy="128" r="17"/><circle cx="82" cy="156" r="17"/><circle cx="116" cy="156" r="17"/><circle cx="100" cy="186" r="17"/></g></svg>
    <div>
      <h3 class="flex items-center gap-2 font-display text-2xl font-semibold">{% icon "badge-check", "size-6" %} {{ ("read.gvr.kit_rlv" if isLv else "read.gvr.kit_gvr") | t(lang) }}</h3>
      <p class="mt-1 text-sm text-white/80">{{ ("read.gvr.kit_rlv_sub" if isLv else "read.gvr.kit_gvr_sub") | t(lang, {n: items.length}) }}</p>
    </div>
    <a class="btn-on-dark btn-sm" href="{{ L.rlv_resources if isLv else L.gvr_resources }}" target="_blank" rel="noopener">{{ "read.gvr.official_page" | t(lang) }} {% icon "arrow-up-right", "size-4" %}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a>
  </div>
  {% if items.length %}
  {#- The groups share one grid with the files' columns (read.css .read-kit-groups): a group of one
      or two cards (the Shop pointers: news & catalogs, order forms) takes just that many columns,
      and those two come first, so they sit side by side instead of each leaving empty columns. -#}
  {%- set gs = items | readKitGroups -%}
  {%- set ordered = [] -%}
  {%- for key in ["news", "forms", "guides", "flyers", "other"] %}{% for g in gs %}{% if g.key == key and ordered.push(g) %}{% endif %}{% endfor %}{% endfor -%}
  {%- for g in gs %}{% if g.key not in ["news", "forms", "guides", "flyers", "other"] and ordered.push(g) %}{% endif %}{% endfor -%}
  <div class="read-kit-groups mt-5">
    {% for g in ordered %}
    {#- cards shown: the forms pointer = 1; news = its files + one "Catalogs: in the Shop" card -#}
    {%- set cats = [] -%}
    {%- if g.key == "news" %}{% for p in g.items %}{% if ("catalog" in (p.tags or []) or r/cat[aá]logo/i.test(p.title or "")) and cats.push(1) %}{% endif %}{% endfor %}{% endif -%}
    {%- set nt = 1 if g.key == "forms" else (g.items.length - (cats | length) + (1 if cats | length else 0)) -%}
    <div role="group" class="read-kit-group{{ (' is-small is-n' ~ nt) if nt <= 2 }}" x-data="{ more: false }" :class="{ 'is-js': true, 'is-more': more || q }" x-show="groupHas($el)" aria-labelledby="kit-{{ kit }}-{{ g.key }}">
      <h4 id="kit-{{ kit }}-{{ g.key }}" class="mb-3 flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.12em] text-muted">
        <span class="{{ 'text-lv' if isLv else 'text-gv' }}">{% icon groupIcons[g.key], "size-4" %}</span>{{ ("read.gvr.g_" + g.key) | t(lang) }}
        <span class="badge-muted normal-case tracking-normal">{{ g.items.length }}</span>
      </h4>
      {% if g.key == "forms" %}
      {#- Order & subscription forms have ONE home: the Shop (/shop/#forms-title) — one pointer here -#}
      <ul class="read-kit-grid">
        <li data-kit-item data-kit="{{ kit }}" data-text="{{ (('read.gvr.g_forms' | t(lang)) + ' ' + ('read.gvr.forms_in_shop' | t(lang)) + ' ' + (g.items | join(' ', 'title'))) | lower }}" x-show="match($el)">
          <a href="{{ '/shop/' | lurl(lang) }}#forms-title" class="card card-link group flex h-full items-center gap-3 p-2.5 no-underline sm:p-3">
            <span class="grid size-11 shrink-0 place-items-center rounded-lg {{ 'bg-lv-soft text-lv' if isLv else 'bg-gv-soft text-gv' }}">{% icon "shopping-bag", "size-5" %}</span>
            <span class="flex min-w-0 flex-1 flex-col gap-0.5">
              <span class="text-sm font-semibold leading-snug text-ink {{ 'group-hover:text-lv' if isLv else 'group-hover:text-gv' }}">{{ "read.gvr.forms_in_shop" | t(lang) }}</span>
              <span class="text-xs text-muted">{{ "read.gvr.forms_in_shop_sub" | t(lang, { n: g.items.length }) }}</span>
            </span>
            {% icon "arrow-right", "size-4 shrink-0 text-faint" %}
          </a>
        </li>
      </ul>
      {% else %}
      {#- Catalogs have ONE home too (/shop/#catalogs): in "News & catalogs" they are one pointer card -#}
      {%- set hasCat = false -%}
      <ul class="read-kit-grid">
        {% for p in g.items %}
        {%- set isCat = g.key == "news" and ("catalog" in (p.tags or []) or r/cat[aá]logo/i.test(p.title or "")) -%}
        {% if isCat %}{% set hasCat = true %}{% else %}{{ kitCard(p, kit, lang, ("read.gvr.g_" + g.key) | t(lang)) }}{% endif %}
        {% endfor %}
        {% if hasCat %}
        <li data-kit-item data-kit="{{ kit }}" data-text="{{ (('read.subs.cat_title' | t(lang)) + ' catalog catálogo') | lower }}" x-show="match($el)">
          <a href="{{ '/shop/' | lurl(lang) }}#catalogs" class="card card-link group flex h-full items-center gap-3 p-2.5 no-underline sm:p-3">
            <span class="grid size-11 shrink-0 place-items-center rounded-lg {{ 'bg-lv-soft text-lv' if isLv else 'bg-gv-soft text-gv' }}">{% icon "book-open", "size-5" %}</span>
            <span class="flex min-w-0 flex-1 flex-col gap-0.5">
              <span class="text-sm font-semibold leading-snug text-ink {{ 'group-hover:text-lv' if isLv else 'group-hover:text-gv' }}">{{ "read.gvr.catalogs_in_shop" | t(lang) }}</span>
            </span>
            {% icon "arrow-right", "size-4 shrink-0 text-faint" %}
          </a>
        </li>
        {% endif %}
      </ul>
      {#- The button only shows at widths where some files are folded away: 3 on phones, then
          two rows of 2 / 3 / 4 / 5 columns (4 · 6 · 8 · 10 files) — same steps as read.css. -#}
      {%- set nk = g.items.length -%}
      {% if nk > 3 %}
      {%- set btnHide = "sm:hidden" if nk <= 4 else ("lg:hidden" if nk <= 6 else ("2xl:hidden" if nk <= 8 else ("min-[1800px]:hidden" if nk <= 10 else ""))) -%}
      <button type="button" class="btn-ghost btn-sm mt-2 {{ 'text-lv' if isLv else 'text-gv' }} {{ btnHide }}" x-show="!q" x-cloak @click="more = !more" :aria-expanded="more.toString()">
        <span x-show="!more">{{ "read.gvr.show_all" | t(lang, {n: nk}) }}</span>
        <span x-show="more">{{ "common.show_less" | t(lang) }}</span>
        {% icon "chevron-down", "size-4 transition" %}
      </button>
      {% endif %}
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% else %}
  <div class="mt-5">
    {{ ui.emptyState("folder-open", "read.gvr.kit_empty" | t(lang), "read.gvr.kit_empty_text" | t(lang), (L.rlv_resources if isLv else L.gvr_resources), "read.gvr.official_page" | t(lang)) }}
  </div>
  {% endif %}
</div>
{% endmacro %}

{#- Hero: the two registrations (the page-language magazine first). The in-page jumps live in the
    page nav below, so the hero has no jump buttons. The kit counts are shown once, in each kit's
    header. "read-hero" (read.css) keeps both buttons on one row on a 390px phone. -#}
{% call ui.pageHero(lang, "nav.gvr" | t(lang), "read.gvr.subtitle" | t(lang), "badge-check", "read.gvr.eyebrow" | t(lang), { class: "read-hero" }) %}
  <div class="hero-actions">
    <a class="btn-light" href="{{ L.rlv_register if lang == 'es' else L.gvr_register }}" target="_blank" rel="noopener">{% icon "user-plus", "size-4" %} {{ ("read.gvr.register_rlv" if lang == "es" else "read.gvr.register_gvr") | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a>
    <a class="btn-on-dark" href="{{ L.gvr_register if lang == 'es' else L.rlv_register }}" target="_blank" rel="noopener">{% icon "user-plus", "size-4" %} {{ ("read.gvr.register_gvr" if lang == "es" else "read.gvr.register_rlv") | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a>
  </div>
{% endcall %}

<div class="container-page page-overlap">{{ ui.pageNav([
  { href: "#job", label: "read.gvr.nav_job" | t(lang), icon: "hand-heart" },
  { href: "#steps", label: "read.gvr.nav_steps" | t(lang), icon: "list-checks" },
  { href: "#kits", label: "read.gvr.see_kits" | t(lang), icon: "folder-open" },
  { href: "#ideas", label: "read.gvr.nav_ideas" | t(lang), icon: "lightbulb" },
  { href: "#next", label: "common.next_steps" | t(lang), icon: "compass" }
], lang) }}</div>

{#- ---------- The job ---------- -#}
<section id="job" class="section container-page pt-10 sm:pt-12" aria-labelledby="job-title">
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.35fr)] lg:gap-10 2xl:gap-14">
    <div>
      {{ ui.sectionHead("read.gvr.job_title" | t(lang), "read.gvr.job_text" | t(lang), "", "", "hand-heart", { eyebrow: "read.gvr.job_eyebrow" | t(lang), tone: "text-vine", id: "job-title", lang: lang }) }}
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        <div class="panel-muted p-4! sm:p-4!">
          <p class="font-display text-lg font-semibold text-gv">GVR</p>
          <p class="mt-1 text-sm text-muted">{{ "read.gvr.gvr_def" | t(lang) }}</p>
        </div>
        <div class="panel-muted p-4! sm:p-4!">
          <p class="font-display text-lg font-semibold text-lv">RLV</p>
          <p class="mt-1 text-sm text-muted">{{ "read.gvr.rlv_def" | t(lang) }}</p>
        </div>
      </div>
      <p class="mt-5 flex items-start gap-2 text-sm leading-relaxed text-muted">{% icon "users-round", "mt-0.5 size-4 shrink-0 text-vine" %}<span><strong class="text-ink">{{ "read.gvr.who_t" | t(lang) }}</strong> {{ "read.gvr.who" | t(lang) }}</span></p>
      {#- GVR / RLV 101 (/orientation/): the lessons for new representatives — the first stop for someone new -#}
      <div class="card card-link group relative mt-6 flex items-start gap-4 p-5">
        <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-grape-soft text-grape">{% icon "graduation-cap", "size-6" %}</span>
        <div class="min-w-0 flex-1">
          <p class="eyebrow text-grape">{{ "orientation.gvr_eyebrow" | t(lang) }}</p>
          <h3 class="h-card mt-1"><a class="no-underline after:absolute after:inset-0 after:rounded-[var(--radius-card)] group-hover:text-gv" href="{{ '/orientation/' | lurl(lang) }}">{{ "orientation.gvr_title" | t(lang) }}</a></h3>
          <p class="mt-1 text-sm leading-relaxed text-muted">{{ "orientation.gvr_text" | t(lang, { min: orientation.totalMinutes }) }}</p>
        </div>
        {% icon "arrow-right", "mt-1 size-5 shrink-0 text-gv transition group-hover:translate-x-0.5" %}
      </div>
    </div>
    <div class="@container">
    <ul class="grid grid-cols-1 gap-4 @md:grid-cols-2 @4xl:grid-cols-3" role="list">
      {% for d in [["library", "bg-gv-soft text-gv"], ["megaphone", "bg-lv-soft text-lv"], ["gift", "bg-vine-soft text-vine"], ["pen-line", "bg-grape-soft text-grape"], ["map", "bg-gv-soft text-gv"], ["languages", "bg-lv-soft text-lv"]] %}
      <li class="card card-pad">
        <span class="grid size-11 place-items-center rounded-xl {{ d[1] }}">{% icon d[0], "size-5" %}</span>
        <h3 class="h-card mt-3">{{ ("read.gvr.d" + loop.index + "_t") | t(lang) }}</h3>
        <p class="mt-1 text-sm leading-relaxed text-muted">{{ ("read.gvr.d" + loop.index) | t(lang) }}</p>
      </li>
      {% endfor %}
    </ul>
    </div>
  </div>
</section>

{#- ---------- First steps checklist (a band) ---------- -#}
{%- set steps = [
  { id: "register", icon: "user-plus" },
  { id: "handbook", icon: "book-marked" },
  { id: "meeting", icon: "video" },
  { id: "table", icon: "library" },
  { id: "announce", icon: "megaphone" },
  { id: "subscribe", icon: "gift" },
  { id: "updates", icon: "rss" },
  { id: "district", icon: "map" }
] -%}
<section id="steps" class="section section-band" aria-labelledby="steps-title">
  <div class="container-page">
    {{ ui.sectionHead("read.gvr.steps_title" | t(lang), "read.gvr.steps_sub" | t(lang), "", "", "list-checks", { eyebrow: "read.gvr.steps_eyebrow" | t(lang), tone: "text-vine", id: "steps-title", lang: lang }) }}
    <div class="layout-aside">
      <div class="card @container overflow-hidden" x-data="gvrChecklist('gvr-checklist-v1', {{ steps.length }})">
        <div class="flex flex-wrap items-center gap-x-4 gap-y-2 border-b border-line px-5 py-4 sm:px-6">
          <div class="read-progress min-w-[8rem] flex-1" role="progressbar" aria-valuemin="0" aria-valuemax="{{ steps.length }}" aria-valuenow="0" :aria-valuenow="count()" aria-label="{{ 'read.gvr.progress_label' | t(lang) }}"><span style="width:0%" :style="'width:' + pct() + '%'"></span></div>
          <p class="read-num shrink-0 text-sm font-semibold text-ink" aria-live="polite" data-t="{{ 'read.gvr.progress' | t(lang) }}" x-text="$el.dataset.t.replace('{n}', count()).replace('{total}', total)">{{ "read.gvr.progress" | t(lang, {n: 0, total: steps.length}) }}</p>
          <button type="button" class="btn-ghost btn-sm -my-1 text-muted" x-show="count() > 0" x-cloak @click="reset()">{% icon "rotate-ccw", "size-4" %} {{ "read.gvr.reset" | t(lang) }}</button>
          <p class="basis-full text-sm font-semibold text-vine" x-show="count() === total" x-cloak>{% icon "party-popper", "size-4 inline -mt-0.5" %} {{ "read.gvr.all_done" | t(lang) }}</p>
        </div>
        {#- Two columns when the card is wide (read.css .read-check-list): steps read DOWN each
            column (1–4, then 5–8), the same order as the list itself. The checkbox and the step's
            title are one label (a 44px target); the description and links sit under the title. -#}
        {%- set half = ((steps.length + 1) / 2) | round(0, "floor") -%}
        <ol class="read-check-list" style="--rows: {{ half }}">
          {% for s in steps %}
          <li class="read-check-row flex items-start gap-3 px-5 py-3 transition sm:px-6{{ " read-check-c1" if loop.index <= half }}{{ " read-check-c2top" if loop.index == half + 1 }}" :class="{ 'is-done': isDone('{{ s.id }}') }">
            <div class="min-w-0 flex-1">
              <label class="read-check-label flex min-h-11 cursor-pointer items-center gap-3 font-semibold text-ink">
                <input type="checkbox" class="read-check" :checked="isDone('{{ s.id }}')" @change="toggle('{{ s.id }}')">
                <span>{{ ("read.gvr.s_" + s.id + "_t") | t(lang) }}</span>
              </label>
              <div class="read-check-body">
                <p class="text-sm leading-relaxed text-muted">{{ ("read.gvr.s_" + s.id) | t(lang) }}</p>
                <p class="mt-1 flex flex-wrap gap-x-4 text-sm">
                  {% if s.id == "register" %}
                    {% for k in (["rlv", "gvr"] if lang == "es" else ["gvr", "rlv"]) %}
                    <a class="link tap-link" href="{{ L.rlv_register if k == 'rlv' else L.gvr_register }}" target="_blank" rel="noopener">{{ ("read.gvr.register_" + k) | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a>
                    {% endfor %}
                  {% elif s.id == "handbook" %}
                    {% for h in handbooks %}<a class="link tap-link" href="{{ h.url }}" target="_blank" rel="noopener" lang="{{ h.lang }}">{{ h | readPdfTitle(lang) }} ({{ "kind.pdf" | t(lang) | lower }})</a>{% else %}<a class="link tap-link" href="#kits">{{ "read.gvr.see_kits" | t(lang) }}</a>{% endfor %}
                  {% elif s.id == "meeting" %}
                    <a class="link tap-link" href="{{ '/meetings/' | lurl(lang) }}#committee-meeting">{% if meeting.next %}{{ "read.gvr.next_meeting" | t(lang, {date: meeting.next.start | fmtDate(lang, "medium")}) }}{% else %}{{ "nav.meeting" | t(lang) }}{% endif %}</a>
                  {% elif s.id == "table" %}
                    <a class="link tap-link" href="{{ '/shop/' | lurl(lang) }}#cat-title">{{ "read.subs.cat_title" | t(lang) }}</a>
                    <a class="link tap-link" href="#kit-{{ 'rlv' if lang == 'es' else 'gvr' }}">{{ "read.gvr.g_flyers" | t(lang) }}</a>
                  {% elif s.id == "announce" %}
                    <a class="link tap-link" href="{{ '/read/' | lurl(lang) }}">{{ "read.gvr.current_issues" | t(lang) }}</a>
                    <a class="link tap-link" href="{{ '/contribute/' | lurl(lang) }}#deadlines">{{ "read.contrib.deadlines_title" | t(lang) }}</a>
                    <a class="link tap-link" href="{{ '/monthly/' | lurl(lang) }}">{{ "nav.monthly" | t(lang) }}</a>
                  {% elif s.id == "subscribe" %}
                    <a class="link tap-link" href="{{ '/shop/' | lurl(lang) }}#carry">{{ "read.subs.ctm_eyebrow" | t(lang) }}</a>
                  {% elif s.id == "updates" %}
                    <a class="link tap-link" href="{{ '/digest/' | lurl(lang) }}">{{ "nav.digest" | t(lang) }}</a>
                    <a class="link tap-link" href="{{ '/feed.xml' | lurl(lang) }}">{{ "feeds.rss" | t(lang) }}</a>
                  {% elif s.id == "district" %}
                    <a class="link tap-link" href="{{ '/monthly/' | lurl(lang) }}#report">{{ "community.report.hero_btn" | t(lang) }}</a>
                    <a class="link tap-link" href="{{ '/share/' | lurl(lang) }}">{{ "nav.share" | t(lang) }}</a>
                  {% endif %}
                </p>
              </div>
            </div>
            <span class="mt-3 hidden text-muted sm:block" aria-hidden="true">{% icon s.icon, "size-5" %}</span>
          </li>
          {% endfor %}
        </ol>
        <p class="border-t border-line bg-surface-2 px-5 py-3 text-xs text-muted sm:px-6">{% icon "lock", "size-3 inline -mt-0.5" %} {{ "read.gvr.saved_note" | t(lang) }}</p>
      </div>

      {#- A short companion for the checklist: sticks beside it from 1024px (sticky-aside). -#}
      <aside class="sticky-aside space-y-5" aria-label="{{ 'read.gvr.help_title' | t(lang) }}">
        <div class="card card-pad">
          <h3 class="card-h"><span>{% icon "video", "size-5" %}</span>{{ "read.gvr.help_title" | t(lang) }}</h3>
          <p class="mt-2 text-sm leading-relaxed text-muted">{{ "read.gvr.help_text" | t(lang) }}</p>
          {% if meeting.next %}
          <p class="mt-4 rounded-xl bg-surface-2 p-3 text-sm">
            <span class="eyebrow block">{{ "read.gvr.next_label" | t(lang) }}</span>
            <time class="mt-0.5 block font-semibold text-ink" datetime="{{ meeting.next.start }}">{{ meeting.next.start | fmtDate(lang, "long") }}</time>
            <span class="text-muted">{{ meeting.next.start | fmtDate(lang, "time") }} · {{ site.meeting.platform }}</span>
          </p>
          {% endif %}
          <a class="btn-primary mt-4" href="{{ '/meetings/' | lurl(lang) }}">{{ "read.gvr.help_btn" | t(lang) }} {% icon "arrow-right", "size-4" %}</a>
        </div>
        <div class="card card-pad">
          <h3 class="card-h"><span>{% icon "mail", "size-5" %}</span>{{ "read.gvr.contact_title" | t(lang) }}</h3>
          <p class="mt-2 text-sm text-muted">{{ "read.gvr.contact_text" | t(lang) }}</p>
          <a class="link tap-link mt-1 break-all" href="mailto:{{ site.meeting.chair_email or site.contact_email }}">{{ site.meeting.chair_email or site.contact_email }}</a>
        </div>
      </aside>
    </div>
  </div>
</section>

{#- ---------- Official kits ---------- -#}
<section class="section container-page" id="kits" aria-labelledby="kits-title" x-data="kitFilter('all')">
  {% call ui.sectionHead("read.gvr.kits_title" | t(lang), "read.gvr.kits_sub" | t(lang), "", "", "folder-open", { eyebrow: "read.gvr.kits_eyebrow" | t(lang), id: "kits-title", lang: lang }) %}{{ ui.freshness(db.pdfs.updated, lang) }}{% endcall %}

  {% if gvrKit.length or rlvKit.length %}
  <div class="mb-8 flex flex-col gap-3 rounded-[var(--radius-card)] border border-line bg-surface p-3 sm:flex-row sm:items-center" data-js-only>
    <div class="chip-row" role="group" aria-label="{{ 'read.gvr.kit_filter' | t(lang) }}">
      <button type="button" class="chip" aria-pressed="true" :aria-pressed="(kit === 'all').toString()" @click="kit = 'all'">{{ "common.all" | t(lang) }}</button>
      {% for k in kitOrder %}
      <button type="button" class="chip {{ 'read-chip-rlv' if k == 'rlv' else '' }}" aria-pressed="false" :aria-pressed="(kit === '{{ k }}').toString()" @click="kit = '{{ k }}'">{{ ("read.gvr.kit_rlv" if k == "rlv" else "read.gvr.kit_gvr") | t(lang) }}</button>
      {% endfor %}
    </div>
    <label class="relative flex-1 sm:ml-auto sm:max-w-sm">
      <span class="sr-only">{{ "read.gvr.search_label" | t(lang) }}</span>
      <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-muted">{% icon "search", "size-4" %}</span>
      <input type="search" class="input pl-10" x-model.debounce.150ms="q" placeholder="{{ 'read.gvr.search_ph' | t(lang) }}" autocomplete="off">
    </label>
    <p class="read-num shrink-0 px-2 text-sm text-muted" aria-live="polite" x-show="q || kit !== 'all'" x-cloak data-t1="{{ 'read.gvr.shown_one' | t(lang) }}" data-t="{{ 'read.gvr.shown' | t(lang) }}" x-text="shown === 1 ? $el.dataset.t1 : $el.dataset.t.replace('{n}', shown)"></p>
  </div>

  <div class="space-y-12">
    {% for k in kitOrder %}{{ kitBlock(k, (rlvKit if k == "rlv" else gvrKit), lang) }}{% endfor %}
  </div>
  <div class="mt-6" x-show="shown === 0" x-cloak>
    {{ ui.emptyState("search-x", "read.gvr.no_match" | t(lang), "read.gvr.no_match_text" | t(lang)) }}
  </div>
  {% else %}
    {{ ui.emptyState("folder-open", "read.gvr.kits_empty" | t(lang), "read.gvr.kits_empty_text" | t(lang), L.gvr_resources, "read.gvr.kit_gvr" | t(lang)) }}
    <p class="mt-3 text-center text-sm"><a class="link tap-link" href="{{ L.rlv_resources }}" target="_blank" rel="noopener">{{ "read.gvr.kit_rlv" | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a></p>
  {% endif %}
</section>

{#- ---------- Ideas for the home group ---------- -#}
<section id="ideas" class="section container-page pt-0" aria-labelledby="ideas-title">
  {{ ui.sectionHead("read.gvr.ideas_title" | t(lang), "read.gvr.ideas_sub" | t(lang), "", "", "lightbulb", { eyebrow: "read.gvr.ideas_eyebrow" | t(lang), tone: "text-lv", id: "ideas-title", lang: lang }) }}
  <ul class="grid-cards-fit [--cards-min:15rem] [--cards-max:3] min-[1800px]:[--cards-max:6]" role="list">
    {#- [icon, colors, page, anchor on that page]: each idea opens the section it talks about -#}
    {% for i in [["library", "bg-gv-soft text-gv", "/shop/", "#cat-title"], ["clipboard-list", "bg-lv-soft text-lv", "/shop/", "#forms-title"], ["gift", "bg-vine-soft text-vine", "/shop/", "#carry"], ["pen-line", "bg-grape-soft text-grape", "/contribute/", "#workshop"], ["headphones", "bg-grape-soft text-grape", "/listen/", ""], ["list-checks", "bg-gv-soft text-gv", "/monthly/", "#ways"]] %}
    <li class="card card-link card-pad group relative flex flex-col">
      <span class="grid size-11 place-items-center rounded-xl {{ i[1] }}">{% icon i[0], "size-5" %}</span>
      <h3 class="h-card mt-3"><a class="no-underline after:absolute after:inset-0 after:rounded-[var(--radius-card)] hover:text-gv" href="{{ i[2] | lurl(lang) }}{{ i[3] }}">{{ ("read.gvr.i" + loop.index + "_t") | t(lang) }}</a></h3>
      <p class="mt-1 text-sm leading-relaxed text-muted">{{ ("read.gvr.i" + loop.index) | t(lang) }}</p>
      <span class="mt-auto inline-flex items-center gap-1.5 pt-3 text-sm font-semibold text-gv" aria-hidden="true">{{ ("read.gvr.i" + loop.index + "_cta") | t(lang) }} {% icon "arrow-right", "size-4 transition group-hover:translate-x-0.5" %}</span>
    </li>
    {% endfor %}
  </ul>
</section>

{#- ---------- Next steps (closing block): only pages the checklist and ideas do not link ---------- -#}
<section id="next" class="section container-page pt-0" aria-labelledby="next-title">
  {{ ui.sectionHead("read.gvr.connect_title" | t(lang), "read.gvr.connect_sub" | t(lang), "", "", "compass", { eyebrow: "common.next_steps" | t(lang), id: "next-title", lang: lang }) }}
  {{ ui.nextSteps([
    { href: "/events/" | lurl(lang), title: "nav.events" | t(lang), text: "nav.events_desc" | t(lang), cta: "read.gvr.ns_events_cta" | t(lang), icon: "calendar-days", tone: "vine" },
    { href: "/whats-new/" | lurl(lang), title: "nav.whats_new" | t(lang), text: "read.gvr.c_new" | t(lang), cta: "read.gvr.ns_new_cta" | t(lang), icon: "sparkles", tone: "grape" },
    { href: "/library/" | lurl(lang), title: "nav.library" | t(lang), text: "read.gvr.ns_library" | t(lang), cta: "read.gvr.ns_library_cta" | t(lang), icon: "library", tone: "gv" },
    { href: "/published/" | lurl(lang), title: "nav.published" | t(lang), text: "nav.published_desc" | t(lang), cta: "read.gvr.ns_published_cta" | t(lang), icon: "award", tone: "lv" }
  ], lang) }}
</section>
