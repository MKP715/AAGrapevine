---
pagination: { data: languages, size: 1, alias: lang }
permalink: "{{ '/' if lang == 'en' else '/es/' }}monthly/index.html"
layout: layouts/base.njk
pageKey: monthly
titleKey: monthly.title
descKey: monthly.meta_desc
bodyClass: mp-hub
pageScripts: ["/assets/js/monthly.js"]
---
{#- /monthly/ — "Carry the message this month". The canonical home of the district guide
    "how each month's magazine can be useful in carrying the message" (config/carry.yml: intro,
    the 10 ways, story note, quote, source). This month is featured, next month is teased, and
    all 13 month posters (this month + 12) link to their own page (monthly-month.njk), where the
    full toolkit, the poster downloads and the print layout live. Prices stay in the shop. -#}
{% import "macros/ui.njk" as ui with context %}
{% import "macros/monthly.njk" as mp with context %}
{%- set months = db | mpMonths(carry, site, lang) -%}
{%- set m = months[0] -%}
{%- set nx = months[1] -%}

{% call ui.pageHero(lang, "monthly.title" | t(lang), "monthly.hero_sub" | t(lang), "calendar-heart", "monthly.eyebrow" | t(lang)) %}
<div class="hero-actions">
  <a class="btn-light" href="{{ ('/monthly/' + m.key + '/') | lurl(lang) }}">{% icon "image", "size-4" %} {{ "monthly.see_poster" | t(lang) }}</a>
  <a class="btn-on-dark" href="#ways">{% icon "list-checks", "size-4" %} {{ "monthly.ways_link" | t(lang) }}</a>
</div>
{% endcall %}

{#- ============ This month ============ -#}
<section class="container-page page-overlap pb-12 sm:pb-16" aria-labelledby="mp-now-title">
  <div class="card overflow-hidden">
    <div class="mp-now">
      <div class="p-6 sm:p-8">
        <p class="eyebrow text-gv">{{ "monthly.this_month" | t(lang) }}</p>
        <h2 id="mp-now-title" class="h-section mt-1">{{ m.title }}</h2>

        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          {% set gvBox %}
          <div class="rounded-xl bg-gv-soft p-4">
            <p class="text-xs font-semibold uppercase tracking-wider text-gv">{{ "monthly.in_gv" | t(lang) }}</p>
            <p class="mt-1 font-display text-xl font-semibold text-ink">{{ m.gv.theme if m.gv else ("monthly.no_issue" | t(lang)) }}</p>
          </div>
          {% endset %}
          {% set lvBox %}
          {% if m.lv %}
          <div class="rounded-xl bg-lv-soft p-4">
            <p class="text-xs font-semibold uppercase tracking-wider text-lv-strong">{{ "monthly.in_lv" | t(lang) }} · {{ m.lv.label }}</p>
            <p class="mt-1 font-display text-xl font-semibold text-ink" lang="{{ lang }}">{{ m.lv.theme }}</p>
          </div>
          {% endif %}
          {% endset %}
          {% if lang == "es" %}{{ lvBox | safe }}{{ gvBox | safe }}{% else %}{{ gvBox | safe }}{{ lvBox | safe }}{% endif %}
        </div>

        {% if m.tips.length %}
        <h3 class="mt-7 text-sm font-semibold uppercase tracking-wider text-muted">{{ "monthly.put_to_work" | t(lang) }}</h3>
        <ul class="mp-tiplist mt-3" role="list">
          {% for tp in m.tips %}
          <li><span class="mp-tipicon">{% icon tp.icon, "size-5" %}</span><span><strong class="block text-ink">{{ tp.title }}</strong><span class="text-sm text-muted">{{ tp.text }}</span></span></li>
          {% endfor %}
        </ul>
        {% endif %}

        <div class="mt-7 grid gap-4 lg:grid-cols-2">
          <div>
            <h3 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-muted">{% icon "pen-line", "size-4" %} {{ "monthly.stories_wanted" | t(lang) }}</h3>
            {% if m.deadlines.length %}
            <ul class="mt-3 space-y-2" role="list">
              {% for d in m.deadlines %}
              <li class="rounded-xl border border-line p-3"><strong class="text-ink">{{ d.theme }}</strong><span class="block text-sm text-muted">{{ "monthly.for_issue" | t(lang, { issue: d.issueLabel }) }} — {{ "monthly.due" | t(lang, { date: d.dueLong }) }}</span></li>
              {% endfor %}
            </ul>
            {% else %}
            <p class="mt-2 text-sm text-muted">{{ "monthly.no_deadlines" | t(lang) }}</p>
            {% endif %}
            {% if m.lvTopics.length %}
            <p class="mt-3 text-sm text-muted">{{ "monthly.lv_topics" | t(lang) }}: <span lang="es">{% for tp in m.lvTopics %}{{ tp.es }}{{ " · " if not loop.last }}{% endfor %}</span></p>
            {% endif %}
            <a class="link mt-2 inline-flex items-center gap-1 text-sm font-semibold" href="{{ '/contribute/' | lurl(lang) }}">{{ "nav.contribute" | t(lang) }} {% icon "arrow-right", "size-4" %}</a>
          </div>
          {% if m.botm.length %}
          <div>
            <h3 class="flex items-center gap-2 text-sm font-semibold uppercase tracking-wider text-muted">{% icon "book-heart", "size-4" %} {{ "monthly.botm" | t(lang) }}</h3>
            <ul class="mt-3 space-y-2" role="list">
              {% for b in m.botm %}
              <li class="rounded-xl border border-line p-3"><strong class="text-ink" lang="{{ b.lang }}">{{ b.title }}</strong><span class="block text-sm text-muted">{{ ("monthly.botm_off" | t(lang, { pct: b.discount, date: b.endsLabel })) if b.discount else ("monthly.botm_until" | t(lang, { date: b.endsLabel })) }}</span></li>
              {% endfor %}
            </ul>
            <a class="link mt-2 inline-flex items-center gap-1 text-sm font-semibold" href="{{ '/shop/' | lurl(lang) }}#botm">{{ "monthly.botm_more" | t(lang) }} {% icon "arrow-right", "size-4" %}</a>
          </div>
          {% endif %}
        </div>
      </div>
      <a class="mp-now-poster group" href="{{ ('/monthly/' + m.key + '/') | lurl(lang) }}">
        <span class="mp-stage mp-stage--thumb" aria-hidden="true" inert><span class="mp-fit">{{ mp.poster(m, lang, site, "now") }}</span></span>
        <span class="mt-3 inline-flex items-center gap-1.5 font-semibold text-gv group-hover:underline">{{ "monthly.open_month" | t(lang, { month: m.label }) }} {% icon "arrow-right", "size-4" %}</span>
      </a>
    </div>
  </div>
</section>

{#- ============ Next month (teaser) ============ -#}
{% if nx %}
<section class="container-page pb-12 sm:pb-16" aria-labelledby="mp-next-title">
  <a class="card card-link mp-next no-underline" href="{{ ('/monthly/' + nx.key + '/') | lurl(lang) }}">
    <span class="min-w-0">
      <span class="eyebrow text-grape">{{ "monthly.coming_next" | t(lang) }}</span>
      <span id="mp-next-title" class="mt-1 block font-display text-2xl font-semibold text-ink">{{ nx.title }}</span>
      <span class="mt-2 block text-muted">
        {%- if nx.gv %}{{ "monthly.in_gv" | t(lang) }}: <strong class="text-ink">{{ nx.gv.theme }}</strong>{% endif -%}
      </span>
      <span class="mt-3 flex flex-wrap gap-2">
        {% for d in nx.deadlines %}<span class="badge-gv">{% icon "pen-line", "size-3" %} {{ d.theme }} · {{ d.dueLabel }}</span>{% endfor %}
        {% if nx.committee %}<span class="badge-muted">{% icon "video", "size-3" %} {{ "monthly.committee" | t(lang) }} · {{ nx.committee.chip.mon }} {{ nx.committee.chip.day }}</span>{% endif %}
        {% for r in nx.recurring %}<span class="badge-muted">{% icon "repeat", "size-3" %} {{ r.title }} · {{ r.chip.mon }} {{ r.chip.day }}</span>{% endfor %}
      </span>
    </span>
    <span class="mp-next-go" aria-hidden="true">{% icon "arrow-right", "size-5" %}</span>
  </a>
</section>
{% endif %}

{#- ============ All posters ============ -#}
<section class="bg-surface-2/60 py-12 sm:py-16" aria-labelledby="mp-all-title">
  <div class="container-page">
    {{ ui.sectionHead("monthly.all_posters" | t(lang), "monthly.all_posters_sub" | t(lang), "", "", "image") }}
    <ul class="mp-grid" role="list">
      {% for pm in months %}
      <li>
        <a class="mp-thumb group" href="{{ ('/monthly/' + pm.key + '/') | lurl(lang) }}">
          <span class="mp-stage mp-stage--thumb" aria-hidden="true" inert><span class="mp-fit">{{ mp.poster(pm, lang, site, "g") }}</span></span>
          <span class="mp-thumb-label">
            <span class="font-semibold text-ink group-hover:text-gv group-hover:underline">{{ pm.title }}</span>
            {% if pm.isCurrent %}<span class="badge-new">{{ "monthly.current" | t(lang) }}</span>{% endif %}
          </span>
          {% if pm.gv %}<span class="block text-sm text-muted">{{ pm.gv.theme }}</span>{% endif %}
        </a>
      </li>
      {% endfor %}
    </ul>
  </div>
</section>

{#- ============ The 10 ways (canonical home of the guide) ============ -#}
{% if carry.ways.length %}
<section id="ways" class="container-page section scroll-mt-20" aria-labelledby="ways-title">
  <div class="max-w-3xl">
    <p class="eyebrow text-gv">{{ "monthly.put_to_work" | t(lang) }}</p>
    <h2 id="ways-title" class="h-section mt-1">{{ "monthly.ways_title" | t(lang) }}</h2>
    {% if carry.intro %}<p class="lead mt-3">{{ carry.intro[lang] }}</p>{% endif %}
  </div>
  <ol class="mp-ways mt-8" role="list">
    {% for w in carry.ways %}
    <li class="card card-pad">
      <span class="mp-way-n" aria-hidden="true">{{ loop.index }}</span>
      <span class="mp-tipicon">{% icon w.icon, "size-5" %}</span>
      <h3 class="h-card mt-3 text-lg"><span class="sr-only">{{ loop.index }}. </span>{{ w.title[lang] }}</h3>
      <p class="mt-1.5 text-sm text-muted">{{ w.text[lang] }}</p>
    </li>
    {% endfor %}
  </ol>
  <div class="mt-8 grid gap-5 lg:grid-cols-2">
    {% if carry.story_note %}
    <div class="card card-pad flex gap-4">
      <span class="mp-tipicon">{% icon "pen-line", "size-5" %}</span>
      <p class="text-ink">{{ carry.story_note[lang] }} <a class="link font-semibold" href="{{ '/contribute/' | lurl(lang) }}">{{ "nav.contribute" | t(lang) }}</a></p>
    </div>
    {% endif %}
    {% if carry.quote %}
    <figure class="card card-pad mp-quote">
      {% icon "quote", "size-6 text-grape" %}
      <blockquote class="mt-2 font-display text-xl text-ink">{{ carry.quote[lang] }}</blockquote>
      {% if carry.quote.cite %}<figcaption class="mt-2 text-sm text-muted">— {{ carry.quote.cite[lang] }}</figcaption>{% endif %}
    </figure>
    {% endif %}
  </div>
  {% if carry.source %}<p class="mt-6 max-w-3xl text-xs text-muted"><strong>{{ "monthly.source" | t(lang) }}:</strong> {{ carry.source[lang] }}</p>{% endif %}
</section>
{% endif %}
