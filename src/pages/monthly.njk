---
pagination: { data: languages, size: 1, alias: lang }
permalink: "{{ '/' if lang == 'en' else '/es/' }}monthly/index.html"
layout: layouts/base.njk
pageKey: monthly
titleKey: monthly.title
descKey: monthly.meta_desc
bodyClass: mp-hub
pageScripts: ["/assets/js/monthly.js", "/assets/js/community.js"]
---
{#- /monthly/ — "Monthly toolkit & posters". The canonical home of the district guide
    "how each month's magazine can be useful in carrying the message" (config/carry.yml: intro,
    the 10 ways, story note, quote, source). This month and next month are short teasers, and the
    coming months' posters link to their own page (monthly-month.njk), where the full toolkit, the
    poster downloads and the print layout live. Prices stay in the shop.
    #report is the one home of the self-filling GV/LV report a GVR / RLV reads at the district
    meeting (eleventy/filters/community.js reportData / reportText; the old /districts/ page
    redirects here), with the tips and the Area's published writers beside it. -#}
{% import "macros/ui.njk" as ui with context %}
{% import "macros/monthly.njk" as mp with context %}
{%- set months = db | mpMonths(carry, site, lang) -%}
{%- set m = months[0] -%}
{%- set nx = months[1] -%}
{%- set other = lang | otherLang -%}
{%- set rd = db | cmReport(meeting) -%}
{%- set W = rd.writers -%}

{% call ui.pageHero(lang, "monthly.title" | t(lang), "monthly.hero_sub" | t(lang), "calendar-heart", "monthly.eyebrow" | t(lang)) %}
<div class="hero-actions">
  <a class="btn-light" href="{{ ('/monthly/' + m.key + '/') | lurl(lang) }}">{% icon "image", "size-4" %} {{ "monthly.see_poster" | t(lang) }}</a>
  <a class="btn-on-dark" href="#report">{% icon "clipboard-list", "size-4" %} {{ "community.report.hero_btn" | t(lang) }}</a>
  <a class="btn-on-dark max-md:hidden" href="#ways">{% icon "list-checks", "size-4" %} {{ "monthly.ways_link" | t(lang) }}</a>
</div>
{% endcall %}

{#- ============ This month (a teaser: the full toolkit lives on the month's own page) ============ -#}
<section class="container-page page-overlap pb-12 sm:pb-16" aria-labelledby="mp-now-title">
  <div class="card overflow-hidden">
    <div class="mp-now">
      <div class="p-6 sm:p-8">
        <p class="eyebrow text-gv">{{ "monthly.this_month" | t(lang) }}</p>
        <h2 id="mp-now-title" class="h-section mt-1">{{ m.title }}</h2>

        <div class="mt-5 grid gap-4 sm:grid-cols-2">
          {% set gvBox %}
          <div class="rounded-xl bg-gv-soft p-4">
            <p class="text-xs font-semibold uppercase tracking-wider text-gv">{{ "monthly.in_gv" | t(lang, { month: m.monthName }) }}</p>
            <p class="mt-1 font-display text-xl font-semibold text-ink">{{ m.gv.theme if m.gv else ("monthly.no_issue" | t(lang)) }}</p>
          </div>
          {% endset %}
          {% set lvBox %}
          {% if m.lv %}
          <div class="rounded-xl bg-lv-soft p-4">
            <p class="text-xs font-semibold uppercase tracking-wider text-lv-strong">{{ "monthly.in_lv" | t(lang) }} · {{ m.lv.label }}</p>
            <p class="mt-1 font-display text-xl font-semibold text-ink">{{ m.lv.theme }}</p>
          </div>
          {% endif %}
          {% endset %}
          {% if lang == "es" %}{{ lvBox | safe }}{{ gvBox | safe }}{% else %}{{ gvBox | safe }}{{ lvBox | safe }}{% endif %}
        </div>

        {#- the next story deadline and this month's committee / booth dates, as chips -#}
        <ul class="mt-5 flex flex-wrap gap-2" role="list" aria-label="{{ 'monthly.dates' | t(lang) }}">
          {% if m.deadlines.length %}<li class="badge-gv">{% icon "pen-line", "size-3" %} {{ m.deadlines[0].theme }} · {{ m.deadlines[0].dueLabel }}</li>{% endif %}
          {% for d in m.dates %}{% if d.kind != "event" %}{% set dIcon = "video" if d.kind == "committee" else "repeat" %}<li class="badge-muted">{% icon dIcon, "size-3" %} {{ ("monthly.committee" | t(lang)) if d.kind == "committee" else d.title }} · {{ d.dayLabel }}</li>{% endif %}{% endfor %}
        </ul>

        <a class="btn-primary mt-6" href="{{ ('/monthly/' + m.key + '/') | lurl(lang) }}">{% icon "calendar-heart", "size-4" %} {{ "monthly.open_toolkit" | t(lang, { month: m.monthName }) }}</a>
      </div>
      <a class="mp-now-poster group" href="{{ ('/monthly/' + m.key + '/') | lurl(lang) }}">
        <span class="mp-stage mp-stage--thumb" aria-hidden="true" inert><span class="mp-fit">{{ mp.poster(m, lang, site, "now") }}</span></span>
        <span class="mt-3 inline-flex min-h-11 items-center gap-1.5 font-semibold text-gv group-hover:underline">{{ "monthly.open_month" | t(lang, { month: m.label }) }} {% icon "arrow-right", "size-4" %}</span>
      </a>
    </div>
  </div>
</section>

{#- ============ Next month (teaser) ============ -#}
{% if nx %}
<section class="container-page pb-12 sm:pb-16" aria-labelledby="mp-next-title">
  <a class="card card-link mp-next no-underline" href="{{ ('/monthly/' + nx.key + '/') | lurl(lang) }}">
    <span class="min-w-0">
      <span class="eyebrow text-grape">{{ "monthly.coming_next" | t(lang) }}</span>
      <span id="mp-next-title" class="mt-1 block font-display text-2xl font-semibold text-ink">{{ nx.title }}</span>
      <span class="mt-2 block text-muted">
        {%- if nx.gv %}{{ "monthly.in_gv" | t(lang, { month: nx.monthName }) }}: <strong class="text-ink">{{ nx.gv.theme }}</strong>{% endif -%}
      </span>
      <span class="mt-3 flex flex-wrap gap-2">
        {% for d in nx.deadlines %}<span class="badge-gv">{% icon "pen-line", "size-3" %} {{ d.theme }} · {{ d.dueLabel }}</span>{% endfor %}
        {#- nx.dates is in date order; "Oct 21" / "21 de octubre" -#}
        {% for d in nx.dates %}{% if d.kind != "event" %}{% set dIcon = "video" if d.kind == "committee" else "repeat" %}<span class="badge-muted">{% icon dIcon, "size-3" %} {{ ("monthly.committee" | t(lang)) if d.kind == "committee" else d.title }} · {{ d.dayLabel }}</span>{% endif %}{% endfor %}
      </span>
    </span>
    <span class="mp-next-go" aria-hidden="true">{% icon "arrow-right", "size-5" %}</span>
  </a>
</section>
{% endif %}

{#- ============ Your GV/LV report (the one home of the district report) ============ -#}
{#- Report + a sidebar (tips, published writers): 20rem from 1024px, 22rem from 1536px; from
    1800px the sidebar's two cards sit side by side so the report keeps a comfortable width
    (areas/community.css .cm-rp-layout). -#}
<section id="report" class="container-page scroll-mt-20 pb-12 sm:pb-16" aria-labelledby="report-title" x-data="reportBox('{{ lang }}')">
  <div class="cm-rp-layout">
    <div class="min-w-0">
      <p class="eyebrow text-gv">{{ "community.report.eyebrow" | t(lang) }}</p>
      <h2 id="report-title" class="h-section mt-1 flex items-center gap-2.5"><span class="text-gv">{% icon "clipboard-list", "size-6" %}</span>{{ "community.report.title" | t(lang) }}</h2>
      <p class="mt-1.5 max-w-2xl text-muted">{{ "community.report.sub" | t(lang) }}</p>

      <div class="card mt-6 overflow-hidden">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line bg-surface-2/60 px-4 py-3 sm:px-5">
          <fieldset class="min-w-0" x-cloak>
            <legend class="sr-only">{{ "community.report.lang" | t(lang) }}</legend>
            <div class="grid grid-cols-2 gap-1 rounded-full border border-line bg-surface p-1">
              <label class="cm-seg"><input type="radio" name="report-lang" class="sr-only" :checked="rl === 'en'" @change="rl = 'en'" {% if lang == 'en' %}checked{% endif %}><span lang="en">{{ "community.lang_name_en" | t(lang) }}</span></label>
              <label class="cm-seg"><input type="radio" name="report-lang" class="sr-only" :checked="rl === 'es'" @change="rl = 'es'" {% if lang == 'es' %}checked{% endif %}><span lang="es">{{ "community.lang_name_es" | t(lang) }}</span></label>
            </div>
          </fieldset>
          <button type="button" class="btn-primary btn-sm" data-copy-from="#report-{{ lang }}" :data-copy-from="'#report-' + rl">{% icon "copy", "size-4" %} {{ "community.report.copy" | t(lang) }}</button>
        </div>
        {% for l in [lang, other] %}
        <pre id="report-{{ l }}" class="cm-report m-0 px-4 py-4 font-sans sm:px-6 sm:py-5" x-show="rl === '{{ l }}'"{% if l != lang %} x-cloak{% endif %} role="region" aria-label="{{ 'community.report.label' | t(lang) }} ({{ ('community.lang_name_' + l) | t(lang) }})"><span lang="{{ l }}">{{ rd | cmReportText(l, site) }}</span></pre>
        {% endfor %}
        <p class="flex items-center gap-2 border-t border-line px-4 py-3 text-xs text-muted sm:px-6">{% icon "info", "size-4 shrink-0" %} {{ "community.report.note" | t(lang) }}</p>
      </div>
    </div>

    <div class="cm-rp-side lg:pt-[8.5rem]">
    <aside class="rounded-2xl border border-line p-5" aria-labelledby="tips-title">
      <h3 id="tips-title" class="h-card flex items-center gap-2">{% icon "lightbulb", "size-5 text-lv" %} {{ "community.report.tips_title" | t(lang) }}</h3>
      <ul class="mt-3 space-y-3 text-sm leading-relaxed text-muted" role="list">
        {% for k in ["tip1", "tip2", "tip3", "tip4", "tip5"] %}
        <li class="flex gap-2.5">{% icon "check", "size-4 mt-0.5 shrink-0 text-vine" %}<span>{{ ("community.report." + k) | t(lang) }}</span></li>
        {% endfor %}
      </ul>
      <div class="mt-5 flex flex-wrap gap-2 border-t border-line pt-4">
        <a class="btn-secondary btn-sm" href="{{ site.links.carry_the_message }}" target="_blank" rel="noopener">{% icon "gift", "size-4" %} {{ "community.report.ctm" | t(lang) }}<span class="sr-only"> {{ "community.new_tab" | t(lang) }}</span></a>
        <a class="btn-secondary btn-sm" href="{{ '/gvr/' | lurl(lang) }}">{% icon "badge-check", "size-4" %} {{ "nav.gvr" | t(lang) }}</a>
      </div>
    </aside>

    {#- Published writers from our Area — the same list as the report's item, with links -#}
    {% if W %}
    <div class="card card-pad">
      <h3 id="writers-title" class="h-card flex items-center gap-2">{% icon "award", "size-5 text-lv" %} {{ "community.writers.card_title" | t(lang) }}</h3>
      <p class="mt-1 text-sm leading-relaxed text-muted">{{ "community.writers.card_sub" | t(lang, { n: W.days }) }}</p>
      <h4 class="eyebrow mt-4 flex items-center gap-1.5">{% icon "map-pin", "size-3.5" %} {{ "community.writers.group_neta65" | t(lang) }}</h4>
      {% if W.neta65 | length %}
      <ul class="mt-2 space-y-3" role="list">
        {% for it in W.neta65 | limit(6) %}
        {%- set isLv = it.source == "lavina" or it.extra.publication == "lv" -%}
        {%- set place = it | cmWriterPlace(lang) -%}
        <li class="text-sm">
          <a class="font-semibold leading-snug text-ink no-underline hover:text-gv hover:underline" href="{{ it.url }}" target="_blank" rel="noopener">{{ it | tx("title", lang) }}<span class="sr-only"> {{ "community.new_tab" | t(lang) }}</span></a>
          <p class="text-ink">{{ it | cmWriterName(lang) }}{% if place %}<span class="text-muted"> · {{ place }}</span>{% endif %}</p>
          <p class="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-muted"><span class="{{ 'badge-lv' if isLv else 'badge-gv' }}">{{ "La Viña" if isLv else "Grapevine" }}</span>{% if it.extra.issue_label %}<span>{{ it | cmItemIssue(lang) }}</span>{% endif %}{{ ui.autoNote(it, lang) }}</p>
        </li>
        {% endfor %}
      </ul>
      {% if (W.neta65 | length) > 6 %}<p class="mt-2 text-sm text-muted">{{ "community.digest.and_more" | t(lang, { n: (W.neta65 | length) - 6 }) }}</p>{% endif %}
      {% else %}
      <p class="mt-2 text-sm leading-relaxed text-muted">{{ ("community.writers.card_none" if W.texas | length else "community.writers.card_empty") | t(lang) }}</p>
      {% endif %}
      {% if W.texas | length %}
      <h4 class="eyebrow mt-5 flex items-center gap-1.5">{% icon "map-pin", "size-3.5" %} {{ "community.writers.group_texas" | t(lang) }}</h4>
      <ul class="mt-2 space-y-1.5 text-sm" role="list">
        {% for it in W.texas | limit(5) %}
        {%- set place = it | cmWriterPlace(lang) -%}
        <li class="leading-snug"><a class="font-medium text-ink no-underline hover:text-gv hover:underline" href="{{ it.url }}" target="_blank" rel="noopener">{{ it | tx("title", lang) }}<span class="sr-only"> {{ "community.new_tab" | t(lang) }}</span></a> <span class="text-muted">— {{ it | cmWriterName(lang) }}{% if place %}, {{ place }}{% endif %}</span></li>
        {% endfor %}
      </ul>
      {% if (W.texas | length) > 5 %}<p class="mt-2 text-sm text-muted">{{ "community.digest.and_more" | t(lang, { n: (W.texas | length) - 5 }) }}</p>{% endif %}
      {% endif %}
      {#- Full-width buttons: the card is narrow (20–22rem), so the labels get the whole row. -#}
      <div class="mt-5 flex flex-wrap gap-2 border-t border-line pt-4">
        <a class="btn-secondary btn-sm w-full text-center" href="{{ '/published/' | lurl(lang) }}">{% icon "award", "size-4 shrink-0" %} {{ "community.writers.see_all" | t(lang, { n: W.allDays }) }}</a>
        {% if not (W.neta65 | length) %}<a class="btn-secondary btn-sm w-full text-center" href="{{ '/contribute/' | lurl(lang) }}">{% icon "pen-line", "size-4 shrink-0" %} {{ "community.writers.write_cta" | t(lang) }}</a>{% endif %}
      </div>
    </div>
    {% endif %}
    </div>
  </div>
</section>

{#- ============ All posters ============ -#}
<section class="bg-surface-2/60 py-12 sm:py-16" aria-labelledby="mp-all-title">
  <div class="container-page">
    {{ ui.sectionHead("monthly.all_posters" | t(lang), "monthly.all_posters_sub" | t(lang), "", "", "image") }}
    <ul class="mp-grid" role="list">
      {#- this month is featured above; the grid holds the coming months -#}
      {% for pm in months %}{% if not pm.isCurrent %}
      <li>
        <a class="mp-thumb group" href="{{ ('/monthly/' + pm.key + '/') | lurl(lang) }}">
          <span class="mp-stage mp-stage--thumb" aria-hidden="true" inert><span class="mp-fit">{{ mp.poster(pm, lang, site, "g") }}</span></span>
          <span class="mp-thumb-label">
            <span class="font-semibold text-ink group-hover:text-gv group-hover:underline">{{ pm.title }}</span>
            {% if pm.isCurrent %}<span class="badge-new">{{ "monthly.current" | t(lang) }}</span>{% endif %}
          </span>
          {% if pm.gv %}<span class="block text-sm text-muted">{{ pm.gv.theme }}</span>{% endif %}
        </a>
      </li>
      {% endif %}{% endfor %}
    </ul>
  </div>
</section>

{#- ============ The 10 ways (canonical home of the guide) ============ -#}
{% if carry.ways.length %}
<section id="ways" class="container-page section scroll-mt-20" aria-labelledby="ways-title">
  <div class="max-w-3xl">
    <p class="eyebrow text-gv">{{ "monthly.put_to_work" | t(lang) }}</p>
    <h2 id="ways-title" class="h-section mt-1">{{ "monthly.ways_title" | t(lang) }}</h2>
    {% if carry.intro %}<p class="lead mt-3">{{ carry.intro[lang] }}</p>{% endif %}
  </div>
  <ol class="mp-ways mt-8" role="list">
    {% for w in carry.ways %}
    <li class="card card-pad">
      <span class="mp-way-n" aria-hidden="true">{{ loop.index }}</span>
      <span class="mp-tipicon">{% icon w.icon, "size-5" %}</span>
      <h3 class="h-card mt-3 text-lg"><span class="sr-only">{{ loop.index }}. </span>{{ w.title[lang] }}</h3>
      <p class="mt-1.5 text-sm text-muted">{{ w.text[lang] }}</p>
    </li>
    {% endfor %}
  </ol>
  <div class="mt-8 grid gap-5 lg:grid-cols-2">
    {% if carry.story_note %}
    <div class="card card-pad flex gap-4">
      <span class="mp-tipicon">{% icon "pen-line", "size-5" %}</span>
      <p class="text-ink">{{ carry.story_note[lang] }} <a class="link font-semibold" href="{{ '/contribute/' | lurl(lang) }}">{{ "nav.contribute" | t(lang) }}</a></p>
    </div>
    {% endif %}
    {% if carry.quote %}
    <figure class="card card-pad mp-quote">
      {% icon "quote", "size-6 text-grape" %}
      <blockquote class="mt-2 font-display text-xl text-ink">{{ carry.quote[lang] }}</blockquote>
      {% if carry.quote.cite %}<figcaption class="mt-2 text-sm text-muted">— {{ carry.quote.cite[lang] }}</figcaption>{% endif %}
    </figure>
    {% endif %}
  </div>
  {% if carry.source %}<p class="mt-6 max-w-3xl text-xs text-muted"><strong>{{ "monthly.source" | t(lang) }}:</strong> {{ carry.source[lang] }}</p>{% endif %}
</section>
{% endif %}
