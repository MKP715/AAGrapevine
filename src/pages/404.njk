---
# GitHub Pages serves /404.html for EVERY missing address (English or Spanish),
# so the page is fully bilingual. /es/404.html (Spanish first) also exists so
# the header's language switch works from this page. Not listed in the sitemap.
pagination: { data: languages, size: 1, alias: lang }
permalink: "{{ '/' if lang == 'en' else '/es/' }}404.html"
layout: layouts/base.njk
pageKey: "404"
titleKey: community.nf.page_title
descKey: community.nf.meta_desc
sitemap: false
eleventyExcludeFromCollections: true
pageScripts: ["/assets/js/community.js"]
---
{% import "macros/ui.njk" as ui with context %}
{%- set other = lang | otherLang -%}
{%- set popular = [
  { key: "nav.whats_new", url: "/whats-new/", icon: "sparkles" },
  { key: "nav.read", url: "/read/", icon: "book-open" },
  { key: "nav.listen", url: "/listen/", icon: "headphones" },
  { key: "nav.watch", url: "/watch/", icon: "circle-play" },
  { key: "nav.library", url: "/library/", icon: "library" },
  { key: "nav.meeting", url: "/meeting/", icon: "video" },
  { key: "nav.events", url: "/events/", icon: "calendar-days" },
  { key: "nav.gvr", url: "/gvr/", icon: "badge-check" },
  { key: "nav.districts", url: "/districts/", icon: "map" }
] -%}

<section class="page-hero pt-28 pb-16 sm:pt-32 sm:pb-20" data-nf>
  <div class="container-page relative z-10">
    <p class="mb-3 text-xs font-semibold uppercase tracking-[0.18em] text-white/70">{{ "community.nf.code" | t(lang) }}</p>
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] lg:items-end">
      <div>
        <h1 class="font-display text-4xl font-semibold leading-tight sm:text-5xl">{{ "community.nf.title" | t(lang) }}</h1>
        <p class="mt-2 font-display text-2xl italic text-white/70 sm:text-3xl" lang="{{ other }}">{{ "community.nf.title" | t(other) }}</p>
        <p class="mt-5 max-w-xl text-lg leading-relaxed text-white/85">{{ "community.nf.text" | t(lang) }}</p>
        <p class="mt-2 max-w-xl leading-relaxed text-white/65" lang="{{ other }}">{{ "community.nf.text" | t(other) }}</p>
        <p class="mt-3 text-xs text-white/50"><code class="break-all" data-nf-path></code></p>
      </div>
      <div class="rounded-2xl bg-white/10 p-5 ring-1 ring-white/20 backdrop-blur sm:p-6">
        <form action="{{ '/search/' | lurl(lang) }}" method="get" role="search">
          <label for="nf-q" class="block text-sm font-semibold text-white">{{ "community.nf.search_label" | t(lang) }} <span class="font-normal text-white/65" lang="{{ other }}">· {{ "community.nf.search_label" | t(other) }}</span></label>
          <div class="mt-2 flex gap-2">
            <input id="nf-q" name="q" type="search" class="input min-w-0 flex-1" placeholder="{{ 'community.nf.search_ph' | t(lang) }}" data-nf-query autocomplete="off" enterkeyhint="search">
            <button type="submit" class="btn-light shrink-0" aria-label="{{ 'community.nf.search_btn' | t(lang) }}">{% icon "search", "size-4" %}<span class="hidden sm:inline">{{ "community.nf.search_btn" | t(lang) }}</span></button>
          </div>
        </form>
        <div class="mt-4 flex flex-wrap gap-2">
          <a class="btn-light btn-sm" href="{{ '/' | lurl(lang) }}">{% icon "house", "size-4" %} {{ "community.nf.home" | t(lang) }}</a>
          <a class="btn-on-dark btn-sm" href="{{ '/' | lurl(other) }}" hreflang="{{ other }}" lang="{{ other }}">{% icon "languages", "size-4" %} {{ "community.nf.home" | t(other) }}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section container-page pt-6" aria-labelledby="nf-popular">
  <h2 id="nf-popular" class="h-section">{{ "community.nf.popular" | t(lang) }} <span class="font-normal text-muted" lang="{{ other }}">· {{ "community.nf.popular" | t(other) }}</span></h2>
  <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3" role="list">
    {% for p in popular %}
    <li class="card card-link relative flex items-center gap-4 p-4">
      <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-gv-soft text-gv">{% icon p.icon, "size-5" %}</span>
      <span class="min-w-0 flex-1">
        <a class="block font-semibold text-ink no-underline after:absolute after:inset-0 hover:text-gv" href="{{ p.url | lurl(lang) }}">{{ p.key | t(lang) }}</a>
        <a class="relative z-10 text-sm text-muted hover:text-gv hover:underline" href="{{ p.url | lurl(other) }}" hreflang="{{ other }}" lang="{{ other }}">{{ p.key | t(other) }}</a>
      </span>
      {% icon "arrow-right", "size-4 text-faint" %}
    </li>
    {% endfor %}
  </ul>
  <p class="mt-8 text-sm text-muted">
    {% icon "mail", "size-4 inline -mt-0.5" %} <a class="link" href="mailto:{{ site.contact_email }}">{{ site.contact_email }}</a>
  </p>
</section>
