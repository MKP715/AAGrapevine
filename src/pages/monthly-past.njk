---
# A month that has left /monthly/'s window (the 3 months before this one): a tiny stand-alone page
# that sends the visitor to /monthly/ (this month's toolkit and poster), so the QR code on a printed
# poster and a shared link keep working. Same pattern as subscribe-redirect.njk: noindex + canonical,
# out of the sitemap, the search index and page lists.
pagination: { data: monthlyPastPages, size: 1, alias: past }
permalink: "{{ '/' if past.lang == 'en' else '/es/' }}monthly/{{ past.key }}/index.html"
layout: false
sitemap: false
eleventyExcludeFromCollections: true
---
{%- set lang = past.lang -%}
{%- set target = "/monthly/" | lurl(lang) -%}
<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
{#- the base plugin does not rewrite script text, so the url filter adds the path prefix -#}
<script>location.replace({{ (target | url) | dump | safe }});</script>
<meta http-equiv="refresh" content="0; url={{ target }}">
<meta name="robots" content="noindex">
<link rel="canonical" href="{{ target | siteUrl(site) }}">
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="icon" href="/favicon.ico" sizes="any">
<title>{{ "monthly.title" | t(lang) }} · {{ site | pick(lang, "title") }}</title>
<style>
  :root { color-scheme: light dark; --paper: #fbf8f2; --ink: #1d1a26; --muted: #57526a; --link: #0a5fa8; }
  @media (prefers-color-scheme: dark) { :root { --paper: #121019; --ink: #eeeaf6; --muted: #b3adc4; --link: #8cc2f2; } }
  body { margin: 0; min-height: 100vh; display: grid; place-items: center; padding: 16px; box-sizing: border-box;
         font: 17px/1.55 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; background: var(--paper); color: var(--ink); }
  main { max-width: 34rem; text-align: center; overflow-wrap: anywhere; }
  h1 { font-family: Georgia, "Times New Roman", serif; font-size: 1.6rem; margin: 0 0 .5rem; }
  p { margin: .5rem 0; color: var(--muted); }
  a { color: var(--link); font-weight: 600; }
</style>
</head>
<body>
<main>
  <h1>{{ "monthly.past_title" | t(lang, { month: past.label | capitalize }) }}</h1>
  <p>{{ "monthly.past_text" | t(lang) }}</p>
  <p><a href="{{ target }}">{{ "monthly.title" | t(lang) }} →</a></p>
</main>
</body>
</html>
