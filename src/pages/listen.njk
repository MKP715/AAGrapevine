---
pagination: { data: languages, size: 1, alias: lang }
permalink: "{{ '/' if lang == 'en' else '/es/' }}listen/index.html"
layout: layouts/base.njk
pageKey: listen
titleKey: nav.listen
descKey: media.listen_meta
pageScripts: ["/assets/vendor/lite-yt-embed.js", "/assets/js/media.js"]
pageStyles: ["/assets/vendor/lite-yt-embed.css"]
---
{#- LISTEN — AA Grapevine's podcasts (every show in episodes.json `shows` /
    config sources.podcasts: today "AA Grapevine's Podcast" (gv) and the
    "Grapevine Weekly Open AA Meeting" recordings (wo)).
    Server-renders the newest 24 episodes (no-JS / SEO); media.js loads the rest
    from /episodes-index.json for "Load more", search and filters, and drives one
    shared <audio> element (featured player, show cards, rows + sticky mini-player).
    Blocks, in DOM (= phone, = Tab) order: .listen-side = the latest-episode player (.listen-feature)
    + an official AA Grapevine YouTube Short (config/site.yml site.listen.sidebar_short) in a
    privacy-friendly vertical lite-youtube (.listen-short); the shows; all episodes. From 1440px
    .listen-side is the right-hand column (the player, the Short right under it): in windows tall
    enough for both it stays in view as ONE sticky stack; in shorter ones the Short alone sticks. -#}
{% import "macros/ui.njk" as ui with context %}
{% import "macros/media.njk" as media with context %}
{% mediaSprite %}
{%- set cfgShows = site.sources.podcasts or [] -%}
{%- set eps = db.episodes | mediaItems("episodes") -%}
{%- set shows = db.episodes | mediaShowList(cfgShows, eps, lang) -%}
{%- set multi = shows.length > 1 -%}
{%- set primary = shows[0].key if shows.length else "" -%}
{%- set featured = eps[0] if eps.length else null -%}
{%- set allSeasons = eps | mediaSeasons -%}
{%- set langs = eps | mediaCount("lang") -%}
{%- set mixedLangs = (langs | keys).length > 1 -%}
{%- set hours = ((eps | mediaSumDuration) / 3600) | round(0, "floor") -%}
{%- set ssr = eps | limit(24) -%}
{#- The weekly open meetings in one short line ("Wednesdays (English) and Thursdays (Spanish)"), linking
    to their one home, /meetings/#weekly-open, where the times and Zoom details are -#}
{#- (the Grapevine Weekly Open show card names only the Grapevine meeting it records) -#}
{%- set woWhen = (db.weekly_open.items | mediaWeeklyDays(lang, "grapevine")) if db.weekly_open else "" -%}

{#- ------------------------------------------------------------------ macros -#}

{#- Icon-only player button (−15 / +30 / close …) -#}
{% macro pbtn(icon, label, click, cls="") %}
<button type="button" class="media-pbtn {{ cls }}" @click="{{ click }}" aria-label="{{ label }}" title="{{ label }}">{% icon icon, "size-5" %}</button>
{% endmacro %}

{#- Play/pause glyphs driven by `playingExpr` -#}
{% macro ppIcons(playingExpr, loadingExpr, size="size-6") %}
<span x-show="{{ loadingExpr }}" x-cloak class="grid place-items-center">{% icon "loader-circle", size + " animate-spin" %}</span>
<span x-show="!({{ loadingExpr }}) && {{ playingExpr }}" x-cloak class="grid place-items-center">{% icon "pause", size %}</span>
<span x-show="!({{ loadingExpr }}) && !({{ playingExpr }})" class="grid place-items-center">{% icon "play", size + " translate-x-px" %}</span>
{% endmacro %}

{#- One episode row. srv=true: static text from `e` (first 24, SEO/no-JS) with
    `ep` bound to the inline JSON; srv=false: Alpine template row (x-for ep). -#}
{% macro epRow(e, lang, i, srv) %}
{%- if srv -%}
  {%- set title = e | mediaTitle(lang) -%}
  {%- set summary = e | tx("summary", lang) -%}
  {%- set se = e | mediaSE(lang) -%}
  {%- set mins = e.extra.duration_sec | mediaMinutes(lang) -%}
  {%- set art = (e.extra.thumb or e.image) | mediaSafeUrl("") -%}
  {%- set sh = e | mediaShowOf(shows) -%}
{%- endif %}
<li class="ep-row" x-data="{ open: false{% if srv %}, ep: epAt({{ i }}){% endif %} }" :class="rowCls(ep)"{% if srv %} x-show="keep(ep)"{% endif %}>
  <button type="button" class="ep-art" @click="tog(ep)" {% if srv %}aria-label="{{ 'media.play' | t(lang) }}: {{ title }}" {% endif %}:aria-label="playLabel(ep)">
    {%- if srv %}{% if art %}<img src="{{ art }}" alt="" width="80" height="80" loading="lazy" decoding="async" referrerpolicy="no-referrer" onerror="this.style.visibility='hidden'">{% else %}<span class="ep-art-ph">{% micon "headphones", "size-7" %}</span>{% endif %}
    {%- else %}<img :src="art(ep)" x-show="art(ep)" alt="" width="80" height="80" loading="lazy" decoding="async" referrerpolicy="no-referrer" @error="$el.style.visibility = 'hidden'"><span class="ep-art-ph" x-show="!art(ep)">{% micon "headphones", "size-7" %}</span>{% endif %}
    <span class="ep-art-overlay" aria-hidden="true">
      <span class="ep-eq" x-show="isOn(ep) && !isBusy(ep)" x-cloak><i></i><i></i><i></i></span>
      <span x-show="isBusy(ep)" x-cloak>{% micon "loader-circle", "size-6 animate-spin" %}</span>
      <span class="ep-art-play" x-show="!isOn(ep)">{% micon "play", "size-6 translate-x-px" %}</span>
    </span>
    <span class="ep-progress" x-show="pct(ep) > 0" x-cloak aria-hidden="true"><span :style="'width:' + pct(ep) + '%'"></span></span>
  </button>
  <div class="min-w-0 flex-1">
    <p class="flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted">
      {%- if srv %}
      {% if multi and sh and sh.key != primary %}<span class="badge-grape">{% micon "users", "size-3" %} {{ sh.short }}</span>{% endif %}
      {% if se %}<span class="font-semibold text-gv">{{ se }}</span>{% endif %}
      {% if e.date %}<time datetime="{{ e.date | isoDate }}">{{ e.date | fmtDate(lang, "short") }}</time>{% endif %}
      {% if mins %}<span class="inline-flex items-center gap-1">{% micon "clock-3", "size-3.5" %}{{ mins }}</span>{% endif %}
      {% if e.is_new %}<span class="badge-new">{{ "common.new" | t(lang) }}</span>{% endif %}
      {% if mixedLangs %}{{ ui.langPill(e, lang) }}{% endif %}
      {%- else %}
      <span class="badge-grape" x-show="showBadge(ep)">{% micon "users", "size-3" %} <span x-text="showBadge(ep)"></span></span>
      <span class="font-semibold text-gv" x-show="seLabel(ep)" x-text="seLabel(ep)"></span>
      <time x-show="ep.d" :datetime="ep.d" x-text="date(ep.d)"></time>
      <span class="inline-flex items-center gap-1" x-show="ep.du">{% micon "clock-3", "size-3.5" %}<span x-text="mins(ep.du)"></span></span>
      <span class="badge-new" x-show="ep.n">{{ "common.new" | t(lang) }}</span>
      <span class="badge-muted uppercase" x-show="foreign(ep)" x-text="ep.l" :title="langTitle(ep.l)"></span>
      {%- endif %}
      {#- the audio file's size — only while Data saver is on (areas/pwa.css .pwa-saver-only; pwa.js GV.fileSize) -#}
      <span class="pwa-saver-only" x-show="ep.b" x-cloak><span class="sr-only">{{ "pwa.audio_size" | t(lang) }} </span><span x-text="ep.b ? GV.fileSize(ep.b) : ''"></span></span>
      <span class="inline-flex items-center gap-1 font-semibold text-vine" x-show="isDone(ep)" x-cloak>{% micon "check", "size-3.5" %}{{ "media.played" | t(lang) }}</span>
    </p>
    <h3 class="mt-1 font-display text-[1.05rem] font-semibold leading-snug text-ink sm:text-lg"{% if not srv %} x-text="ep.t"{% endif %}>{% if srv %}{{ title }}{% endif %}</h3>
    <p class="measure mt-1 line-clamp-2 text-sm leading-relaxed text-muted" :class="open && 'line-clamp-none!'"{% if not srv %} x-text="ep.s"{% endif %}>{% if srv %}{{ summary }}{% endif %}</p>
    <div class="mt-1.5 flex flex-wrap items-center gap-x-4 gap-y-1">
      <button type="button" class="-my-1.5 hidden min-h-11 items-center gap-1 text-xs font-semibold text-gv hover:underline sm:inline-flex" x-show="long(ep)" x-cloak @click="open = !open" :aria-expanded="open"><span x-text="open ? T.show_less : T.show_more"></span>{% micon "chevron-down", "size-3.5" %}</button>
      {%- if srv %}{% if e | machineFor(lang) %}<span class="auto-note" title="{{ 'common.auto_translated_help' | t(lang) }}">{% micon "languages", "size-3" %} {{ "common.auto_translated" | t(lang) }}</span>{% endif %}
      {%- else %}<span class="auto-note" x-show="ep.m" title="{{ 'common.auto_translated_help' | t(lang) }}">{% micon "languages", "size-3" %} {{ "common.auto_translated" | t(lang) }}</span>{% endif %}
    </div>
  </div>
  <div class="hidden shrink-0 self-center sm:block">
    <button type="button" class="ep-pill" @click="tog(ep)" tabindex="-1" aria-hidden="true">
      <span x-show="isOn(ep)" x-cloak>{% micon "pause", "size-4" %}</span><span x-show="!isOn(ep)">{% micon "play", "size-4 translate-x-px" %}</span>
      <span x-text="pillText(ep)">{% if srv %}{{ mins or ("media.play" | t(lang)) }}{% endif %}</span>
    </button>
  </div>
</li>
{% endmacro %}

{#- ------------------------------------------------------------------ hero
    The shared hero (same height as every page): short lead, ONE actions row and,
    from 768px, three compact stats (hidden on phones so the hero stays 24–28rem).
    The "Latest episode" player is the first block below it (page-overlap). -#}
{#- ui.heroStats skips entries whose value is "" -#}
{%- set heroNums = [
  { value: eps.length | mediaNumber(lang), label: "media.stat_episodes" | t(lang) },
  { value: shows.length if multi else (allSeasons.length if allSeasons.length > 1 else ""), label: ("media.stat_shows" if multi else "media.stat_seasons") | t(lang) },
  { value: (hours + "+") if hours >= 2 else "", label: "media.stat_hours" | t(lang) }
] -%}
{% call ui.pageHero(lang, "media.listen_title" | t(lang), "media.listen_sub" | t(lang), "headphones", "media.listen_eyebrow" | t(lang)) %}
  {#- #episodes / #shows only exist when episodes are synced (else: the empty state) -#}
  {% if eps.length %}
  <div class="hero-actions">
    <a class="btn-light" href="#episodes">{% icon "list-music", "size-4" %} {{ "media.browse_episodes" | t(lang) }}</a>
    {#- phones: one button row (the shows are the next block after the player anyway) -#}
    {% if shows.length %}<a class="btn-on-dark max-sm:hidden" href="#shows">{% icon "podcast", "size-4" %} {{ "media.meet_shows" | t(lang) }}</a>{% endif %}
  </div>
  {{ ui.heroStats(heroNums) }}
  {% endif %}
{% endcall %}

{% if eps.length %}
<script type="application/json" id="media-initial">{{ ssr | mediaInitialJson("episodes", lang, shows) | safe }}</script>
<script type="application/json" id="media-i18n">{{ ["media.play", "media.play_latest", "media.pause", "media.resume", "media.played", "media.playing", "media.showing", "media.se_short", "media.ep_short", "media.left", "media.time_of", "media.speed", "common.show_more", "common.show_less", "common.loading", "lang.en", "lang.es"] | mediaI18n(lang) | safe }}</script>

<div x-data="podcastPage" data-index="{{ '/episodes-index.json' | lurl(lang) }}" data-total="{{ eps.length }}" data-mixed="{{ 'true' if mixedLangs else 'false' }}">

  {#- Layout (areas/media.css .listen-layout): below 1440px it all stacks — .listen-side (the
      latest-episode player, tucked into the hero's fade, and the Short right under it as a slim
      band), the shows, all episodes. From 1440px: the shows and the episodes on the left;
      .listen-side is the fixed-width right-hand column — the player, then the Short. In windows at
      least 56.25rem (900px) tall (the whole column fits under the header) the two stay in view
      together as ONE sticky stack all the way down the episode list; in shorter windows the player
      scrolls away (the mini-player takes over) and the Short alone sticks under the header. The
      Short never moves up into the player, so nothing can slide over it (CSS only, no JS). -#}
  <div class="container-page listen-layout">
  {%- set shortId = site.listen.sidebar_short if site.listen else "" %}

  <div class="listen-side page-overlap">

  {#- ------------------------------------------------------------ featured player -#}
  {%- set f = featured -%}
  {%- set fTitle = f | mediaTitle(lang) -%}
  {%- set fSE = f | mediaSE(lang) -%}
  {%- set fArt = (f.extra.thumb or f.image) | mediaSafeUrl("") -%}
  {%- set fShow = f | mediaShowOf(shows) -%}
  <section class="listen-feature" aria-labelledby="featured-ep-title">
    {#- From 1440px, where it is the right-hand column (media.js $store.audio.wide), this card is THE
        player: an episode started from the list or a show card shows here as "Now playing" (alt),
        with "Back to latest"; the mini-player stays hidden while the card is on screen. Below that
        it always shows the latest episode and the mini-player takes over. -#}
    <div class="card media-feature overflow-hidden" x-data="{ latest: epAt(0), get alt() { var a = this.$store.audio; return a.wide && a.curEp && a.curEp.id && a.curEp.id !== this.latest.id ? a.curEp : null; }, get ep() { return this.alt || this.latest; } }">
      <div class="grid grid-cols-1 md:grid-cols-[minmax(0,15rem)_minmax(0,1fr)] lg:grid-cols-[minmax(0,19rem)_minmax(0,1fr)] min-[90rem]:grid-cols-1">
        <div class="media-feature-art hidden md:flex min-[90rem]:hidden">
          {% if fArt %}<img src="{{ fArt }}" alt="" width="304" height="304" loading="lazy" decoding="async" referrerpolicy="no-referrer">{% else %}<span class="ep-art-ph size-full">{% icon "headphones", "size-16" %}</span>{% endif %}
        </div>
        {#- From 1440px (the right-hand column, above the Short) the card is compact and of bounded
            height (~400–480px), so the two fit the window together: the small artwork beside a title
            of at most three lines, the short date, a two-line summary (the full title and summary are
            in the first row of the episode list), a slimmer player and the keyboard hint alone. -#}
        <div class="flex min-w-0 flex-col gap-3 p-4 min-[400px]:p-5 sm:p-7 min-[90rem]:p-5">
          <div class="flex items-start gap-4">
            {% if fArt %}<img src="{{ fArt }}" alt="" width="88" height="88" loading="lazy" class="size-[5.5rem] shrink-0 rounded-xl object-cover shadow-md ring-1 ring-black/5 md:hidden min-[90rem]:block" x-show="!alt" decoding="async" referrerpolicy="no-referrer">{% endif %}
            <img :src="alt ? art(alt) : ''" alt="" width="88" height="88" class="size-[5.5rem] shrink-0 rounded-xl object-cover shadow-md ring-1 ring-black/5" x-show="alt && art(alt)" x-cloak referrerpolicy="no-referrer">
            <div class="min-w-0">
              <p class="flex flex-wrap items-center gap-2" x-show="!alt">
                <span class="eyebrow text-gv">{{ "media.latest_episode" | t(lang) }}</span>
                {% if f.is_new %}<span class="badge-new">{{ "common.new" | t(lang) }}</span>{% endif %}
                {% if fSE %}<span class="badge-gv">{{ fSE }}</span>{% endif %}
                {{ ui.langPill(f, lang) }}
              </p>
              <p class="flex flex-wrap items-center gap-x-3 gap-y-1" x-show="alt" x-cloak>
                <span class="eyebrow text-grape">{{ "media.now_playing" | t(lang) }}</span>
                <button type="button" class="-my-3 inline-flex min-h-11 items-center gap-1 text-xs font-semibold text-gv hover:underline" @click="$store.audio.load(latest, false)">{% icon "rotate-ccw", "size-3.5" %}{{ "media.back_latest" | t(lang) }}</button>
              </p>
              <h2 id="featured-ep-title" class="mt-2 font-display text-2xl font-semibold leading-tight text-balance sm:text-3xl min-[90rem]:line-clamp-3 min-[90rem]:text-2xl"><span x-show="!alt">{{ fTitle }}</span><span x-show="alt" x-cloak x-text="alt ? alt.t : ''"></span></h2>
            </div>
          </div>
          <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted" x-show="!alt">
            <span class="font-medium text-ink">{{ fShow.name if fShow else f.extra.show_name }}</span>
            {% if f.date %}<time datetime="{{ f.date | isoDate }}"><span class="min-[90rem]:hidden">{{ f.date | fmtDate(lang, "medium") }}</span><span class="hidden min-[90rem]:inline">{{ f.date | fmtDate(lang, "short") }}</span></time>{% endif %}
            {% if f.extra.duration_sec %}<span class="inline-flex items-center gap-1">{% icon "clock-3", "size-3.5" %}{{ f.extra.duration_sec | mediaMinutes(lang) }}</span>{% endif %}
            {% if f.extra.audio_bytes %}<span class="pwa-saver-only"><span class="sr-only">{{ "pwa.audio_size" | t(lang) }} </span>{{ f.extra.audio_bytes | fileSize }}</span>{% endif %}
          </p>
          <p class="flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted" x-show="alt" x-cloak>
            <span class="font-medium text-ink" x-show="alt && showName(alt)" x-text="alt ? showName(alt) : ''"></span>
            <time x-show="alt && alt.d" :datetime="alt && alt.d" x-text="alt && alt.d ? date(alt.d) : ''"></time>
            <span class="inline-flex items-center gap-1" x-show="alt && alt.du">{% icon "clock-3", "size-3.5" %}<span x-text="alt && alt.du ? mins(alt.du) : ''"></span></span>
            <span class="pwa-saver-only" x-show="alt && alt.b"><span class="sr-only">{{ "pwa.audio_size" | t(lang) }} </span><span x-text="alt && alt.b ? GV.fileSize(alt.b) : ''"></span></span>
          </p>
          <p class="line-clamp-2 leading-relaxed text-muted" x-show="alt && alt.s" x-cloak x-text="alt ? alt.s : ''"></p>
          {%- set fSum = f | tx("summary", lang) -%}
          {% if fSum %}
          <div x-data="{ more: false }" x-show="!alt">
            <p class="line-clamp-3 leading-relaxed text-muted min-[90rem]:line-clamp-2" :class="more && 'line-clamp-none!'">{{ fSum }}</p>
            <div class="mt-1 flex flex-wrap items-center gap-x-4">
              {% if fSum.length > 180 %}<button type="button" class="-my-1.5 inline-flex min-h-11 items-center text-xs font-semibold text-gv hover:underline min-[90rem]:hidden" data-js-only @click="more = !more" :aria-expanded="more" x-text="more ? T.show_less : T.show_more">{{ "common.show_more" | t(lang) }}</button>{% endif %}
              {{ ui.autoNote(f, lang) }}
            </div>
          </div>
          {% endif %}

          {#- The player (shares the page-wide audio element with the mini-player) -#}
          <div class="media-player mt-1 max-sm:p-3 min-[90rem]:px-4 min-[90rem]:py-3" role="group" aria-label="{{ 'media.player_label' | t(lang) }}: {{ fTitle }}"
               data-label="{{ 'media.player_label' | t(lang) }}: " data-latest="{{ 'media.player_label' | t(lang) }}: {{ fTitle }}"
               :aria-label="alt ? $el.dataset.label + alt.t : $el.dataset.latest"
               x-init="$store.audio.watchFeatured($el, ep)" @keydown="$store.audio.onKey($event, ep)">
            <div class="flex items-center gap-3 text-xs font-medium tabular-nums text-muted">
              <span class="w-12 text-right" x-text="clock($store.audio.timeFor(ep))">0:00</span>
              <input type="range" class="media-range flex-1" min="0" step="1" value="0"
                     :max="Math.max(1, Math.round($store.audio.durFor(ep)))" :value="Math.round($store.audio.timeFor(ep))"
                     :style="'--pct:' + $store.audio.pctLive(ep) + '%'"
                     @input="$store.audio.scrub(ep, $event.target.value)" @change="$store.audio.seekTo(ep, $event.target.value)"
                     aria-label="{{ 'media.seek' | t(lang) }}" :aria-valuetext="valueText(ep)">
              <span class="w-12" x-text="clock($store.audio.durFor(ep))">{{ f.extra.duration_sec | duration }}</span>
            </div>
            <div class="mt-3 flex items-center justify-between gap-2">
              <button type="button" class="media-rate max-sm:min-w-12 max-sm:px-2 max-[359px]:hidden" @click="$store.audio.cycleRate()" aria-label="{{ 'media.speed' | t(lang) }}" :aria-label="T.speed + ': ' + $store.audio.rate + '×'" title="{{ 'media.speed' | t(lang) }}"><span x-text="$store.audio.rate + '×'">1×</span></button>
              <div class="flex items-center gap-1 sm:gap-3">
                <button type="button" class="media-pbtn media-skip" @click="$store.audio.skipFor(ep, -15)" aria-label="{{ 'media.back_15' | t(lang) }}" title="{{ 'media.back_15' | t(lang) }}">{% icon "rotate-ccw", "size-6" %}<span>15</span></button>
                <button type="button" class="media-play max-sm:size-14 min-[90rem]:size-14" @click="$store.audio.toggleEp(ep)"
                        aria-label="{{ 'media.play' | t(lang) }}: {{ fTitle }}" :aria-label="playLabel(ep)">
                  {{ ppIcons("$store.audio.isPlaying(ep.id)", "$store.audio.isCurrent(ep.id) && $store.audio.loading", "size-7") }}
                </button>
                <button type="button" class="media-pbtn media-skip" @click="$store.audio.skipFor(ep, 30)" aria-label="{{ 'media.fwd_30' | t(lang) }}" title="{{ 'media.fwd_30' | t(lang) }}">{% icon "rotate-cw", "size-6" %}<span>30</span></button>
              </div>
              <div class="flex min-w-12 items-center justify-end sm:min-w-14 max-[359px]:min-w-0">
                <button type="button" class="media-pbtn" data-share="{{ page.url | siteUrl(site) }}#episodes" data-share-title="{{ fTitle }}" aria-label="{{ 'common.share' | t(lang) }}" title="{{ 'common.share' | t(lang) }}">{% icon "share-2", "size-5" %}</button>
                {%- set fLink = f | mediaEpisodePage -%}
                {% if fLink %}<a class="media-pbtn hidden sm:grid" x-show="!alt" href="{{ fLink }}" target="_blank" rel="noopener" aria-label="{{ 'media.episode_page' | t(lang) }} ({{ 'common.external' | t(lang) }})" title="{{ 'media.episode_page' | t(lang) }}">{% icon "external-link", "size-5" %}</a>{% endif %}
              </div>
            </div>
            <p class="mt-3 text-sm text-danger" x-show="$store.audio.error && $store.audio.isCurrent(ep.id)" x-cloak role="alert">
              {{ "media.audio_error" | t(lang) }}
              <button type="button" class="ml-1 font-semibold underline" @click="$store.audio.retry()">{{ "media.retry" | t(lang) }}</button>
            </p>
            <noscript><audio class="mt-3 w-full" controls preload="none" src="{{ f.extra.audio_url | mediaSafeUrl('') }}"></audio></noscript>
          </div>
          {#- (from 1440px without "your place is saved" — the hero's lead already says so) -#}
          <p class="hidden text-xs text-faint lg:block">{% icon "keyboard", "mr-1 inline size-3.5 align-[-2px]" %}{{ "media.keys_hint" | t(lang) }}<span class="min-[90rem]:hidden"> · {{ "media.remembers" | t(lang) }}</span></p>
        </div>
      </div>
    </div>
  </section>

  {#- ------------------------------------------------------------ the Short
      One element, always right under the player: below 1440px a band (a 9:16 video beside its
      caption and the two app links); from 1440px the lower card of the right-hand column (the video
      beside the caption, the app links stacked under the caption). -#}
  {% if shortId %}
  {%- set shortTitle = site.listen.sidebar_short_title or "AA Grapevine" -%}
  {%- set shortUrl = "https://www.youtube.com/shorts/" + shortId -%}
  <aside class="card listen-short" aria-labelledby="listen-short-title">
    <div class="listen-short-video">
      <lite-youtube videoid="{{ shortId }}" class="media-lyt listen-lyt" params="rel=0&amp;playsinline=1&amp;hl={{ lang }}"
                    style="background-image: url('{{ shortId | ytThumb }}');" playlabel="{{ 'media.play' | t(lang) }}: {{ shortTitle }}">
        <a href="{{ shortUrl }}" class="lyt-playbtn" title="{{ 'media.play' | t(lang) }}: {{ shortTitle }}" target="_blank" rel="noopener">
          <span class="lyt-visually-hidden">{{ "media.play" | t(lang) }}: {{ shortTitle }}</span>
        </a>
      </lite-youtube>
    </div>
    <div class="listen-short-body">
      <p class="eyebrow flex items-center gap-1.5 text-grape">{% icon "youtube", "size-3.5 min-[90rem]:hidden" %} {{ "media.short_eyebrow" | t(lang) }}</p>
      <h2 id="listen-short-title" class="mt-1.5 font-display text-xl font-semibold leading-snug text-ink min-[90rem]:text-lg"{% if lang != "en" %} lang="en"{% endif %}>{{ shortTitle }}</h2>
      <p class="mt-1.5 text-sm leading-relaxed text-muted">{{ "media.short_text" | t(lang) }}</p>
    </div>
    {% set appBtns = [["gv", site.links.gv_apps, "media.short_gv_app"], ["lv", site.links.lv_apps, "media.short_lv_app"]] %}
    <p class="listen-short-links">
      {% for b in (appBtns | reverse if lang == "es" else appBtns) %}{% if b[1] %}
      <a class="media-plat" href="{{ b[1] }}" target="_blank" rel="noopener"><span class="media-plat-icon {{ 'text-lv' if b[0] == 'lv' else 'text-gv' }}">{% icon "smartphone", "size-4" %}</span>{{ b[2] | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a>
      {% endif %}{% endfor %}
    </p>
  </aside>
  {% endif %}

  </div>{#- /.listen-side -#}

  {#- ------------------------------------------------------------ the shows -#}
  <section id="shows" class="listen-shows" aria-labelledby="shows-title">
    {{ ui.sectionHead("media.shows_title" | t(lang), "media.shows_sub" | t(lang), "", "", "podcast", { eyebrow: "media.shows_eyebrow" | t(lang), tone: "text-grape", id: "shows-title", lang: lang }) }}
    <div class="grid grid-cols-1 gap-5 {{ 'lg:grid-cols-2' if multi }}">
      {% for s in shows %}
      {%- set latestPage = s.latest | mediaEpisodePage -%}
      <article class="card show-card {{ 'is-weekly' if s.weekly else 'is-podcast' }} flex flex-col overflow-hidden" aria-labelledby="show-{{ s.key }}-title"
               x-data="{ ep: latestOf('{{ s.key }}') }">
        <div class="show-card-head flex items-start gap-4 p-5 sm:gap-5 sm:p-6">
          {% if s.thumb or s.image %}<img src="{{ s.thumb or s.image }}" alt="" width="112" height="112" loading="lazy" decoding="async" referrerpolicy="no-referrer" class="show-card-art" onerror="this.style.visibility='hidden'">
          {% else %}<span class="show-card-art ep-art-ph">{% micon "headphones", "size-10" %}</span>{% endif %}
          <div class="min-w-0 flex-1">
            <p class="eyebrow {{ 'text-grape' if s.weekly else 'text-gv' }}">{% if s.weekly %}{{ "media.kind_weekly" | t(lang) }}{% else %}{{ "media.kind_podcast_badge" | t(lang) }}{% endif %}</p>
            <h3 id="show-{{ s.key }}-title" class="mt-1 font-display text-xl font-semibold leading-tight text-balance text-ink sm:text-2xl">{{ s.name }}</h3>
            <p class="mt-1.5 flex flex-wrap items-center gap-x-1.5 gap-y-0.5 text-sm text-muted">
              <span>{{ "media.show_episodes_n" | t(lang, { n: s.count | mediaNumber(lang) }) }}</span>
              {% if s.seasons.length > 1 %}<span class="whitespace-nowrap"><span aria-hidden="true">· </span>{{ "media.show_seasons_n" | t(lang, { n: s.seasons.length }) }}</span>{% endif %}
            </p>
            {% if s.weekly and woWhen %}
            <p class="mt-2 inline-flex items-start gap-2 rounded-2xl bg-grape-soft px-3 py-1.5 text-xs leading-snug font-semibold text-grape">
              <span class="relative mt-1 flex size-2 shrink-0" aria-hidden="true"><span class="absolute inline-flex size-full animate-ping rounded-full bg-grape opacity-40"></span><span class="relative inline-flex size-2 rounded-full bg-grape"></span></span>
              <span>{{ "media.wo_live" | t(lang, { when: woWhen }) }}</span>
            </p>
            {% endif %}
          </div>
        </div>
        {% if s.desc %}
        <div class="px-5 sm:px-6">
          <p class="text-sm leading-relaxed text-muted max-sm:line-clamp-3">{{ s.desc }}</p>
          {% if s.descMachine %}<span class="auto-note mt-1" title="{{ 'common.auto_translated_help' | t(lang) }}">{% icon "languages", "size-3" %} {{ "common.auto_translated" | t(lang) }}</span>{% endif %}
        </div>
        {% endif %}
        <div class="flex flex-wrap gap-2 px-5 pt-4 sm:px-6">
          <a class="btn-primary btn-sm" href="{{ latestPage or s.web or '#episodes' }}"{% if latestPage or s.web %} target="_blank" rel="noopener"{% endif %}
             @click="playLatest(ep, $event)" :aria-label="latestLabel(ep)">
            <span x-show="!isOn(ep)">{% micon "play", "size-4 translate-x-px" %}</span><span x-show="isOn(ep)" x-cloak>{% micon "pause", "size-4" %}</span>
            <span x-text="latestText(ep)">{{ "media.play_latest" | t(lang) }}</span>
          </a>
          <a class="btn-secondary btn-sm" href="#episodes" @click.prevent="pickShow('{{ s.key }}')">{% icon "list-music", "size-4" %} {{ "media.see_episodes" | t(lang) }}</a>
          {% if s.weekly %}<a class="btn-ghost btn-sm" href="{{ '/meetings/#weekly-open' | lurl(lang) }}">{% icon "video", "size-4" %} {{ "media.wo_join" | t(lang) }}</a>{% endif %}
        </div>
        <div class="mt-auto px-5 pt-5 pb-5 sm:px-6">
          <div class="border-t border-line pt-4">
            <p class="text-xs font-semibold tracking-wider text-faint uppercase">{{ "media.follow_in" | t(lang) }}</p>
            {#- phones: one line that scrolls sideways; wraps from 1024px -#}
            <ul class="chip-row mt-2.5" role="list">
              {% if s.apple %}<li><a class="media-plat" href="{{ s.apple }}" target="_blank" rel="noopener"><span class="media-plat-icon text-grape">{% icon "podcast", "size-4" %}</span>{{ "media.apple" | t(lang) }}</a></li>{% endif %}
              {% if s.spotify %}<li><a class="media-plat" href="{{ s.spotify }}" target="_blank" rel="noopener"><span class="media-plat-icon text-vine">{% icon "spotify", "size-4" %}</span>{{ "media.spotify" | t(lang) }}</a></li>{% endif %}
              {% if s.amazon %}<li><a class="media-plat" href="{{ s.amazon }}" target="_blank" rel="noopener"><span class="media-plat-icon text-gv">{% icon "music", "size-4" %}</span>{{ "media.amazon" | t(lang) }}</a></li>{% endif %}
              {% if s.web %}<li><a class="media-plat" href="{{ s.web }}" target="_blank" rel="noopener"><span class="media-plat-icon text-lv">{% icon "grapes", "size-4" %}</span>{{ "media.web_short" | t(lang) }}</a></li>{% endif %}
              {% if s.feed %}<li><button type="button" class="media-plat" data-copy="{{ s.feed }}" title="{{ 'media.rss_help' | t(lang) }}" aria-label="{{ 'media.copy_rss' | t(lang) }}: {{ s.name }}"><span class="media-plat-icon text-lv">{% icon "rss", "size-4" %}</span>{{ "media.copy_rss" | t(lang) }}</button></li>{% endif %}
            </ul>
          </div>
        </div>
      </article>
      {% endfor %}
    </div>
  </section>

  {#- ------------------------------------------------------------ episode list -#}
  <section id="episodes" class="listen-episodes" aria-labelledby="episodes-title">
    {%- set epSub -%}{{ "media.episodes_sub" | t(lang) }}{% if lang == "es" and not langs.es %}<span class="mt-2 flex items-start gap-1.5 text-sm">{% icon "languages", "mt-0.5 size-4 shrink-0 text-lv" %}{{ "media.english_audio_note" | t(lang) }}</span>{% endif %}{%- endset %}
    {{ ui.sectionHead("media.all_episodes" | t(lang), epSub, "", "", "list-music", { eyebrow: "media.episodes_eyebrow" | t(lang), tone: "text-grape", id: "episodes-title", lang: lang }) }}

    {#- Continue listening (from this device's history) -#}
    <div class="card mb-5 flex items-center gap-4 border-lv/40 bg-lv-soft/50 p-3 sm:p-4" x-show="resumeEp && !$store.audio.cur" x-cloak>
      <img :src="resumeEp && art(resumeEp)" alt="" width="56" height="56" class="size-14 shrink-0 rounded-xl object-cover" x-show="resumeEp && art(resumeEp)" referrerpolicy="no-referrer" @load="$el.style.visibility = ''" @error="$el.style.visibility = 'hidden'">
      <div class="min-w-0 flex-1">
        <p class="eyebrow text-lv">{{ "media.continue_listening" | t(lang) }}</p>
        <p class="truncate font-display font-semibold" x-text="resumeEp && resumeEp.t"></p>
        <p class="text-xs text-muted" x-text="resumeEp && leftText(resumeEp)"></p>
      </div>
      <button type="button" class="btn-lv shrink-0" @click="$store.audio.toggleEp(resumeEp)">{% icon "play", "size-4" %}<span class="hidden sm:inline">{{ "media.resume" | t(lang) }}</span><span class="sr-only sm:hidden">{{ "media.resume" | t(lang) }}</span></button>
    </div>

    {#- Toolbar: search, sort, show / season / language chips. Chip counts use text-faint
        (≥ 5.3:1 in both themes) and the chip's own colour when pressed — not opacity,
        which took them below WCAG AA contrast. -#}
    <div class="card mb-4 flex flex-col gap-3 p-3 sm:p-4">
      <div class="flex flex-col gap-3 sm:flex-row">
        <label class="relative block flex-1">
          <span class="sr-only">{{ "media.search_episodes" | t(lang) }}</span>
          <span class="pointer-events-none absolute left-3.5 top-1/2 -translate-y-1/2 text-faint">{% icon "search", "size-5" %}</span>
          <input type="search" class="input pl-11" x-model.debounce.200ms="q" placeholder="{{ 'media.search_episodes_ph' | t(lang) }}" autocomplete="off" enterkeyhint="search">
        </label>
        <label class="flex items-center gap-2 text-sm text-muted sm:w-auto">
          <span class="shrink-0">{% icon "arrow-down-wide-narrow", "size-5" %}<span class="sr-only">{{ "media.sort" | t(lang) }}</span></span>
          <select class="input w-full py-0 sm:w-44" x-model="sort">
            <option value="new">{{ "media.sort_new" | t(lang) }}</option>
            <option value="old">{{ "media.sort_old" | t(lang) }}</option>
          </select>
        </label>
      </div>
      {% if multi %}
      <div class="flex min-w-0 items-center gap-2" role="group" aria-label="{{ 'media.filter_show' | t(lang) }}">
        <span class="hidden w-20 shrink-0 text-xs font-semibold tracking-wider text-faint uppercase md:inline">{{ "media.filter_show" | t(lang) }}</span>
        <div class="chip-row flex-1">
          <button type="button" class="chip" :aria-pressed="(show === '').toString()" aria-pressed="true" @click="setShow('')">{{ "common.all" | t(lang) }}</button>
          {% for s in shows %}
          {%- set showIcon = "users" if s.weekly else "headphones" %}
          <button type="button" class="chip" :aria-pressed="(show === '{{ s.key }}').toString()" aria-pressed="false" @click="setShow(show === '{{ s.key }}' ? '' : '{{ s.key }}')">{% icon showIcon, "size-4" %}{{ s.name }} <span class="text-faint tabular-nums in-aria-pressed:text-current">{{ s.count }}</span></button>
          {% endfor %}
        </div>
      </div>
      {% endif %}
      {% for s in shows %}{% if s.seasons.length > 1 %}
      <div class="flex min-w-0 items-center gap-2" role="group" aria-label="{{ 'media.filter_season' | t(lang) }}{% if multi %} · {{ s.name }}{% endif %}"{% if multi %} x-show="show === '{{ s.key }}'" x-cloak{% endif %}>
        <span class="hidden w-20 shrink-0 text-xs font-semibold tracking-wider text-faint uppercase md:inline">{{ "media.filter_season" | t(lang) }}</span>
        <div class="chip-row flex-1">
          <button type="button" class="chip" :aria-pressed="(season === '').toString()" aria-pressed="true" @click="season = ''">{{ "common.all" | t(lang) }}</button>
          {% for se in s.seasons %}
          <button type="button" class="chip" :aria-pressed="(season === '{{ se.key }}').toString()" aria-pressed="false" @click="season = season === '{{ se.key }}' ? '' : '{{ se.key }}'">{{ "media.season_n" | t(lang, { n: se.key }) }} <span class="text-faint tabular-nums in-aria-pressed:text-current">{{ se.count }}</span></button>
          {% endfor %}
        </div>
      </div>
      {% endif %}{% endfor %}
      {% if langs.en and langs.es %}
      <div class="flex min-w-0 items-center gap-2" role="group" aria-label="{{ 'media.filter_lang' | t(lang) }}">
        <span class="hidden w-20 shrink-0 text-xs font-semibold tracking-wider text-faint uppercase md:inline">{{ "media.filter_lang" | t(lang) }}</span>
        <div class="chip-row flex-1">
          <button type="button" class="chip" :aria-pressed="(elang === '').toString()" aria-pressed="true" @click="elang = ''">{{ "common.all" | t(lang) }}</button>
          <button type="button" class="chip" :aria-pressed="(elang === 'en').toString()" aria-pressed="false" @click="elang = elang === 'en' ? '' : 'en'" lang="en">{{ "media.lang_en" | t(lang) }} <span class="text-faint tabular-nums in-aria-pressed:text-current">{{ langs.en }}</span></button>
          <button type="button" class="chip" :aria-pressed="(elang === 'es').toString()" aria-pressed="false" @click="elang = elang === 'es' ? '' : 'es'" lang="es">{{ "media.lang_es" | t(lang) }} <span class="text-faint tabular-nums in-aria-pressed:text-current">{{ langs.es }}</span></button>
        </div>
      </div>
      {% endif %}
    </div>

    <div class="mb-3 flex min-h-6 flex-wrap items-center justify-between gap-2 text-sm text-muted">
      <p aria-live="polite" aria-atomic="true"><span x-text="statusText">{{ "media.showing" | t(lang, { n: ssr.length, total: eps.length }) }}</span><span x-show="loading" x-cloak x-text="(statusText ? ' · ' : '') + T.loading"> · {{ "common.loading" | t(lang) }}</span></p>
      <button type="button" class="-my-1.5 inline-flex min-h-11 items-center gap-1 font-semibold text-gv hover:underline" x-show="filtering" x-cloak @click="clear()">{% icon "x", "size-4" %}{{ "media.clear_filters" | t(lang) }}</button>
    </div>
    <p class="mb-3 rounded-xl bg-lv-soft px-4 py-2 text-sm text-lv-strong" x-show="failed" x-cloak role="status">{{ "media.index_error" | t(lang) }} <button type="button" class="font-semibold underline" @click="retryIndex()">{{ "media.retry" | t(lang) }}</button></p>

    {#- Server-rendered newest episodes (hidden once the client list takes over). With a
        filter set (/listen/?show=wo) only the matching ones show until the full list is here. -#}
    <ol class="card ep-list" x-show="!client && kept">
      {% for e in ssr %}{{ epRow(e, lang, loop.index0, true) }}{% endfor %}
    </ol>
    <p class="card flex min-h-24 items-center justify-center gap-2 p-6 text-sm text-muted" x-show="!client && !kept" x-cloak>{% icon "loader-circle", "size-5 animate-spin" %}{{ "common.loading" | t(lang) }}</p>
    {#- Client-rendered list (filters / search / load more) -#}
    <template x-if="client">
      <ol class="card ep-list" x-show="visible.length">
        <template x-for="ep in visible" :key="ep.id">{{ epRow(null, lang, 0, false) }}</template>
      </ol>
    </template>
    <div x-show="client && !filtered.length" x-cloak>
      {{ ui.emptyState("search-x", "media.no_match_eps" | t(lang), "media.no_match_help" | t(lang)) }}
      <p class="mt-3 text-center"><button type="button" class="btn-secondary btn-sm" @click="clear()">{{ "media.clear_filters" | t(lang) }}</button></p>
    </div>

    <div class="mt-6 flex flex-col items-center gap-3" x-ref="more">
      {% if eps.length > ssr.length %}
      <button type="button" class="btn-secondary" x-show="hasMore" @click="more()" :aria-busy="loading.toString()">
        <span x-show="loading" x-cloak>{% icon "loader-circle", "size-4 animate-spin" %}</span>
        <span x-show="!loading">{% icon "arrow-down", "size-4" %}</span>
        {{ "media.load_more" | t(lang) }}
      </button>
      {% endif %}
      {% if site.links.podcasts_page %}<a class="link inline-flex min-h-11 items-center text-sm" href="{{ site.links.podcasts_page }}" target="_blank" rel="noopener">{{ "media.full_archive" | t(lang) }}</a>{% endif %}
      {#- one-line pointer: the story lines live on /contribute/#record -#}
      <a class="link inline-flex min-h-11 items-center gap-1.5 text-sm" href="{{ '/contribute/' | lurl(lang) }}#record">{% icon "mic", "size-4 shrink-0" %}{{ "media.record_own" | t(lang) }}</a>
    </div>
  </section>

  </div>{#- /.listen-layout -#}

  {#- ------------------------------------------------------------ sticky mini-player
      media.js measures .media-mini-card and sets html.has-player + --player-h
      (the language banner and the page padding use them). -#}
  <div class="media-mini" x-show="$store.audio.mini" x-cloak
       x-transition:enter="transition duration-300 ease-out" x-transition:enter-start="translate-y-full opacity-0"
       x-transition:leave="transition duration-200 ease-in" x-transition:leave-end="translate-y-full opacity-0">
    <div class="media-mini-card" role="region" aria-label="{{ 'media.player_label' | t(lang) }}"
         x-data="miniPlayer" @keydown="$store.audio.onKey($event, ep)">
      <input type="range" class="media-range media-range-mini" min="0" step="1"
             :max="Math.max(1, Math.round($store.audio.durFor(ep)))" :value="Math.round($store.audio.timeFor(ep))"
             :style="'--pct:' + $store.audio.pctLive(ep) + '%'"
             @input="$store.audio.scrub(ep, $event.target.value)" @change="$store.audio.seekTo(ep, $event.target.value)"
             aria-label="{{ 'media.seek' | t(lang) }}" :aria-valuetext="valueText(ep)">
      <div class="flex items-center gap-2 px-2.5 pt-1 pb-2.5 sm:gap-3 sm:px-3.5">
        <img :src="art(ep)" alt="" width="48" height="48" class="size-11 shrink-0 rounded-lg object-cover sm:size-12" x-show="art(ep)" referrerpolicy="no-referrer" @load="$el.style.visibility = ''" @error="$el.style.visibility = 'hidden'">
        <div class="min-w-0 flex-1">
          <p class="media-mini-title truncate text-sm font-semibold text-ink" x-text="ep.t" :title="ep.t"></p>
          <p class="truncate text-xs tabular-nums text-muted">
            <span x-show="$store.audio.error" class="text-danger">{{ "media.retry" | t(lang) }}?</span>
            <span x-show="!$store.audio.error"><span x-text="clock($store.audio.time)"></span> / <span x-text="clock($store.audio.durFor(ep))"></span><span class="hidden sm:inline" x-text="showName(ep) ? ' · ' + showName(ep) : ''"></span></span>
          </p>
        </div>
        <button type="button" class="media-pbtn media-skip hidden min-[400px]:grid" @click="$store.audio.skip(-15)" aria-label="{{ 'media.back_15' | t(lang) }}" title="{{ 'media.back_15' | t(lang) }}">{% icon "rotate-ccw", "size-5" %}<span>15</span></button>
        <button type="button" class="media-play media-play-sm" @click="$store.audio.error ? $store.audio.retry() : $store.audio.toggle()" :aria-label="playLabel(ep)">
          {{ ppIcons("$store.audio.playing", "$store.audio.loading", "size-5") }}
        </button>
        <button type="button" class="media-pbtn media-skip hidden min-[400px]:grid" @click="$store.audio.skip(30)" aria-label="{{ 'media.fwd_30' | t(lang) }}" title="{{ 'media.fwd_30' | t(lang) }}">{% icon "rotate-cw", "size-5" %}<span>30</span></button>
        <button type="button" class="media-rate hidden md:inline-flex" @click="$store.audio.cycleRate()" :aria-label="T.speed + ': ' + $store.audio.rate + '×'" title="{{ 'media.speed' | t(lang) }}"><span x-text="$store.audio.rate + '×'"></span></button>
        {{ pbtn("x", "media.close_player" | t(lang), "$store.audio.dismiss()", "text-faint") }}
      </div>
    </div>
  </div>
</div>

{#- ------------------------------------------------------------ tell your group -#}
{%- set announcement = "media.listen_announcement" | t(lang, { shows: shows | mediaListNames(lang), url: page.url | siteUrl(site) }) -%}
{{ media.shareBlock(lang, "listen-share-title", "media.share_listen_text" | t(lang), announcement, page.url | siteUrl(site), "media.listen_share_title" | t(lang), "media.listen_sub" | t(lang)) }}

{% else %}
{#- Nothing synced yet (first run / feed outage): still useful — the shows' own links. -#}
<section class="container-page page-start">
  {{ ui.emptyState("headphones", "media.empty_eps_title" | t(lang), "media.empty_eps_text" | t(lang), site.links.podcasts_page, "media.web" | t(lang)) }}
  {% if cfgShows.length %}
  <ul class="mx-auto mt-8 grid max-w-4xl grid-cols-1 gap-4 {{ 'md:grid-cols-2' if cfgShows.length > 1 }}">
    {% for s in cfgShows %}
    <li class="card p-5">
      <p class="font-display text-lg font-semibold text-ink">{{ s.name }}</p>
      <p class="mt-3 text-xs font-semibold tracking-wider text-faint uppercase">{{ "media.follow_in" | t(lang) }}</p>
      <div class="mt-2 flex flex-wrap gap-2">
        {% if s.apple %}<a class="media-plat" href="{{ s.apple }}" target="_blank" rel="noopener"><span class="media-plat-icon text-grape">{% icon "podcast", "size-4" %}</span>{{ "media.apple" | t(lang) }}</a>{% endif %}
        {% if s.spotify %}<a class="media-plat" href="{{ s.spotify }}" target="_blank" rel="noopener"><span class="media-plat-icon text-vine">{% icon "spotify", "size-4" %}</span>{{ "media.spotify" | t(lang) }}</a>{% endif %}
        {% if s.amazon %}<a class="media-plat" href="{{ s.amazon }}" target="_blank" rel="noopener"><span class="media-plat-icon text-gv">{% icon "music", "size-4" %}</span>{{ "media.amazon" | t(lang) }}</a>{% endif %}
        {% if s.web %}<a class="media-plat" href="{{ s.web }}" target="_blank" rel="noopener"><span class="media-plat-icon text-lv">{% icon "grapes", "size-4" %}</span>{{ "media.web_short" | t(lang) }}</a>{% endif %}
      </div>
    </li>
    {% endfor %}
  </ul>
  {% endif %}
</section>
{% endif %}
