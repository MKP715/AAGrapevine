---
pagination: { data: languages, size: 1, alias: lang }
permalink: "{{ '/' if lang == 'en' else '/es/' }}read/index.html"
layout: layouts/base.njk
pageKey: read
titleKey: read.title
descKey: read.meta_desc
pageScripts: ["/assets/js/read.js"]
---
{#- READ — the two magazines. Current issue of each (newest issue key: cover,
    theme, description and table of contents), then the archive of earlier
    issues collected by the daily sync. Data: db.articles (items + issues, see
    docs/DATA_SCHEMA.md §5). View models come from eleventy/filters/read.js.
    Wide screens: the two current issues sit side by side from 1440px (90rem) and
    the archive becomes two columns; the issue cards lay themselves out by their
    OWN width (container queries, @container / @4xl: …), not the screen's. -#}
{% import "macros/ui.njk" as ui with context %}
{%- set SSR_ARCHIVE = 8 -%}
{%- set spot = db.spotlight | readSpotlight -%}
{%- set gvIssues = db.articles | readIssues("gv") -%}
{%- set lvIssues = db.articles | readIssues("lv") -%}
{%- set archive = db.articles | readArchive -%}
{%- set since = db.articles | readArchiveSince -%}
{%- set stories = db.articles | readItems | where("kind", "article") -%}
{%- set gvCur = (gvIssues[0] | readIssueView(lang)) if gvIssues.length else null -%}
{%- set lvCur = (lvIssues[0] | readIssueView(lang)) if lvIssues.length else null -%}
{%- set order = ["lv", "gv"] if lang == "es" else ["gv", "lv"] -%}
{%- set remaining = archive.length - SSR_ARCHIVE -%}
{%- if remaining < 0 %}{% set remaining = 0 %}{% endif -%}
{%- set gvHub = site.sources.grapevine.base + site.sources.grapevine.magazine_hub -%}
{%- set lvHub = site.sources.lavina.base + site.sources.lavina.magazine_hub -%}

{#- One story in a table of contents -#}
{% macro articleRow(a, lang, compact=false, showSection=false, showNew=true, cls="") %}
<li class="read-article{{ ' ' + cls if cls }}">
  <a href="{{ a.url }}" target="_blank" rel="noopener" class="group flex h-full flex-col gap-1 rounded-xl px-3 py-3 no-underline transition hover:bg-surface-2">
    {% if showSection and a.section %}<span class="text-[0.68rem] font-semibold uppercase tracking-[0.12em] {{ 'text-lv' if a.pub == 'lv' else 'text-gv' }}" lang="{{ a.sectionLang }}">{{ a.section }}</span>{% endif %}
    <span class="flex items-start justify-between gap-2">
      <span class="font-display {{ 'text-[0.98rem]' if compact else 'text-[1.05rem]' }} font-semibold leading-snug text-ink transition {{ 'group-hover:text-lv' if a.pub == 'lv' else 'group-hover:text-gv' }}" lang="{{ a.titleLang }}">{{ a.title }}</span>
      {% ricon "arrow-up-right", "mt-1 size-4 shrink-0 text-faint transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5" %}
    </span>
    {% if a.original %}<span class="flex items-center gap-1 text-xs text-muted"{% if a.machine %} title="{{ 'common.auto_translated' | t(lang) }} — {{ 'common.auto_translated_help' | t(lang) }}"{% endif %}>{% if a.machine %}{% ricon "languages", "size-3 shrink-0" %}<span class="sr-only">{{ "common.auto_translated" | t(lang) }}:</span>{% endif %}<span class="italic" lang="{{ a.origLang }}">{{ a.original }}</span></span>{% endif %}
    {% if a.summary and not compact %}<span class="line-clamp-2 text-sm leading-relaxed text-muted" lang="{{ a.summaryLang }}">{{ a.summary }}</span>{% endif %}
    {%- set mtInMeta = a.machine and not a.original -%}
    {% if a.author or (a.isNew and showNew) or a.free != null or mtInMeta %}
    <span class="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted">
      {% if a.isNew and showNew %}<span class="badge-new">{{ "common.new" | t(lang) }}</span>{% endif %}
      {% if a.author %}<span>{{ "common.by" | t(lang, {name: a.author}) }}{% if a.authorLocation and not compact %}<span class="text-faint"> · {{ a.authorLocation }}</span>{% endif %}</span>{% endif %}
      {% if a.free == true %}<span class="badge-vine">{% ricon "lock-open", "size-3" %} {{ "read.free_story" | t(lang) }}</span>
      {% elif a.free == false %}<span class="read-sub-badge" title="{{ 'read.subscriber_help' | t(lang) }}">{% ricon "key-round", "size-3" %} {{ "read.subscriber_story" | t(lang) }}</span>{% endif %}
      {% if mtInMeta %}<span class="auto-note" title="{{ 'common.auto_translated' | t(lang) }} — {{ 'common.auto_translated_help' | t(lang) }}">{% ricon "languages", "size-3" %}<span class="sr-only">{{ "common.auto_translated" | t(lang) }}</span></span>{% endif %}
    </span>
    {% endif %}
    <span class="sr-only">({{ "common.external" | t(lang) }})</span>
  </a>
</li>
{% endmacro %}

{#- Current-issue feature: the real cover (or drawn art) + theme + table of contents.
    Laid out by the card's own width: ≥ 56rem (a full-width card) the cover panel is a column
    on the left; narrower (phones, tablets, or side by side with the other magazine from
    1440px) the cover panel sits on top and the stories run in two columns below it. -#}
{% macro issueFeature(v, lang, hub) %}
{%- set isLv = v.pub == "lv" -%}
{%- set pubName = "La Viña" if isLv else "Grapevine" -%}
{%- set issueUrl = v.url or hub -%}
{%- set site_ = issueUrl | hostname -%}
<article id="{{ v.pub }}-current" class="read-issue card @container scroll-mt-24 overflow-hidden" data-pub="{{ v.pub }}" x-show="show('{{ v.pub }}')" aria-labelledby="{{ v.pub }}-current-title">
  <div class="grid grid-cols-1 @4xl:grid-cols-[21rem_minmax(0,1fr)] @6xl:grid-cols-[23rem_minmax(0,1fr)]">
    <header class="read-cover {{ 'read-cover--lv' if isLv else 'read-cover--gv' }}{{ ' has-cover' if v.cover }} relative isolate overflow-hidden p-6 text-white @lg:p-8">
      {% if v.cover %}<img class="read-cover-blur" src="{{ v.cover }}" alt="" aria-hidden="true">
      {% else %}
      <svg class="read-cover-art" viewBox="0 0 200 240" fill="none" aria-hidden="true">
        <path d="M100 10 C 96 40, 120 52, 110 78" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
        <path d="M112 40 c 26 -22 58 -10 64 10 c -26 -4 -44 8 -64 -10z" fill="currentColor" opacity=".7"/>
        <g fill="currentColor"><circle cx="82" cy="96" r="17"/><circle cx="116" cy="96" r="17"/><circle cx="150" cy="100" r="15"/><circle cx="66" cy="126" r="17"/><circle cx="100" cy="126" r="17"/><circle cx="134" cy="128" r="17"/><circle cx="82" cy="156" r="17"/><circle cx="116" cy="156" r="17"/><circle cx="100" cy="186" r="17"/></g>
      </svg>
      {% endif %}
      <p class="flex items-center gap-2 text-sm font-semibold tracking-wide text-white/90">{% icon "grapes", "size-5" %} {{ "La Viña" if isLv else "AA Grapevine" }}
        <span class="rounded-full bg-white/15 px-2 py-0.5 text-[0.65rem] font-bold uppercase tracking-wider ring-1 ring-white/20" title="{{ ('lang.es' if isLv else 'lang.en') | t(lang) }}">{{ "ES" if isLv else "EN" }}</span></p>

      <div class="mt-6 flex items-start gap-5 @lg:gap-6 @4xl:flex-col @4xl:items-stretch @4xl:gap-0">
        {% if v.cover %}
        <a class="read-cover-frame block w-[7.25rem] shrink-0 @lg:w-40 @4xl:mx-auto @4xl:w-full @4xl:max-w-[14rem]" href="{{ issueUrl }}" target="_blank" rel="noopener">
          <img src="{{ v.cover }}" width="480" height="686" alt="{{ 'read.cover_alt' | t(lang, {pub: pubName, issue: (v.label | readInSentence(lang, v.pub))}) }}" class="block aspect-[7/10] w-full rounded-[0.35rem] object-cover">
          <span class="sr-only">({{ "common.external" | t(lang) }})</span>
        </a>
        {% endif %}
        <div class="min-w-0 {{ '@4xl:mt-7' if v.cover else 'mt-2' }}">
          <p class="flex flex-wrap items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-white/85">{{ "read.current_issue" | t(lang) }}
            {% if v.isNewIssue %}<span class="badge-new normal-case tracking-normal">{{ "read.new_issue" | t(lang) }}</span>{% endif %}</p>
          <h3 id="{{ v.pub }}-current-title" class="mt-1 font-display text-[1.6rem] font-semibold leading-tight @lg:text-3xl {{ '@4xl:text-[2rem]' if v.cover else '@4xl:text-[2.35rem]' }}">{{ v.label or ("read.undated" | t(lang)) }}</h3>
          {% if v.topic %}<p class="mt-2 text-white/85"><span class="text-sm">{{ "read.theme" | t(lang) }}</span> <strong class="font-display text-lg font-semibold italic" lang="{{ v.topicLang }}">{{ v.topic }}</strong>{% if v.topicMachine %} <span class="sr-only">({{ "common.auto_translated" | t(lang) }})</span>{% endif %}</p>{% endif %}
          <p class="mt-1.5 text-sm text-white/85">{{ ("read.freq_lv" if isLv else "read.freq_gv") | t(lang) }}</p>
        </div>
      </div>

      {% if v.count %}
      <dl class="mt-6 flex flex-wrap gap-x-7 gap-y-3">
        <div><dt class="text-[0.7rem] font-semibold uppercase tracking-wider text-white/80">{{ "read.stat_stories" | t(lang) }}</dt><dd class="font-display text-3xl font-semibold">{{ v.count }}</dd></div>
        {% if v.featuredCount and v.featuredCount < v.count %}<div><dt class="text-[0.7rem] font-semibold uppercase tracking-wider text-white/80">{{ "read.stat_featured" | t(lang) }}</dt><dd class="font-display text-3xl font-semibold">{{ v.featuredCount }}</dd></div>{% endif %}
        {% if v.newCount and not v.isNewIssue %}<div><dt class="text-[0.7rem] font-semibold uppercase tracking-wider text-white/80">{{ "read.stat_new" | t(lang) }}</dt><dd class="font-display text-3xl font-semibold">{{ v.newCount }}</dd></div>{% endif %}
        {% if v.freeCount %}<div><dt class="text-[0.7rem] font-semibold uppercase tracking-wider text-white/80">{{ "read.stat_free" | t(lang) }}</dt><dd class="font-display text-3xl font-semibold">{{ v.freeCount }}</dd></div>{% endif %}
      </dl>
      {% endif %}
      <div class="mt-6 flex flex-wrap gap-2">
        <a class="btn-light" href="{{ issueUrl }}" target="_blank" rel="noopener">{% icon "book-open", "size-4" %} {{ "read.read_on" | t(lang, {site: site_}) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a>
        <a class="btn-on-dark" href="{{ '/subscribe/' | lurl(lang) }}">{% icon "mail-open", "size-4" %} {{ "read.subscribe" | t(lang) }}</a>
      </div>
    </header>

    <div class="p-3 sm:p-5 lg:p-6">
      {% if v.description %}
      <div class="read-blurb mx-3 mt-2 mb-4 {{ 'read-accent-lv' if isLv else 'read-accent-gv' }}">
        <p class="line-clamp-4 leading-relaxed text-ink" lang="{{ v.descriptionLang }}">{{ v.description }}</p>
        {% if v.descriptionMachine %}<p class="auto-note mt-1.5" title="{{ 'common.auto_translated_help' | t(lang) }}">{% ricon "languages", "size-3" %} {{ "common.auto_translated" | t(lang) }}</p>{% endif %}
      </div>
      {% endif %}
      {% if v.count %}
      {#- Theme-section stories first under one heading, then the rest of the issue.
          About 10 stories show at first (6 on phones — see .read-toc in read.css); the rest open on demand. -#}
      {%- set SHOW = 10 -%}
      {%- set nOthers = SHOW - v.featured.length -%}
      {%- if nOthers < 2 %}{% set nOthers = 2 %}{% endif -%}
      {%- set showNew = not v.isNewIssue -%}
      <div class="read-toc">
        {% if v.machineCount %}<p class="auto-note px-3 pt-1">{% ricon "languages", "size-3" %} {{ ("read.mt_note_es" if isLv else "read.mt_note_en") | t(lang) }}</p>{% endif %}
        {% if v.featured.length %}
        <h4 class="read-toc-head {{ 'text-lv' if isLv else 'text-gv' }}">{% icon "sparkles", "size-3.5" %} <span lang="{{ v.featuredSectionLang }}">{{ v.featuredSection or ("read.special_section" | t(lang)) }}</span>{% if v.topic %}<span class="text-muted"> · <span lang="{{ v.topicLang }}">{{ v.topic }}</span></span>{% endif %}</h4>
        <ul class="grid grid-cols-1 gap-x-3 @lg:grid-cols-2">
          {% for a in v.featured %}{{ articleRow(a, lang, false, false, showNew, "read-sm-extra" if loop.index > 6 else "") }}{% endfor %}
        </ul>
        {% endif %}
        {% if v.others.length %}
        <h4 class="read-toc-head text-muted{{ ' mt-3' if v.featured.length }}{{ ' read-sm-extra' if v.featured.length >= 6 }}">{{ ("read.also_in_issue" if v.featured.length else "read.in_this_issue") | t(lang) }}</h4>
        <ul class="grid grid-cols-1 gap-x-3 @lg:grid-cols-2">
          {% for a in v.others | limit(nOthers) %}{{ articleRow(a, lang, false, true, showNew, "read-sm-extra" if (v.featured.length + loop.index) > 6 else "") }}{% endfor %}
        </ul>
        {% endif %}
        {% if v.others.length > nOthers or v.count > 6 %}
        <details class="read-more group/more mt-1{{ ' sm:hidden' if v.others.length <= nOthers }}">
          <summary class="btn-ghost btn-sm mx-3 cursor-pointer {{ 'text-lv' if isLv else 'text-gv' }}">
            <span class="group-open/more:hidden">{{ "read.show_all" | t(lang, {n: v.count}) }}</span>
            <span class="hidden group-open/more:inline">{{ "common.show_less" | t(lang) }}</span>
            {% icon "chevron-down", "size-4 transition group-open/more:rotate-180" %}
          </summary>
          <ul class="grid grid-cols-1 gap-x-3 @lg:grid-cols-2">
            {% for a in v.others | offset(nOthers) %}{{ articleRow(a, lang, false, true, showNew) }}{% endfor %}
          </ul>
        </details>
        {% endif %}
      </div>
      {% else %}
      {#- Issue page found (cover/theme) but its stories aren't listed yet -#}
      <div class="empty-state m-3">
        <span class="mx-auto mb-3 grid size-12 place-items-center rounded-full bg-surface-2 {{ 'text-lv' if isLv else 'text-gv' }}">{% icon "list", "size-6" %}</span>
        <p class="font-semibold text-ink">{{ "read.toc_pending" | t(lang) }}</p>
        <p class="mx-auto mt-1 max-w-md text-sm">{{ "read.toc_pending_text" | t(lang) }}</p>
        <a class="btn-secondary btn-sm mt-4" href="{{ issueUrl }}" target="_blank" rel="noopener">{{ "read.read_on" | t(lang, {site: site_}) }}</a>
      </div>
      {% endif %}
    </div>
  </div>
</article>
{% endmacro %}

{#- A publication with no synced issue yet -#}
{% macro missingIssue(pub, lang, hub) %}
<div class="card card-pad flex flex-col items-start gap-3 sm:flex-row sm:items-center" data-pub="{{ pub }}" x-show="show('{{ pub }}')">
  <span class="grid size-12 shrink-0 place-items-center rounded-2xl {{ 'bg-lv-soft text-lv' if pub == 'lv' else 'bg-gv-soft text-gv' }}">{% icon "grapes", "size-6" %}</span>
  <div class="flex-1">
    <p class="font-display text-lg font-semibold">{{ ("read.missing_lv" if pub == "lv" else "read.missing_gv") | t(lang) }}</p>
    <p class="text-sm text-muted">{{ "read.missing_text" | t(lang) }}</p>
  </div>
  <a class="btn-secondary btn-sm" href="{{ hub }}" target="_blank" rel="noopener">{{ "read.read_on" | t(lang, {site: hub | hostname}) }} {% ricon "arrow-up-right", "size-4" %}</a>
</div>
{% endmacro %}

{#- Small cover thumbnail for an archive row -#}
{% macro miniCover(v) %}
{% if v.cover %}<img src="{{ v.cover }}" width="48" height="69" alt="" loading="lazy" decoding="async" class="read-mini-cover">
{% else %}<span class="read-past-bar {{ 'bg-lv' if v.pub == 'lv' else 'bg-gv' }}" aria-hidden="true"></span>{% endif %}
{% endmacro %}

{#- The shared hero (same height on every page). Its buttons are the standard 44px / 14px size
    at every width, like every other page; "read-hero" (read.css) keeps phone heroes within
    24–28rem: both buttons on one row (no icon, a little less padding, like the home page) and
    no eyebrow below 360px. Phones get no stats. The "updates daily" note lives by the
    Current issues heading. -#}
{% call ui.pageHero(lang, "read.title" | t(lang), "read.subtitle" | t(lang), "book-open", "read.eyebrow" | t(lang), { class: "read-hero" }) %}
  <div class="hero-actions">
    {% for p in order %}
    {%- set cur = lvCur if p == "lv" else gvCur -%}
    {%- set hub = lvHub if p == "lv" else gvHub -%}
    {#- Jump to the feature when it exists; otherwise go straight to the official magazine. -#}
    <a class="{{ 'btn-light' if loop.first else 'btn-on-dark' }}" href="{{ ('#' + p + '-current') if cur else hub }}"{% if not cur %} target="_blank" rel="noopener"{% endif %}>{% icon "grapes", "size-4" %} {{ ("read.jump_lv" if p == "lv" else "read.jump_gv") | t(lang) }}{% if not cur %}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span>{% endif %}</a>
    {% endfor %}
  </div>
  {% if stories.length %}
  <div class="max-sm:hidden">{{ ui.heroStats([
    { value: stories.length, label: "read.hero_stories" | t(lang) },
    { value: gvIssues.length + lvIssues.length, label: "read.hero_issues" | t(lang) }
  ]) }}</div>
  {% endif %}
{% endcall %}

{#- Link card to the /published/ page — writers from our Area (and all of Texas) in the magazines.
    Lays itself out by its own width: stacked in a column, in a row when it spans the page. -#}
{% macro spotCard(sp, lang, variant="read") %}
{#- The page is built once a day: read.js (recountSpot) recounts the "last N days" window with
    the visitor's own date — the same rule as the home page and /published/ — using the dates
    below (data-dates: one per writer counted; data-date: a writer's newest story), and swaps
    the text / numbers / list that no longer apply. Writers can only leave the window. -#}
{%- set hasTexas = sp and sp.texas.writers > 0 -%}
{%- set hasArea = hasTexas and sp.area.writers > 0 -%}
<article class="read-spot card card-link group @container relative flex h-full flex-col overflow-hidden" aria-labelledby="spot-title"{% if hasTexas %} data-spot-days="{{ sp.days }}"{% endif %}>
  <div class="grid flex-1 content-start gap-5 p-6 sm:p-7 @4xl:grid-cols-[minmax(0,1.2fr)_auto] @4xl:items-center @4xl:gap-x-10 @6xl:grid-cols-[minmax(0,1.2fr)_auto_minmax(0,1fr)]">
    <div class="min-w-0">
      <p class="eyebrow flex items-center gap-2.5 text-vine"><span class="grid size-9 shrink-0 place-items-center rounded-xl bg-vine-soft">{% icon "award", "size-5" %}</span>{{ "read.spot.eyebrow" | t(lang) }}</p>
      <h2 id="spot-title" class="mt-3 font-display text-2xl font-semibold leading-tight text-ink"><a href="{{ '/published/' | lurl(lang) }}" class="no-underline after:absolute after:inset-0 after:content-[''] group-hover:text-gv">{{ "read.spot.title" | t(lang) }}</a></h2>
      <p class="mt-2 text-sm leading-relaxed text-muted">
        {%- if not hasTexas %}{{ "read.spot.nodata" | t(lang) }}
        {%- else -%}
        <span data-spot-text="main"{% if not hasArea %} hidden{% endif %}>{{ ("read.spot.text_contrib" if variant == "contrib" else "read.spot.text") | t(lang, {days: sp.days}) }}</span>
        <span data-spot-text="none_area"{% if hasArea %} hidden{% endif %}>{{ "read.spot.none_area" | t(lang, {days: sp.days}) }}</span>
        <span data-spot-text="nodata" hidden>{{ "read.spot.nodata" | t(lang) }}</span>
        {%- endif -%}
      </p>
    </div>
    {% if hasTexas %}
    <div data-spot-nums>
      <p class="text-xs font-semibold uppercase tracking-wider text-muted">{{ "read.spot.window" | t(lang, {days: sp.days}) }}</p>
      <dl class="mt-2 flex flex-wrap gap-x-8 gap-y-3">
        <div class="flex flex-col-reverse gap-1"{% if not hasArea %} hidden{% endif %}><dt class="text-sm text-muted" data-one="{{ 'read.spot.area_one' | t(lang) }}" data-many="{{ 'read.spot.area' | t(lang) }}">{{ ("read.spot.area_one" if sp.area.writers == 1 else "read.spot.area") | t(lang) }}</dt><dd class="read-num font-display text-4xl font-semibold leading-none text-vine" data-spot-n="area" data-dates="{{ sp.area.dates | join(' ') }}">{{ sp.area.writers }}</dd></div>
        <div class="flex flex-col-reverse gap-1"><dt class="text-sm text-muted" data-one="{{ 'read.spot.texas_one' | t(lang) }}" data-many="{{ 'read.spot.texas' | t(lang) }}">{{ ("read.spot.texas_one" if sp.texas.writers == 1 else "read.spot.texas") | t(lang) }}</dt><dd class="read-num font-display text-4xl font-semibold leading-none text-ink" data-spot-n="texas" data-dates="{{ sp.texas.dates | join(' ') }}">{{ sp.texas.writers }}</dd></div>
      </dl>
    </div>
    {% endif %}
    <div class="flex min-w-0 flex-col gap-4 @4xl:col-span-2 @6xl:col-span-1">
      {% if hasTexas %}
      {#- Newest writers from our Area; the Texas list stands in when no Area 65 writer is in the window -#}
      {% for scope in ["area", "texas"] %}{% if sp[scope].list.length %}
      <div data-spot-list="{{ scope }}"{% if (scope == "area") != hasArea %} hidden{% endif %}>
        <p class="text-xs font-semibold text-muted">{{ ("read.spot.newest_area" if scope == "area" else "read.spot.newest_texas") | t(lang) }}</p>
        <ul class="mt-1.5 flex flex-wrap gap-1.5">
          {% for w in sp[scope].list %}<li class="inline-flex max-w-full items-center gap-1.5 rounded-full border border-line bg-surface px-2.5 py-1 text-xs" data-date="{{ w.date }}"><span class="size-2 shrink-0 rounded-full {{ 'bg-lv' if w.pub == 'lv' else 'bg-gv' }}" aria-hidden="true"></span><span class="font-semibold text-ink">{{ w.name }}</span>{% if w.place[lang] %}<span class="min-w-0 truncate text-muted">· {{ w.place[lang] }}</span>{% endif %}<span class="sr-only"> ({{ "La Viña" if w.pub == "lv" else "Grapevine" }})</span></li>{% endfor %}
        </ul>
      </div>
      {% endif %}{% endfor %}
      {% endif %}
      <span class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-gv" aria-hidden="true">{{ "read.spot.cta" | t(lang) }} {% icon "arrow-right", "size-4 transition group-hover:translate-x-0.5" %}</span>
    </div>
  </div>
</article>
{% endmacro %}

{#- The small icons repeated on every story ({% ricon %}), drawn once for the whole page -#}
{% readSprite %}
<div x-data="readPage({ json:'{{ '/read-archive.json' | lurl(lang) }}', remaining: {{ remaining }}, chips: {{ 'true' if (gvCur and lvCur) else 'false' }}, counts: {{ archive | limit(SSR_ARCHIVE) | pluck('pub') | json }} })">

  {#- ---------- Our meeting in print + who from our Area got published ---------- -#}
  <section class="container-page page-overlap" aria-labelledby="print-title">
    <div class="grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,1.55fr)_minmax(0,1fr)] 2xl:grid-cols-[minmax(0,1.8fr)_minmax(0,1fr)]">
    <div class="read-print card @container relative flex flex-col justify-center overflow-hidden p-6 sm:p-8 xl:p-10">
      <div class="grid grid-cols-1 items-center gap-8 @3xl:grid-cols-[1.1fr_1fr]">
        <div>
          <p class="eyebrow">{{ "read.print_eyebrow" | t(lang) }}</p>
          <h2 id="print-title" class="h-section mt-2">{{ "read.print_title" | t(lang) }}</h2>
          <p class="lead mt-3">{{ "read.print_text" | t(lang) }}</p>
        </div>
        <ul class="grid grid-cols-1 gap-3 @2xl:grid-cols-3 @3xl:grid-cols-1">
          <li class="flex items-start gap-3"><span class="grid size-10 shrink-0 place-items-center rounded-xl bg-gv-soft text-gv">{% icon "users-round", "size-5" %}</span><span><strong class="block text-ink">{{ "read.print_p1_t" | t(lang) }}</strong><span class="text-sm text-muted">{{ "read.print_p1" | t(lang) }}</span></span></li>
          <li class="flex items-start gap-3"><span class="grid size-10 shrink-0 place-items-center rounded-xl bg-lv-soft text-lv">{% icon "calendar-range", "size-5" %}</span><span><strong class="block text-ink">{{ "read.print_p2_t" | t(lang) }}</strong><span class="text-sm text-muted">{{ "read.print_p2" | t(lang) }}</span></span></li>
          <li class="flex items-start gap-3"><span class="grid size-10 shrink-0 place-items-center rounded-xl bg-vine-soft text-vine">{% icon "refresh-cw", "size-5" %}</span><span><strong class="block text-ink">{{ "read.print_p3_t" | t(lang) }}</strong><span class="text-sm text-muted">{{ "read.print_p3" | t(lang) }}</span></span></li>
        </ul>
      </div>
    </div>
    {{ spotCard(spot, lang, "read") }}
    </div>
  </section>

  {#- ---------- Current issues (side by side from 1440px) ---------- -#}
  <section class="section container-page" aria-labelledby="current-title">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 id="current-title" class="h-section flex items-center gap-2.5"><span class="text-gv">{% icon "sparkles", "size-6" %}</span>{{ "read.current_title" | t(lang) }}</h2>
        <p class="mt-1.5 max-w-2xl text-muted">{{ "read.current_sub" | t(lang) }}</p>
        {% if gvCur or lvCur %}<p class="mt-2.5"><span class="badge-vine py-1!">{% icon "refresh-cw", "size-3" %} {{ "common.updates_daily" | t(lang) }}</span></p>{% endif %}
      </div>
      {% if gvCur and lvCur %}
      <div class="flex flex-wrap gap-2" role="group" aria-label="{{ 'read.filter_label' | t(lang) }}">
        <button type="button" class="chip" aria-pressed="true" :aria-pressed="(pub === 'all').toString()" @click="setPub('all')">{{ "common.all" | t(lang) }}</button>
        {% for p in order %}
        <button type="button" class="chip {{ 'read-chip-lv' if p == 'lv' }}" aria-pressed="false" :aria-pressed="(pub === '{{ p }}').toString()" @click="setPub('{{ p }}')">{% icon "grapes", "size-4" %} {{ "La Viña" if p == "lv" else "Grapevine" }}</button>
        {% endfor %}
      </div>
      {% endif %}
    </div>

    {% if gvCur or lvCur %}
    {#- is-single: one magazine filtered → it takes the full width (read.css) -#}
    <div class="read-issues" :class="{ 'is-single': pub !== 'all' }">
      {% for p in order %}
        {% if p == "gv" %}{% if gvCur %}{{ issueFeature(gvCur, lang, gvHub) }}{% else %}{{ missingIssue("gv", lang, gvHub) }}{% endif %}
        {% else %}{% if lvCur %}{{ issueFeature(lvCur, lang, lvHub) }}{% else %}{{ missingIssue("lv", lang, lvHub) }}{% endif %}{% endif %}
      {% endfor %}
    </div>
    {% else %}
      {{ ui.emptyState("book-open", "read.empty_title" | t(lang), "read.empty_text" | t(lang), site.links.gv_home, "read.read_on" | t(lang, {site: site.links.gv_home | hostname})) }}
      <p class="mt-3 text-center text-sm"><a class="link" href="{{ site.links.lv_home }}" target="_blank" rel="noopener">{{ "read.read_on" | t(lang, {site: site.links.lv_home | hostname}) }}</a></p>
    {% endif %}

    {#- Paywall note — kind and clear -#}
    <aside class="mt-8 flex flex-col gap-4 rounded-[var(--radius-card)] border border-line bg-surface-2 p-5 sm:flex-row sm:items-center sm:p-6" aria-label="{{ 'read.paywall_title' | t(lang) }}">
      <span class="grid size-11 shrink-0 place-items-center rounded-full bg-surface text-grape ring-1 ring-line">{% ricon "key-round", "size-5" %}</span>
      <div class="flex-1">
        <p class="font-semibold text-ink">{{ "read.paywall_title" | t(lang) }}</p>
        <p class="measure mt-1 text-sm leading-relaxed text-muted">{{ "read.paywall_text" | t(lang) }}</p>
      </div>
      <a class="btn-primary shrink-0" href="{{ '/subscribe/' | lurl(lang) }}">{{ "read.paywall_cta" | t(lang) }} {% icon "arrow-right", "size-4" %}</a>
    </aside>
  </section>

  {#- ---------- Archive ---------- -#}
  <section class="section container-page border-t border-line" aria-labelledby="archive-title">
    <div class="mb-6">
      <h2 id="archive-title" class="h-section flex items-center gap-2.5"><span class="text-gv">{% icon "archive", "size-6" %}</span>{{ "read.archive_title" | t(lang) }}</h2>
      <p class="mt-1.5 max-w-2xl text-muted">{{ "read.archive_sub" | t(lang) }}</p>
    </div>
    {% if archive.length %}
    <p class="sr-only" aria-live="polite" data-t1="{{ 'read.archive_count_one' | t(lang) }}" data-t="{{ 'read.archive_count' | t(lang) }}" x-text="visibleCount() === 1 ? $el.dataset.t1 : $el.dataset.t.replace('{n}', visibleCount())"></p>
    <div class="read-archive-list">
      {% for is in archive | limit(SSR_ARCHIVE) %}{% set v = is | readIssueView(lang) %}
      <details class="read-past card @container group/past" data-pub="{{ v.pub }}" x-show="show('{{ v.pub }}')">
        <summary class="flex min-h-16 cursor-pointer list-none flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3 sm:px-5">
          {{ miniCover(v) }}
          {% if v.pub == "lv" %}<span class="badge-lv">La Viña</span>{% else %}<span class="badge-gv">Grapevine</span>{% endif %}
          <span class="font-display text-lg font-semibold text-ink">{{ v.label or ("read.undated" | t(lang)) }}</span>
          {% if v.topic %}<span class="text-sm text-muted">· <span lang="{{ v.topicLang }}">{{ v.topic }}</span></span>{% endif %}
          <span class="ml-auto flex items-center gap-2 text-sm text-muted">{{ ("read.n_stories_one" if v.count == 1 else "read.n_stories") | t(lang, {n: v.count}) }} {% icon "chevron-down", "size-5 transition group-open/past:rotate-180" %}</span>
        </summary>
        <div class="border-t border-line p-2 sm:p-3">
          <ul class="grid grid-cols-1 gap-x-3 @xl:grid-cols-2 @5xl:grid-cols-3">
            {% for a in v.articles %}{{ articleRow(a, lang, true, false, false) }}{% endfor %}
          </ul>
          {%- set aHub = v.url or (lvHub if v.pub == 'lv' else gvHub) -%}
          <p class="px-3 pb-1 pt-2"><a class="link text-sm" href="{{ aHub }}" target="_blank" rel="noopener">{{ "read.read_on" | t(lang, {site: aHub | hostname}) }}</a></p>
        </div>
      </details>
      {% endfor %}

      {#- Older issues, loaded on demand from /read-archive.json -#}
      <template x-for="is in older" :key="is.id">
        <details class="read-past card @container group/past" x-show="show(is.pub)">
          <summary class="flex min-h-16 cursor-pointer list-none flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3 sm:px-5">
            <template x-if="is.c"><img :src="assetUrl(is.c)" width="48" height="69" alt="" loading="lazy" decoding="async" class="read-mini-cover"></template>
            <template x-if="!is.c"><span class="read-past-bar" :class="is.pub === 'lv' ? 'bg-lv' : 'bg-gv'" aria-hidden="true"></span></template>
            <span :class="is.pub === 'lv' ? 'badge-lv' : 'badge-gv'" x-text="is.pub === 'lv' ? 'La Viña' : 'Grapevine'"></span>
            <span class="font-display text-lg font-semibold text-ink" x-text="is.label"></span>
            <span class="text-sm text-muted" x-show="is.topic">· <span :lang="is.tl" x-text="is.topic"></span></span>
            <span class="ml-auto flex items-center gap-2 text-sm text-muted"><span data-t1="{{ 'read.n_stories_one' | t(lang) }}" data-t="{{ 'read.n_stories' | t(lang) }}" x-text="is.count === 1 ? $el.dataset.t1 : $el.dataset.t.replace('{n}', is.count)"></span> {% icon "chevron-down", "size-5 transition group-open/past:rotate-180" %}</span>
          </summary>
          <div class="border-t border-line p-2 sm:p-3">
            <ul class="grid grid-cols-1 gap-x-3 @xl:grid-cols-2 @5xl:grid-cols-3">
              <template x-for="a in is.items" :key="a.u">
                <li class="read-article">
                  <a :href="a.u" target="_blank" rel="noopener" class="group flex h-full flex-col gap-1 rounded-xl px-3 py-3 no-underline transition hover:bg-surface-2">
                    <span class="flex items-start justify-between gap-2">
                      <span class="font-display text-[0.98rem] font-semibold leading-snug text-ink" :lang="a.tl" x-text="a.t"></span>
                      {% ricon "arrow-up-right", "mt-1 size-4 shrink-0 text-faint" %}
                    </span>
                    <span class="flex items-center gap-1 text-xs text-muted" x-show="a.o" title="{{ 'common.auto_translated' | t(lang) }}"><span x-show="a.m">{% ricon "languages", "size-3 shrink-0" %}</span><span class="italic" :lang="a.ol" x-text="a.o"></span></span>
                    <span class="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs text-muted" x-show="a.a || a.f !== undefined">
                      <span x-show="a.a" data-t="{{ 'common.by' | t(lang) }}" x-text="$el.dataset.t.replace('{name}', a.a || '')"></span>
                      <span class="badge-vine" x-show="a.f === 1">{% ricon "lock-open", "size-3" %} {{ "read.free_story" | t(lang) }}</span>
                      <span class="read-sub-badge" x-show="a.f === 0" title="{{ 'read.subscriber_help' | t(lang) }}">{% ricon "key-round", "size-3" %} {{ "read.subscriber_story" | t(lang) }}</span>
                    </span>
                  </a>
                </li>
              </template>
            </ul>
            <p class="px-3 pb-1 pt-2"><a class="link text-sm" :href="is.u" target="_blank" rel="noopener" data-t="{{ 'read.read_on' | t(lang) }}" x-text="$el.dataset.t.replace('{site}', is.h)"></a></p>
          </div>
        </details>
      </template>
    </div>

    {% if archive.length > SSR_ARCHIVE %}
    <div class="mt-6 text-center" x-show="remaining > 0">
      <button type="button" class="btn-secondary" @click="loadOlder()" :aria-busy="loading.toString()">
        <span x-show="!loading">{% icon "history", "size-4" %} {{ ("read.load_older_one" if remaining == 1 else "read.load_older") | t(lang, {n: remaining}) }}</span>
        <span x-show="loading" x-cloak>{{ "common.loading" | t(lang) }}</span>
      </button>
      <p class="mt-2 text-sm text-danger" x-show="failed" x-cloak role="alert">{{ "read.load_failed" | t(lang) }}</p>
      <noscript><p class="mt-2 text-sm text-muted">{{ "read.noscript_older" | t(lang) }} <a class="link" href="{{ gvHub }}">{{ gvHub | hostname }}</a> · <a class="link" href="{{ lvHub }}">{{ lvHub | hostname }}</a></p></noscript>
    </div>
    {% endif %}
    {% else %}
    {#- No earlier issue saved yet: an intentional "the archive starts here" note -#}
    <div class="read-archive-start rounded-[var(--radius-card)] border border-dashed border-line bg-surface/60 p-6 sm:p-8">
      <div class="flex flex-col gap-5 sm:flex-row sm:items-center">
        <span class="grid size-14 shrink-0 place-items-center rounded-2xl bg-grape-soft text-grape">{% icon "library-big", "size-7" %}</span>
        <div class="min-w-0 flex-1">
          <p class="font-display text-xl font-semibold text-ink">{{ "read.archive_empty" | t(lang) }}</p>
          <p class="mt-1 max-w-2xl text-sm leading-relaxed text-muted">{% if since %}{{ "read.archive_empty_since" | t(lang, {month: since | readMonth(lang, "long")}) }}{% else %}{{ "read.archive_empty_text" | t(lang) }}{% endif %}</p>
        </div>
      </div>
      <div class="mt-5 grid grid-cols-1 gap-3 sm:grid-cols-2 sm:pl-[4.75rem]">
        {% for p in order %}
        {%- set hub = lvHub if p == "lv" else gvHub -%}
        <a class="card card-link group flex items-center gap-3 p-3.5 no-underline" href="{{ hub }}" target="_blank" rel="noopener">
          <span class="grid size-10 shrink-0 place-items-center rounded-xl {{ 'bg-lv-soft text-lv' if p == 'lv' else 'bg-gv-soft text-gv' }}">{% icon "grapes", "size-5" %}</span>
          <span class="min-w-0 flex-1"><span class="block text-sm font-semibold text-ink">{{ ("read.back_issues_lv" if p == "lv" else "read.back_issues_gv") | t(lang) }}</span><span class="block text-xs text-muted">{{ hub | hostname }}</span></span>
          {% ricon "arrow-up-right", "size-4 shrink-0 text-faint transition group-hover:-translate-y-0.5 group-hover:translate-x-0.5" %}
          <span class="sr-only">({{ "common.external" | t(lang) }})</span>
        </a>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </section>
</div>

{#- ---------- More ways to read & take part ---------- -#}
<section class="section container-page pt-0" aria-labelledby="more-title">
  <h2 id="more-title" class="h-section mb-6">{{ "read.more_title" | t(lang) }}</h2>
  <div class="grid-cards-4">
    {% set tiles = [
      { href: "/subscribe/" | lurl(lang), icon: "mail-open", t: "read.more_sub_t", d: "read.more_sub", c: "bg-gv-soft text-gv" },
      { href: "/contribute/" | lurl(lang), icon: "pen-line", t: "read.more_write_t", d: "read.more_write", c: "bg-lv-soft text-lv" },
      { href: "/listen/" | lurl(lang), icon: "headphones", t: "read.more_listen_t", d: "read.more_listen", c: "bg-grape-soft text-grape" },
      { href: "/library/" | lurl(lang), icon: "library", t: "read.more_library_t", d: "read.more_library", c: "bg-vine-soft text-vine" }
    ] %}
    {% for tl in tiles %}
    <a href="{{ tl.href }}" class="card card-link card-pad group flex flex-col gap-3 no-underline">
      <span class="grid size-11 place-items-center rounded-xl {{ tl.c }}">{% icon tl.icon, "size-5" %}</span>
      <span class="h-card">{{ tl.t | t(lang) }}</span>
      <span class="text-sm leading-relaxed text-muted">{{ tl.d | t(lang) }}</span>
      <span class="mt-auto inline-flex items-center gap-1 text-sm font-semibold text-gv">{{ "common.open" | t(lang) }} {% icon "arrow-right", "size-4 transition group-hover:translate-x-0.5" %}</span>
    </a>
    {% endfor %}
  </div>
</section>
