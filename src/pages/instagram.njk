---
pagination: { data: languages, size: 1, alias: lang }
permalink: "{{ '/' if lang == 'en' else '/es/' }}instagram/index.html"
layout: layouts/base.njk
pageKey: instagram
titleKey: nav.instagram
descKey: media.ig_meta
pageScripts: ["/assets/js/media.js"]
---
{#- INSTAGRAM — latest posts of AA Grapevine (EN) and La Viña (ES), db.instagram
    (+ `profiles`: avatar, follower and post counts, cached by the daily sync).
    Posts show the locally cached thumbnail (/assets/cache/ig/*.webp) in a 4:5
    frame — the whole picture is visible (flyers carry text), a blurred copy
    fills the margins — otherwise a designed "text post" tile. Nothing loads
    from instagram.com until a visitor presses "Show post here" (official
    embed, per post) — privacy + speed. -#}
{% import "macros/ui.njk" as ui with context %}
{% mediaSprite %}
{%- set accounts = (site.sources.instagram and site.sources.instagram.accounts) or [] -%}
{%- set posts = db.instagram | mediaItems("instagram") -%}
{%- set INITIAL_SHOWN = 12 -%}{#- keep in sync with igCard (idx >= 12) and igPage.shown in media.js -#}
{%- set MAX_POSTS = 48 -%}

{#- Decorative grape cluster used on tiles and profile bands -#}
{% macro grapeArt(cls) %}
<svg class="{{ cls }}" viewBox="0 0 120 150" fill="none" aria-hidden="true" focusable="false">
  <path d="M60 22V4" stroke="currentColor" stroke-width="5" stroke-linecap="round"/>
  <path d="M60 16c9-11 24-13 36-7-4 13-16 20-29 19" fill="currentColor"/>
  <g fill="currentColor"><circle cx="44" cy="44" r="13"/><circle cx="72" cy="44" r="13"/><circle cx="31" cy="68" r="13"/><circle cx="58" cy="68" r="13"/><circle cx="85" cy="67" r="13"/><circle cx="45" cy="92" r="13"/><circle cx="72" cy="92" r="13"/><circle cx="58" cy="116" r="13"/></g>
</svg>
{% endmacro %}

{#- One post card -#}
{% macro igCard(p, lang, acc, idx) %}
{%- set img = p | mediaIgImage -%}
{%- set cap = p | mediaIgCaption(lang) -%}
{%- set href = p.url | mediaSafeUrl("https://www.instagram.com/" + acc.username + "/") -%}
{%- set embed = p | mediaIgEmbed -%}
{%- set mt = p.extra.media_type -%}
{%- set fromLabel = "media.ig_post_from" | t(lang, { u: acc.username }) -%}
<article class="card flex flex-col overflow-hidden" x-data="{ embed: false }" :class="embed && 'col-span-2'"
         {% if idx >= 12 %}x-show="shown.{{ acc.key }} > {{ idx }}"{% endif %}>
  {% if embed %}
  <template x-if="embed">
    <div class="ig-embed">
      <iframe data-ig-embed src="{{ embed }}" title="{{ 'media.ig_embed_title' | t(lang, { u: acc.username }) }}" loading="lazy" scrolling="no"
              allow="encrypted-media; clipboard-write; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin"></iframe>
    </div>
  </template>
  {% endif %}
  {% if img %}
  <a x-show="!embed" href="{{ href }}" target="_blank" rel="noopener" class="ig-photo">
    <img src="{{ img }}" alt="" aria-hidden="true" loading="lazy" decoding="async" class="ig-photo-bg" onerror="this.style.display='none'">
    <img src="{{ img }}" alt="{{ (cap | excerpt(140)) or fromLabel }}" width="480" height="600" loading="lazy" decoding="async" class="ig-photo-img" onerror="this.style.visibility='hidden'">
    {% if mt == "video" %}<span class="ig-type">{% micon "clapperboard", "size-4", "media.ig_type_video" | t(lang) %}</span>
    {% elif mt == "carousel" %}<span class="ig-type">{% micon "gallery-horizontal-end", "size-4", "media.ig_type_carousel" | t(lang) %}</span>{% endif %}
    <span class="sr-only">{{ "media.ig_view" | t(lang) }} ({{ "common.external" | t(lang) }})</span>
  </a>
  {% else %}
  <a x-show="!embed" href="{{ href }}" target="_blank" rel="noopener" class="ig-tile is-{{ acc.key }} ig-v{{ idx % 3 }} group">
    {{ grapeArt("ig-tile-art") }}
    <span class="relative flex items-center justify-between">
      <span class="grid size-8 place-items-center rounded-full bg-white/15 ring-1 ring-white/25">{% micon "instagram", "size-4" %}</span>
      {% if mt == "video" %}{% micon "clapperboard", "size-5 opacity-90", "media.ig_type_video" | t(lang) %}{% elif mt == "carousel" %}{% micon "gallery-horizontal-end", "size-5 opacity-90", "media.ig_type_carousel" | t(lang) %}{% endif %}
    </span>
    {% if cap %}
    <span class="relative line-clamp-4 font-display text-sm leading-snug sm:line-clamp-5 sm:text-base">“{{ cap | excerpt(200) }}”</span>
    {% else %}
    <span class="relative">
      <span class="sr-only">{{ fromLabel }}</span>
      <span class="block font-display text-base leading-tight font-semibold min-[400px]:text-xl sm:text-2xl" aria-hidden="true">{{ acc.name }}</span>
      {% if p.date %}<span class="mt-1 block text-xs text-white/75 sm:text-sm" aria-hidden="true">{{ p.date | fmtDate(lang, "short") }}</span>{% endif %}
    </span>
    {% endif %}
    <span class="relative inline-flex items-center gap-1 text-[0.7rem] font-semibold text-white/85 group-hover:text-white sm:text-xs">{{ "media.ig_view" | t(lang) }} {% micon "arrow-up-right", "size-3.5" %}</span>
  </a>
  {% endif %}
  <div class="flex flex-1 flex-col gap-2 p-3">
    {% if img and cap %}<p class="line-clamp-3 text-sm leading-relaxed text-ink">{{ cap }}</p>{% endif %}
    <div class="mt-auto flex flex-wrap items-center justify-between gap-x-2 gap-y-1 text-xs text-faint">
      {% if p.date and (img or cap) %}<time datetime="{{ p.date | isoDate }}">{{ p.date | fmtDate(lang, "short") }}</time>{% else %}<span></span>{% endif %}
      {% if p.is_new %}<span class="badge-new">{{ "common.new" | t(lang) }}</span>{% endif %}
      {% if cap %}{{ ui.autoNote(p, lang) }}{% endif %}
    </div>
    {% if embed %}
    <button type="button" class="-mx-1 inline-flex min-h-9 items-center gap-1.5 self-start rounded-lg px-1 text-xs font-semibold text-gv hover:underline" x-cloak x-show="!embed" @click="embed = true" aria-label="{{ 'media.ig_load_embed_aria' | t(lang) }}">{% micon "square-play", "size-4" %} {{ "media.ig_load_embed" | t(lang) }}</button>
    <button type="button" class="-mx-1 inline-flex min-h-9 items-center gap-1.5 self-start rounded-lg px-1 text-xs font-semibold text-muted hover:underline" x-cloak x-show="embed" @click="embed = false">{% micon "x", "size-4" %} {{ "media.ig_hide_embed" | t(lang) }}</button>
    {% endif %}
  </div>
</article>
{% endmacro %}

{#- ------------------------------------------------------------------ hero -#}
{% call ui.pageHero(lang, "media.ig_title" | t(lang), "media.ig_sub" | t(lang), "instagram", "media.ig_eyebrow" | t(lang)) %}
  <div class="flex flex-wrap gap-2">
    {% for acc in accounts %}
    <a class="{{ 'btn-light' if loop.first else 'btn-on-dark' }} max-w-full" href="https://www.instagram.com/{{ acc.username }}/" target="_blank" rel="noopener">{% icon "instagram", "size-4" %} {{ "media.ig_follow" | t(lang, { u: acc.username }) }}</a>
    {% endfor %}
  </div>
  <p class="mt-5 flex items-center gap-2 text-sm text-white/70">{% icon "shield-check", "size-4 shrink-0" %}{{ "media.ig_privacy" | t(lang) }}</p>
{% endcall %}

<section class="section container-page pt-6 sm:pt-8" x-data="igPage" aria-label="{{ 'media.ig_title' | t(lang) }}">
  {#- Phone: pick an account (both columns show side by side on large screens) -#}
  {% if accounts.length > 1 %}
  <div class="mb-6 flex justify-center lg:hidden" role="group" aria-label="{{ 'media.ig_tabs_label' | t(lang) }}">
    <div class="inline-flex gap-1 rounded-full border border-line bg-surface p-1 shadow-[var(--shadow-card)]">
      {% for acc in accounts %}
      <button type="button" class="chip border-transparent" :aria-pressed="(tab === '{{ acc.key }}').toString()" aria-pressed="{{ 'true' if loop.first else 'false' }}" @click="tab = '{{ acc.key }}'">{% icon "grapes", "size-4" %}{{ acc.name }}</button>
      {% endfor %}
    </div>
  </div>
  {% endif %}

  <div class="grid grid-cols-1 items-start gap-10 lg:grid-cols-2 lg:gap-8">
    {% for acc in accounts %}
    {%- set accPosts = posts | mediaIgFor(acc) | limit(MAX_POSTS) -%}
    {%- set prof = db.instagram | mediaIgProfile(acc) -%}
    {%- set profile = prof.url -%}
    {%- set isLv = acc.key == "lv" -%}
    <section aria-labelledby="ig-{{ acc.key }}-title" {% if accounts.length > 1 %}:class="tab === '{{ acc.key }}' ? '' : 'max-lg:hidden'"{% endif %}>
      <div class="card overflow-hidden">
        <div class="ig-profile-band is-{{ acc.key }} relative overflow-hidden text-white">
          {{ grapeArt("absolute -right-4 -top-6 h-40 w-auto opacity-15") }}
        </div>
        <div class="px-5 pb-5 sm:px-6">
          <div class="flex items-end justify-between gap-3">
            <span class="ig-avatar is-{{ acc.key }} relative z-10"><span>{% icon "grapes", "size-8" %}</span>{% if prof.avatar %}<img src="{{ prof.avatar }}" alt="" width="72" height="72" decoding="async" onerror="this.remove()">{% endif %}</span>
            <a class="{{ 'btn-lv' if isLv else 'btn-primary' }} btn-sm" href="{{ profile }}" target="_blank" rel="noopener">{% icon "instagram", "size-4" %} {{ "common.follow" | t(lang) }}</a>
          </div>
          <h2 id="ig-{{ acc.key }}-title" class="mt-3 font-display text-2xl font-semibold">{{ acc.name }}</h2>
          <p class="mt-0.5 flex flex-wrap items-center gap-2 text-sm text-muted">
            <a class="font-medium hover:text-gv" href="{{ profile }}" target="_blank" rel="noopener">@{{ prof.username }}</a>
            <span class="{{ 'badge-lv' if isLv else 'badge-gv' }}">{{ ("media.ig_in_spanish" if isLv else "media.ig_in_english") | t(lang) }}</span>
          </p>
          {% if prof.posts or prof.followers %}
          <p class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-sm text-muted">
            {% if prof.posts %}<span>{{ "media.ig_posts_total" | t(lang, { n: '<strong class="font-semibold text-ink">' + (prof.posts | mediaNumber(lang)) + '</strong>' }) | safe }}</span>{% endif %}
            {% if prof.followers %}<span>{{ "media.ig_followers" | t(lang, { n: '<strong class="font-semibold text-ink">' + (prof.followers | mediaNumber(lang, true)) + '</strong>' }) | safe }}</span>{% endif %}
          </p>
          {% endif %}
          <p class="mt-2 text-sm leading-relaxed text-muted">{{ ("media.ig_lv_desc" if isLv else "media.ig_gv_desc") | t(lang) }}</p>
          {% if accPosts.length %}<p class="mt-2 text-xs text-faint">{{ "media.ig_posts_n" | t(lang, { n: accPosts.length }) }}</p>{% endif %}
        </div>
      </div>

      {% if accPosts.length %}
      <div class="mt-4 grid grid-cols-2 gap-3 sm:gap-4">
        {% for p in accPosts %}{{ igCard(p, lang, acc, loop.index0) }}{% endfor %}
      </div>
      <div class="mt-5 flex flex-col items-center gap-3">
        {% if accPosts.length > INITIAL_SHOWN %}
        <button type="button" class="btn-secondary" x-cloak x-show="shown.{{ acc.key }} < {{ accPosts.length }}" @click="more('{{ acc.key }}')">{% icon "arrow-down", "size-4" %} {{ "media.ig_show_more" | t(lang) }}</button>
        {% endif %}
        <a class="link inline-flex items-center gap-1 text-sm" href="{{ profile }}" target="_blank" rel="noopener">{{ "media.ig_see_all" | t(lang) }} {% icon "arrow-up-right", "size-4" %}</a>
      </div>
      {% else %}
      <div class="mt-4">
        {{ ui.emptyState("instagram", "media.ig_empty_title" | t(lang), "media.ig_empty_text" | t(lang), profile, "media.ig_follow" | t(lang, { u: acc.username })) }}
      </div>
      {% endif %}
    </section>
    {% endfor %}
  </div>
</section>

{#- ------------------------------------------------------------------ tell your group -#}
<section class="section-tight container-page" aria-labelledby="ig-share-title">
  <div class="card media-anywhere grid grid-cols-[minmax(0,1fr)] gap-6 p-6 sm:p-8 md:grid-cols-[auto_minmax(0,1fr)] md:items-center">
    <span class="grid size-14 place-items-center rounded-2xl bg-grape-soft text-grape">{% icon "megaphone", "size-7" %}</span>
    <div>
      <h2 id="ig-share-title" class="h-section">{{ "media.ig_share_title" | t(lang) }}</h2>
      <p class="mt-1 text-muted">{{ "media.ig_share_text" | t(lang) }}</p>
      <blockquote class="mt-4 rounded-2xl border border-line bg-surface p-4 font-display text-lg leading-snug text-ink">{{ "media.ig_announcement" | t(lang) }}</blockquote>
      <div class="mt-4 flex flex-wrap gap-2">
        <button type="button" class="btn-primary btn-sm" data-copy="{{ 'media.ig_announcement' | t(lang) }}">{% icon "copy", "size-4" %} {{ "media.copy_announcement" | t(lang) }}</button>
        <button type="button" class="btn-secondary btn-sm" data-share="{{ page.url | siteUrl(site) }}" data-share-title="{{ 'media.ig_title' | t(lang) }} — {{ 'media.ig_eyebrow' | t(lang) }}">{% icon "share-2", "size-4" %} {{ "common.share" | t(lang) }}</button>
      </div>
    </div>
  </div>
</section>
