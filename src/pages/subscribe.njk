---
pagination: { data: languages, size: 1, alias: lang }
permalink: "{{ '/' if lang == 'en' else '/es/' }}subscribe/index.html"
layout: layouts/base.njk
pageKey: subscribe
titleKey: read.subs.title
descKey: read.subs.meta_desc
---
{#- SUBSCRIBE — ways to get Grapevine & La Viña (no prices: they change; we link
    to the official stores), Carry the Message, home-group subscriptions, free
    resources, customer service, and catalogs pulled automatically from db.pdfs. -#}
{% import "macros/ui.njk" as ui with context %}
{%- set L = site.links -%}
{%- set catalogs = db.pdfs | readCatalogs -%}
{%- set ctmPdfs = db.pdfs | readPdfsMatching("\\bctm\\b|carry the message|lleva el mensaje", 3) -%}
{%- set forms = db.pdfs | readForms -%}
{%- set weekly = (db.weekly_open.items | readItems)[0] -%}
{%- set pubOrder = ["lv", "gv"] if lang == "es" else ["gv", "lv"] -%}
{%- set gvIssues = db.articles | readIssues("gv") -%}
{%- set lvIssues = db.articles | readIssues("lv") -%}
{%- set curIssue = {
  gv: (gvIssues[0] | readIssueView(lang)) if gvIssues.length else null,
  lv: (lvIssues[0] | readIssueView(lang)) if lvIssues.length else null
} -%}

{#- Language of a PDF document (not of its title), shown when it differs from the page -#}
{% macro docPill(p, lang) -%}
{%- set dl = p | readDocLang -%}
{%- if dl and dl != lang %}<span class="badge-muted shrink-0 uppercase" title="{{ ('lang.' + dl) | t(lang) }}">{{ dl }}</span>{% endif -%}
{%- endmacro %}

{#- PDF "cover" card (thumbnail if the sync made one, otherwise a styled placeholder) -#}
{% macro pdfCover(p, lang, aspect="aspect-[4/5]") %}
{%- set pub = p | readPub -%}
{%- set info = p | readPdfTitleInfo(lang) -%}
<a href="{{ p.url }}" target="_blank" rel="noopener" class="card card-link group flex flex-col overflow-hidden no-underline">
  <div class="relative {{ aspect }} overflow-hidden rounded-t-[var(--radius-card)] border-b border-line bg-surface-2">
    {% if p.extra and p.extra.thumb %}
      <img src="{{ p.extra.thumb }}" alt="" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover object-top transition duration-300 group-hover:scale-[1.03]">
    {% else %}
      <div class="read-pdf-ph {{ 'read-accent-lv' if pub == 'lv' else 'read-accent-gv' }} absolute inset-0">
        <div class="relative text-center">
          <span class="mx-auto grid size-14 place-items-center rounded-2xl bg-surface/80 shadow-sm">{% icon "book-open", "size-7" %}</span>
          <p class="mt-3 font-display text-lg font-semibold">{{ "La Viña" if pub == "lv" else "Grapevine" }}</p>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] opacity-80">{{ "read.subs.catalog_word" | t(lang) }}</p>
        </div>
      </div>
    {% endif %}
    <span class="absolute left-3 top-3 flex gap-1.5">
      {% if pub == "lv" %}<span class="badge-lv shadow-sm">La Viña</span>{% else %}<span class="badge-gv shadow-sm">Grapevine</span>{% endif %}
      {% if p.is_new %}<span class="badge-new shadow-sm">{{ "common.new" | t(lang) }}</span>{% endif %}
    </span>
  </div>
  <div class="flex flex-1 flex-col gap-1 p-4">
    <h3 class="h-card text-base group-hover:text-gv" lang="{{ info.lang or p.lang }}">{{ info.title }}</h3>
    {% if info.gloss %}<p class="flex items-center gap-1 text-xs text-muted" title="{{ 'common.auto_translated' | t(lang) }}">{% icon "languages", "size-3 shrink-0" %}<span class="sr-only">{{ "common.auto_translated" | t(lang) }}:</span><span lang="{{ info.glossLang }}">{{ info.gloss }}</span></p>{% endif %}
    <p class="flex flex-wrap items-center gap-1.5 text-xs text-muted">{{ docPill(p, lang) }}
      {%- set ex = p.extra or {} -%}
      {%- set meta = [
        (ex.upload_month | readMonth(lang)) if ex.upload_month else ((p.date | readMonth(lang)) if p.date else ""),
        (("read.one_page" if ex.pages == 1 else "common.pages") | t(lang, {n: ex.pages})) if ex.pages else "",
        (ex.size_bytes | fileSize) if ex.size_bytes else ""
      ] -%}
      <span>{{ meta | uniq | join(" · ") }}</span>
    </p>
    <span class="mt-auto inline-flex items-center gap-1 pt-2 text-sm font-semibold text-gv">{% icon "file-down", "size-4" %} {{ "common.open_pdf" | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></span>
  </div>
</a>
{% endmacro %}

{#- Compact PDF row -#}
{% macro pdfRow(p, lang) %}
{%- set info = p | readPdfTitleInfo(lang) -%}
<li>
  <a href="{{ p.url }}" target="_blank" rel="noopener" class="group flex min-h-12 items-center gap-3 rounded-xl px-3 py-2 no-underline transition hover:bg-surface-2">
    <span class="grid size-9 shrink-0 place-items-center rounded-lg {{ 'bg-lv-soft text-lv' if (p | readPub) == 'lv' else 'bg-gv-soft text-gv' }}">{% icon "file-text", "size-4" %}</span>
    <span class="min-w-0 flex-1">
      <span class="block text-sm font-medium text-ink group-hover:text-gv" lang="{{ info.lang or p.lang }}">{{ info.title }}</span>
      {% if info.gloss %}<span class="flex min-w-0 items-center gap-1 text-xs text-muted" title="{{ 'common.auto_translated' | t(lang) }}">{% icon "languages", "size-3 shrink-0" %}<span class="sr-only">{{ "common.auto_translated" | t(lang) }}:</span><span class="min-w-0 truncate" lang="{{ info.glossLang }}">{{ info.gloss }}</span></span>{% endif %}
    </span>
    {{ docPill(p, lang) }}
    {% icon "arrow-up-right", "size-4 shrink-0 text-faint" %}
    <span class="sr-only">(PDF, {{ "common.external" | t(lang) }})</span>
  </a>
</li>
{% endmacro %}

{#- The shared hero (same height on every page). Its buttons are the standard 44px / 14px size
    at every width, like every other page; "read-hero" (read.css) keeps phone heroes within
    24–28rem (below ~414px the two buttons stack, so the subtitle is kept to three phone lines).
    The in-page "Gift a subscription" jump shows from 768px, so the row does not wrap on small
    tablets. -#}
{% call ui.pageHero(lang, "read.subs.title" | t(lang), "read.subs.subtitle" | t(lang), "mail-open", "read.subs.eyebrow" | t(lang), { class: "read-hero" }) %}
  <div class="hero-actions">
    {% for p in pubOrder %}
    <a class="{{ 'btn-light' if loop.first else 'btn-on-dark' }}" href="{{ L.lv_subscribe if p == 'lv' else L.gv_subscribe }}" target="_blank" rel="noopener">{% icon "grapes", "size-4" %} {{ ("read.subs.sub_lv" if p == "lv" else "read.subs.sub_gv") | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a>
    {% endfor %}
    <a class="btn-on-dark max-md:hidden" href="#carry">{% icon "gift", "size-4" %} {{ "read.subs.ctm_short" | t(lang) }}</a>
  </div>
{% endcall %}

{#- ---------- The two magazines ---------- -#}
<section class="container-page page-start" aria-label="{{ 'read.subs.mags_title' | t(lang) }}">
  {{ ui.sectionHead("read.subs.mags_title" | t(lang), "read.subs.mags_sub" | t(lang), "", "", "grapes") }}
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    {% for p in pubOrder %}
    {%- set isLv = p == "lv" -%}
    <article class="card flex flex-col overflow-hidden" aria-labelledby="mag-{{ p }}">
      {%- set ci = curIssue[p] -%}
      <header class="read-cover {{ 'read-cover--lv' if isLv else 'read-cover--gv' }} relative isolate overflow-hidden p-6 text-white sm:p-7">
        <svg class="read-cover-art" viewBox="0 0 200 240" fill="none" aria-hidden="true"><g fill="currentColor"><circle cx="82" cy="96" r="17"/><circle cx="116" cy="96" r="17"/><circle cx="150" cy="100" r="15"/><circle cx="66" cy="126" r="17"/><circle cx="100" cy="126" r="17"/><circle cx="134" cy="128" r="17"/><circle cx="82" cy="156" r="17"/><circle cx="116" cy="156" r="17"/><circle cx="100" cy="186" r="17"/></g></svg>
        <div class="flex items-start gap-5">
          <div class="min-w-0 flex-1">
            <p class="text-xs font-semibold uppercase tracking-[0.18em] text-white/75">{{ ("read.subs.lv_kicker" if isLv else "read.subs.gv_kicker") | t(lang) }}</p>
            <h3 id="mag-{{ p }}" class="mt-1 flex items-center gap-2 font-display text-3xl font-semibold">{% icon "grapes", "size-7" %} {{ "La Viña" if isLv else "AA Grapevine" }}</h3>
            <p class="mt-2 max-w-md text-white/85">{{ ("read.subs.lv_desc" if isLv else "read.subs.gv_desc") | t(lang) }}</p>
          </div>
          {% if ci and ci.cover %}
          <a class="read-cover-frame mt-1 block w-[5.25rem] shrink-0 rotate-2 sm:w-24" href="{{ '/read/' | lurl(lang) }}#{{ p }}-current" title="{{ 'read.subs.see_issue' | t(lang, {issue: ci.label}) }}">
            <img src="{{ ci.cover }}" width="480" height="686" alt="{{ 'read.cover_alt' | t(lang, {pub: ('La Viña' if isLv else 'Grapevine'), issue: ci.label}) }}" class="block aspect-[7/10] w-full rounded-[0.3rem] object-cover">
          </a>
          {% endif %}
        </div>
        <ul class="mt-5 flex flex-wrap gap-2 text-xs font-semibold">
          {% for f in (["f_every2", "f_spanish", "f_since96"] if isLv else ["f_monthly", "f_english", "f_since44"]) %}
          <li class="rounded-full bg-white/12 px-3 py-1 ring-1 ring-white/20">{{ ("read.subs." + f) | t(lang) }}</li>
          {% endfor %}
        </ul>
      </header>
      <div class="flex flex-1 flex-col gap-5 p-6 sm:p-7">
        <ul class="grid grid-cols-2 gap-3 text-sm">
          {% for f in [["printer", "fmt_print_t"], ["monitor", "fmt_online_t"], ["smartphone", "fmt_app_t"], ["headphones", "fmt_audio_t"]] %}
          <li class="flex items-center gap-2 text-ink"><span class="{{ 'text-lv' if isLv else 'text-gv' }}">{% icon f[0], "size-4" %}</span>{{ ("read.subs." + f[1]) | t(lang) }}</li>
          {% endfor %}
        </ul>
        <div class="mt-auto flex flex-wrap gap-2">
          <a class="{{ 'btn-lv' if isLv else 'btn-primary' }}" href="{{ L.lv_subscribe if isLv else L.gv_subscribe }}" target="_blank" rel="noopener">{{ "read.subs.subscribe_btn" | t(lang) }} {% icon "arrow-up-right", "size-4" %}</a>
          <a class="btn-secondary" href="{{ L.lv_store if isLv else L.gv_store }}" target="_blank" rel="noopener">{% icon "store", "size-4" %} {{ "read.subs.store_btn" | t(lang) }}</a>
          <a class="btn-secondary" href="{{ L.lv_apps if isLv else L.gv_apps }}" target="_blank" rel="noopener">{% icon "smartphone", "size-4" %} {{ "read.subs.apps_btn" | t(lang) }}</a>
        </div>
      </div>
    </article>
    {% endfor %}
  </div>
</section>

{#- ---------- Formats ---------- -#}
<section class="section container-page pt-0" aria-labelledby="fmt-title">
  <h2 id="fmt-title" class="h-section">{{ "read.subs.fmt_title" | t(lang) }}</h2>
  <p class="mt-1.5 mb-6 max-w-2xl text-muted">{{ "read.subs.fmt_sub" | t(lang) }}</p>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
    {% for f in [["printer", "print", "bg-gv-soft text-gv"], ["monitor", "online", "bg-grape-soft text-grape"], ["layers", "bundle", "bg-vine-soft text-vine"], ["smartphone", "app", "bg-lv-soft text-lv"], ["headphones", "audio", "bg-gv-soft text-gv"]] %}
    <div class="card card-pad flex flex-col">
      <span class="grid size-11 place-items-center rounded-xl {{ f[2] }}">{% icon f[0], "size-5" %}</span>
      <h3 class="h-card mt-3">{{ ("read.subs.fmt_" + f[1] + "_t") | t(lang) }}</h3>
      <p class="mt-1.5 text-sm leading-relaxed text-muted">{{ ("read.subs.fmt_" + f[1]) | t(lang) }}</p>
    </div>
    {% endfor %}
  </div>
  <p class="measure mt-5 flex items-start gap-2 text-sm text-muted">{% icon "info", "mt-0.5 size-4 text-gv" %} <span>{{ "read.subs.no_prices" | t(lang) }}</span></p>
</section>

{#- ---------- Carry the Message ---------- -#}
<section id="carry" class="scroll-mt-20 border-y border-line bg-lv-soft/60" aria-labelledby="ctm-title">
  <div class="container-page section grid grid-cols-1 items-center gap-10 lg:grid-cols-[1.2fr_1fr]">
    <div>
      <p class="eyebrow text-lv">{{ "read.subs.ctm_eyebrow" | t(lang) }}</p>
      <h2 id="ctm-title" class="h-display mt-2 text-3xl sm:text-4xl">{{ "read.subs.ctm_title" | t(lang) }}</h2>
      <p class="lead measure mt-4">{{ "read.subs.ctm_text" | t(lang) }}</p>
      <ul class="mt-6 grid grid-cols-1 gap-3 sm:grid-cols-2">
        {% for w in [["landmark", "ctm_w1"], ["hospital", "ctm_w2"], ["sprout", "ctm_w3"], ["map", "ctm_w4"]] %}
        <li class="flex items-center gap-3 rounded-xl bg-surface p-3 shadow-[var(--shadow-card)]"><span class="grid size-9 shrink-0 place-items-center rounded-lg bg-lv-soft text-lv">{% icon w[0], "size-4" %}</span><span class="text-sm font-medium text-ink">{{ ("read.subs." + w[1]) | t(lang) }}</span></li>
        {% endfor %}
      </ul>
      <div class="mt-7 flex flex-wrap gap-2.5">
        <a class="btn-lv" href="{{ L.carry_the_message }}" target="_blank" rel="noopener">{% icon "gift", "size-4" %} {{ "read.subs.ctm_btn" | t(lang) }}</a>
        <a class="btn-secondary" href="{{ '/gvr/' | lurl(lang) }}">{{ "read.subs.ctm_gvr" | t(lang) }}</a>
      </div>
    </div>
    <div class="card card-pad">
      <p class="flex items-center gap-2 font-display text-xl font-semibold">{% icon "hand-heart", "size-6 text-lv" %} {{ "read.subs.ctm_how_title" | t(lang) }}</p>
      <ol class="mt-4 space-y-3">
        {% for n in range(1, 4) %}
        <li class="flex gap-3"><span class="read-num grid size-7 shrink-0 place-items-center rounded-full bg-lv text-xs font-bold text-white dark:text-paper">{{ n }}</span><span class="text-sm leading-relaxed text-muted">{{ ("read.subs.ctm_how" + n) | t(lang) }}</span></li>
        {% endfor %}
      </ol>
      {% if ctmPdfs.length %}
      <p class="eyebrow mt-6">{{ "read.subs.ctm_flyers" | t(lang) }}</p>
      <ul class="-mx-3 mt-2">{% for p in ctmPdfs %}{{ pdfRow(p, lang) }}{% endfor %}</ul>
      {% endif %}
    </div>
  </div>
</section>

{#- ---------- Home group subscriptions ---------- -#}
<section class="section container-page" aria-label="{{ 'read.subs.group_title' | t(lang) }}">
  <div class="grid grid-cols-1 gap-10 lg:grid-cols-[1.25fr_1fr] 2xl:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] 2xl:gap-12">
    <div>
      {{ ui.sectionHead("read.subs.group_title" | t(lang), "read.subs.group_sub" | t(lang), "", "", "house") }}
      <ol class="relative space-y-4 border-l-2 border-line pl-6">
        {% for n in range(1, 5) %}
        <li class="relative">
          <span class="read-num absolute -left-[calc(2.5rem+1px)] top-0 grid size-8 place-items-center rounded-full border-2 border-paper bg-gv font-display text-sm font-semibold text-white dark:text-paper">{{ n }}</span>
          <p class="font-semibold text-ink">{{ ("read.subs.group" + n + "_t") | t(lang) }}</p>
          <p class="mt-0.5 text-sm leading-relaxed text-muted">{{ ("read.subs.group" + n) | t(lang) }}</p>
        </li>
        {% endfor %}
      </ol>
    </div>
    {#- @container: the Grapevine and La Viña form lists sit side by side when the card is wide -#}
    <aside class="card card-pad @container self-start" aria-labelledby="forms-title">
      <h3 id="forms-title" class="flex items-center gap-2 font-display text-xl font-semibold">{% icon "clipboard-list", "size-5 text-gv" %} {{ "read.subs.forms_title" | t(lang) }}</h3>
      <p class="mt-1 text-sm text-muted">{{ "read.subs.forms_sub" | t(lang) }}</p>
      {% if forms.gv.length or forms.lv.length %}
      <div class="grid grid-cols-1 gap-x-8 @2xl:grid-cols-2">
      {% for pub in pubOrder %}{% if forms[pub].length %}
      <div class="min-w-0">
        <p class="mt-4 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider {{ 'text-lv' if pub == 'lv' else 'text-gv' }}">{% icon "grapes", "size-3.5" %} {{ "La Viña" if pub == "lv" else "Grapevine" }}</p>
        <ul class="-mx-3 mt-1">{% for f in forms[pub] | limit(6) %}{{ pdfRow(f, lang) }}{% endfor %}</ul>
      </div>
      {% endif %}{% endfor %}
      </div>
      {% else %}
      <p class="mt-4 rounded-xl border border-dashed border-line p-4 text-sm text-muted">{{ "read.subs.forms_empty" | t(lang) }}</p>
      {% endif %}
      <p class="mt-3 flex flex-wrap gap-x-4 gap-y-1 text-sm"><a class="link" href="{{ L.gvr_resources }}" target="_blank" rel="noopener">{{ "read.subs.all_gvr" | t(lang) }}</a><a class="link" href="{{ L.rlv_resources }}" target="_blank" rel="noopener">{{ "read.subs.all_rlv" | t(lang) }}</a></p>
    </aside>
  </div>
</section>

{#- ---------- Free resources ---------- -#}
<section class="section container-page pt-0" aria-label="{{ 'read.subs.free_title' | t(lang) }}">
  {{ ui.sectionHead("read.subs.free_title" | t(lang), "read.subs.free_sub" | t(lang), "", "", "heart") }}
  {#- six cards → at most three per row: two even rows on wide screens, no lone card -#}
  <div class="grid-cards-fit [--cards-max:3]">
    {% set free = [
      { href: "/listen/" | lurl(lang), ext: false, icon: "headphones", c: "bg-grape-soft text-grape", k: "podcast" },
      { href: "/watch/" | lurl(lang), ext: false, icon: "youtube", c: "bg-grape-soft text-grape", k: "youtube" },
      { href: "/instagram/" | lurl(lang), ext: false, icon: "instagram", c: "bg-grape-soft text-grape", k: "instagram" },
      { href: L.gv_home, ext: true, icon: "quote", c: "bg-gv-soft text-gv", k: "quote" },
      { href: (weekly.url if weekly else L.weekly_open), ext: true, icon: "video", c: "bg-vine-soft text-vine", k: "weekly" },
      { href: L.sobriety_calculator, ext: true, icon: "calculator", c: "bg-lv-soft text-lv", k: "calc" }
    ] %}
    {% for f in free %}
    <a href="{{ f.href }}" {% if f.ext %}target="_blank" rel="noopener"{% endif %} class="card card-link card-pad group flex items-start gap-4 no-underline">
      <span class="grid size-12 shrink-0 place-items-center rounded-2xl {{ f.c }}">{% icon f.icon, "size-6" %}</span>
      <span class="min-w-0">
        <span class="h-card flex items-center gap-1.5">{{ ("read.subs.free_" + f.k + "_t") | t(lang) }} {% if f.ext %}{% icon "arrow-up-right", "size-4 text-faint" %}{% endif %}</span>
        <span class="mt-1 block text-sm leading-relaxed text-muted">{{ ("read.subs.free_" + f.k) | t(lang) }}</span>
        {% if f.k == "weekly" and weekly %}{%- set when = weekly | tx("when", lang) -%}{%- if not when and weekly.extra and weekly.extra.day %}{% set when = (weekly | tx("day", lang)) + ((" · " + (weekly | tx("time", lang))) if weekly.extra.time else "") %}{% endif -%}{% if when %}<span class="mt-2 inline-flex items-center gap-1.5 text-xs font-semibold text-vine">{% icon "clock", "size-3.5" %} {{ when }}</span>{% endif %}{% endif %}
      </span>
    </a>
    {% endfor %}
  </div>
</section>

{#- ---------- Catalogs (auto) ---------- -#}
{#- A few catalogs (the usual case): the text on the left, the covers on the right from 1024px.
    Many: a heading row, then a cover grid that gains columns on wide screens (up to 8). -#}
{%- set fewCats = catalogs.length and catalogs.length <= 3 -%}
{%- set coverCols = [
  "",
  "lg:grid-cols-[minmax(0,15rem)] 2xl:grid-cols-[minmax(0,17rem)]",
  "lg:grid-cols-[repeat(2,minmax(0,15rem))] 2xl:grid-cols-[repeat(2,minmax(0,17rem))]",
  "sm:grid-cols-3 lg:grid-cols-[repeat(3,minmax(0,15rem))] 2xl:grid-cols-[repeat(3,minmax(0,17rem))]"
] -%}{#- index = number of catalogs (1–3); literal class names so Tailwind finds them -#}
<section class="section border-t border-line bg-surface-2/60" aria-labelledby="cat-title">
  <div class="container-page">
    {% if fewCats %}
    <div class="grid grid-cols-1 items-center gap-8 lg:grid-cols-[minmax(0,1fr)_auto] lg:gap-12 2xl:gap-20">
      <div>
        <h2 id="cat-title" class="h-section flex items-center gap-2.5"><span class="text-gv">{% icon "book-open", "size-6" %}</span>{{ "read.subs.cat_title" | t(lang) }}</h2>
        <p class="mt-1.5 max-w-2xl text-muted">{{ "read.subs.cat_sub" | t(lang) }}</p>
        <p class="mt-4"><span class="badge-vine py-1!">{% icon "refresh-cw", "size-3" %} {{ "common.updates_daily" | t(lang) }}</span></p>
        <div class="mt-6 flex flex-wrap gap-2.5">
          {% for pub in pubOrder %}<a class="btn-secondary" href="{{ L.lv_store if pub == 'lv' else L.gv_store }}" target="_blank" rel="noopener">{% icon "store", "size-4" %} {{ ("read.subs.lv_store" if pub == "lv" else "read.subs.gv_store") | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a>{% endfor %}
        </div>
      </div>
      <div class="grid grid-cols-2 gap-4 sm:gap-5 {{ coverCols[catalogs.length] }}">
        {% for p in catalogs %}{{ pdfCover(p, lang) }}{% endfor %}
      </div>
    </div>
    {% else %}
    <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 id="cat-title" class="h-section flex items-center gap-2.5"><span class="text-gv">{% icon "book-open", "size-6" %}</span>{{ "read.subs.cat_title" | t(lang) }}</h2>
        <p class="mt-1.5 max-w-2xl text-muted">{{ "read.subs.cat_sub" | t(lang) }}</p>
      </div>
      <span class="badge-vine py-1!">{% icon "refresh-cw", "size-3" %} {{ "common.updates_daily" | t(lang) }}</span>
    </div>
    {% if catalogs.length %}
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 sm:gap-5 lg:grid-cols-4 xl:grid-cols-6 min-[1800px]:grid-cols-8">
      {% for p in catalogs | limit(8) %}{{ pdfCover(p, lang) }}{% endfor %}
    </div>
    {% if catalogs.length > 8 %}
    <details class="read-faq group/cat mt-5">
      <summary class="btn-secondary btn-sm cursor-pointer">{{ "read.subs.older_catalogs" | t(lang, {n: catalogs.length - 8}) }} {% icon "chevron-down", "size-4 transition group-open/cat:rotate-180" %}</summary>
      <ul class="card mt-3 p-2">{% for p in catalogs | offset(8) %}{{ pdfRow(p, lang) }}{% endfor %}</ul>
    </details>
    {% endif %}
    {% else %}
      {{ ui.emptyState("book-open", "read.subs.cat_empty" | t(lang), "read.subs.cat_empty_text" | t(lang), L.gv_store, "read.subs.gv_store" | t(lang)) }}
      <p class="mt-3 text-center text-sm"><a class="link" href="{{ L.lv_store }}" target="_blank" rel="noopener">{{ "read.subs.lv_store" | t(lang) }}</a></p>
    {% endif %}
    {% endif %}
  </div>
</section>

{#- ---------- Customer service ---------- -#}
<section class="section container-page" aria-labelledby="help-title">
  <div class="card overflow-hidden">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_1.4fr]">
      <div class="p-6 sm:p-8">
        <span class="grid size-12 place-items-center rounded-2xl bg-gv-soft text-gv">{% icon "phone", "size-6" %}</span>
        <h2 id="help-title" class="mt-4 font-display text-2xl font-semibold">{{ "read.subs.help_title" | t(lang) }}</h2>
        <p class="mt-2 leading-relaxed text-muted">{{ "read.subs.help_text" | t(lang) }}</p>
      </div>
      <ul class="grid grid-cols-1 divide-y divide-line border-t border-line sm:grid-cols-3 sm:divide-x sm:divide-y-0 lg:border-l lg:border-t-0">
        {% for ph in [["support_phone_us", "help_us"], ["support_phone_es", "help_es"], ["support_phone_intl", "help_intl"]] %}
        {% if L[ph[0]] %}
        <li class="flex flex-col justify-center p-6">
          <p class="text-xs font-semibold uppercase tracking-wider text-muted">{{ ("read.subs." + ph[1]) | t(lang) }}</p>
          <a class="mt-1 font-display text-xl font-semibold whitespace-nowrap text-ink no-underline hover:text-gv" href="{{ L[ph[0]] | readTel }}">{{ L[ph[0]] }}</a>
        </li>
        {% endif %}
        {% endfor %}
      </ul>
    </div>
  </div>
</section>
