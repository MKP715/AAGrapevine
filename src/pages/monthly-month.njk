---
pagination: { data: monthlyPages, size: 1, alias: mpage }
permalink: "{{ '/' if mpage.lang == 'en' else '/es/' }}monthly/{{ mpage.key }}/index.html"
layout: layouts/base.njk
pageKey: monthly
bodyClass: mp-page
pageScripts: ["/assets/js/monthly.js"]
eleventyComputed:
  lang: "{{ mpage.lang }}"
  # `| safe`: the layout escapes the title and description once (no "&amp;amp;" in the tab / share preview)
  title: "{{ ('monthly.month_title' | t(mpage.lang, { month: (mpage.key | mpMonth(db, carry, site, mpage.lang)).title })) | safe }}"
  description: "{% set mm = mpage.key | mpMonth(db, carry, site, mpage.lang) %}{{ (('monthly.month_desc' | t(mpage.lang, { month: mm.title, theme: mm.gv.theme })) if mm.gv else ('monthly.month_desc_plain' | t(mpage.lang, { month: mm.title }))) | safe }}"
---
{#- ONE month of /monthly/: the poster (1080 × 1350, scaled to fit; Download PNG / Share / Print)
    and that month's full toolkit below / beside it, with previous / next month links.
    Pages: this month + the next 12 (monthlyPages, eleventy/filters/monthly.js) × en / es.
    The hub (/monthly/) is the canonical home of the 10-ways guide; the shop (/shop/#botm) of
    Book of the Month prices; /events/ and /meetings/ of event details — this page links there. -#}
{% import "macros/ui.njk" as ui with context %}
{% import "macros/monthly.njk" as mp with context %}
{%- set m = mpage.key | mpMonth(db, carry, site, lang) -%}
{%- set all = db | mpMonths(carry, site, lang) -%}
{%- set L = site.links -%}
{%- set pageAbs = m.url | siteUrl(site) -%}

{% call ui.pageHero(lang, m.title, "monthly.month_sub" | t(lang), "calendar-heart", "monthly.title" | t(lang)) %}
<div class="hero-actions">
  <a class="btn-light" href="{{ '/monthly/' | lurl(lang) }}">{% icon "layout-grid", "size-4" %} {{ "monthly.back_hub" | t(lang) }}</a>
  {% if m.isCurrent %}<span class="badge-new">{{ "monthly.current" | t(lang) }}</span>{% endif %}
</div>
{% endcall %}

<section class="container-page page-start mp-print-root" aria-labelledby="mp-toolkit-title">
  <div class="mp-layout">
    <div class="mp-poster-col">
      <div class="mp-stage" data-mp-stage>
        <div class="mp-fit">{{ mp.poster(m, lang, site, "p") }}</div>
      </div>
      <div class="mp-actions mp-no-print">
        <button type="button" class="btn-primary" hidden data-mp-download data-file="{{ m.fileName }}" data-working="{{ 'monthly.working' | t(lang) }}" data-done="{{ 'monthly.saved' | t(lang) }}" data-failed="{{ 'monthly.failed' | t(lang) }}">{% icon "image-down", "size-4" %} {{ "monthly.download" | t(lang) }}</button>
        <button type="button" class="btn-secondary" hidden data-mp-share data-file="{{ m.fileName }}" data-url="{{ pageAbs }}" data-title="{{ m.title }} — {{ site | pick(lang, 'title') }}" data-text="{{ 'monthly.share_text' | t(lang, { month: m.label, url: pageAbs }) }}" data-copied="{{ 'monthly.link_copied' | t(lang) }}">{% icon "share-2", "size-4" %} {{ "monthly.share" | t(lang) }}</button>
        <button type="button" class="btn-secondary" onclick="window.print()">{% icon "printer", "size-4" %} {{ "monthly.print" | t(lang) }}</button>
      </div>
      <p class="mp-hint mp-no-print">{% icon "info", "size-4 shrink-0" %} {{ "monthly.poster_hint" | t(lang) }}</p>
    </div>

    <div class="mp-toolkit mp-no-print">
      <h2 id="mp-toolkit-title" class="h-section">{{ "monthly.toolkit" | t(lang) }}</h2>

      {#- Issues on the stands + put it to work -#}
      <article class="card card-pad">
        {% if lang == "es" and m.lv %}
        <p class="eyebrow text-lv">{{ "monthly.in_lv" | t(lang) }} · {{ m.lv.label }}</p>
        <p class="mt-1 font-display text-xl font-semibold text-ink">{{ m.lv.theme }}</p>
        {% if m.lv.url %}<a class="link mt-1 inline-flex items-center gap-1 text-sm max-sm:min-h-11" href="{{ m.lv.url }}" target="_blank" rel="noopener" hreflang="es">{{ "monthly.issue_link" | t(lang) }} {% icon "external-link", "size-3.5" %}</a>{% endif %}
        <hr class="my-5 border-line">
        {% endif %}
        <p class="eyebrow text-gv">{{ "monthly.in_gv" | t(lang, { month: m.monthName }) }}</p>
        <h3 class="h-card mt-1 text-2xl">{{ m.gv.theme if m.gv else ("monthly.no_issue" | t(lang)) }}</h3>
        {% if m.gv and m.gv.url %}<a class="link mt-1 inline-flex items-center gap-1 text-sm max-sm:min-h-11" href="{{ m.gv.url }}" target="_blank" rel="noopener" hreflang="en">{{ "monthly.issue_link" | t(lang) }} {% icon "external-link", "size-3.5" %}</a>{% endif %}
        {% if lang == "en" and m.lv %}
        <p class="mt-3 text-sm text-muted"><span class="font-semibold text-lv">{{ "monthly.in_lv" | t(lang) }} ({{ m.lv.label }}):</span> {{ m.lv.theme }}</p>
        {% endif %}
        {% if m.tips.length %}
        <h4 class="mt-5 text-sm font-semibold uppercase tracking-wider text-muted">{{ "monthly.put_to_work" | t(lang) }}</h4>
        <ul class="mp-tiplist mt-3" role="list">
          {% for tp in m.tips %}
          <li><span class="mp-tipicon">{% icon tp.icon, "size-5" %}</span><span><strong class="block text-ink">{{ tp.title }}</strong><span class="text-sm text-muted">{{ tp.text }}</span></span></li>
          {% endfor %}
        </ul>
        {% endif %}
      </article>

      {#- Stories wanted (La Viña first in Spanish) -#}
      {% set lvCard %}
      <article class="card card-pad">
        <h3 class="h-card flex items-center gap-2">{% icon "pen-line", "size-5 text-lv" %} {{ "monthly.share_story_lv" | t(lang) }}</h3>
        {% if m.lvTopics.length %}
        <p class="mt-2 text-sm text-muted">{{ "monthly.lv_topics" | t(lang) }}</p>
        <ul class="mt-2 flex flex-wrap gap-2" role="list">{% for tp in m.lvTopics %}<li class="badge-lv" lang="es">{{ tp.es }}</li>{% endfor %}</ul>
        {% endif %}
        {#- how to send (e-mail, guidelines) has ONE home: /contribute/ (the poster keeps the e-mail for print) -#}
        <a class="link mt-4 inline-flex min-h-11 items-center gap-1 text-sm font-semibold" href="{{ '/contribute/' | lurl(lang) }}#submit">{{ "monthly.lv_send_link" | t(lang) }} {% icon "arrow-right", "size-4" %}</a>
      </article>
      {% endset %}
      {% set gvCard %}
      <article class="card card-pad">
        <h3 class="h-card flex items-center gap-2">{% icon "pen-line", "size-5 text-gv" %} {{ "monthly.share_story" | t(lang) }}</h3>
        {% if lang == "es" %}<p class="mt-1 text-sm font-semibold text-gv">{{ "monthly.gv_english" | t(lang) }}</p>{% endif %}
        {% if m.deadlines.length %}
        <ul class="mt-3 space-y-4" role="list">
          {% for d in m.deadlines %}
          <li class="rounded-xl border border-line bg-surface-2/50 p-4">
            <p class="font-display text-lg font-semibold text-ink">{{ d.theme }}</p>
            <p class="mt-0.5 text-sm font-semibold text-gv">{{ "monthly.for_issue" | t(lang, { issue: d.issueLabel }) }} — {{ "monthly.due" | t(lang, { date: d.dueLong }) }}</p>
          </li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="mt-2 text-sm text-muted">{{ "monthly.no_deadlines" | t(lang) }}</p>
        {% endif %}
        {#- the full prompts, the e-mail and the guidelines have ONE home: /contribute/#deadlines -#}
        <a class="link mt-4 inline-flex min-h-11 items-center gap-1 text-sm font-semibold" href="{{ '/contribute/' | lurl(lang) }}#deadlines">{{ "monthly.deadlines_link" | t(lang) }} {% icon "arrow-right", "size-4" %}</a>
      </article>
      {% endset %}
      {% if lang == "es" %}{{ lvCard | safe }}{{ gvCard | safe }}{% else %}{{ gvCard | safe }}{{ lvCard | safe }}{% endif %}

      {#- Book of the Month: essentials only; prices live in the shop -#}
      {% if m.botm.length %}
      <article class="card card-pad">
        <h3 class="h-card flex items-center gap-2">{% icon "book-heart", "size-5 text-grape" %} {{ "monthly.botm" | t(lang) }}</h3>
        <ul class="mt-3 space-y-2" role="list">
          {% for b in m.botm %}
          <li><strong class="text-ink" lang="{{ b.lang }}">{{ b.title }}</strong> <span class="text-sm text-muted">— {{ ("monthly.botm_off" | t(lang, { pct: b.discount, date: b.endsLabel })) if b.discount else ("monthly.botm_until" | t(lang, { date: b.endsLabel })) }}</span></li>
          {% endfor %}
        </ul>
        <a class="link mt-3 inline-flex min-h-11 items-center gap-1 text-sm font-semibold" href="{{ '/shop/' | lurl(lang) }}#botm">{{ "monthly.botm_more" | t(lang) }} {% icon "arrow-right", "size-4" %}</a>
      </article>
      {% endif %}

      {#- Dates -#}
      <article class="card card-pad">
        <h3 class="h-card flex items-center gap-2">{% icon "calendar-days", "size-5 text-gv" %} {{ "monthly.dates" | t(lang) }}</h3>
        {% if m.dates.length %}
        <ul class="mt-3 divide-y divide-line" role="list">
          {% for d in m.dates %}
          <li class="flex gap-3 py-3">
            <span class="mp-minichip" aria-hidden="true"><span>{{ d.chip.mon }}</span><strong>{{ d.chip.day }}</strong></span>
            <span class="min-w-0">
              <a class="inline-flex font-semibold text-ink no-underline hover:text-gv hover:underline max-sm:min-h-11 max-sm:items-center" href="{{ ('/meetings/' | lurl(lang)) if d.kind == 'committee' else (d.url | lurl(lang) if d.url.startsWith('/') else d.url) }}"{% if not d.url.startsWith('/') and d.kind != 'committee' %} target="_blank" rel="noopener"{% endif %}>{{ ("monthly.committee" | t(lang)) if d.kind == "committee" else d.title }}</a>
              <span class="block text-sm text-muted">{{ d.day }}{% if d.endDay %} – {{ d.endDay }}{% endif %}{% if d.time %} · {{ d.time }} {{ d.zone }}{% endif %}{% if d.kind == "committee" %} · {{ d.platform }}{% elif d.city %} · {{ d.city }}{% endif %}{% if d.tentative %} · {{ "committee.events.tentative" | t(lang) }}{% endif %}</span>
            </span>
          </li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="mt-2 text-sm text-muted">{{ "monthly.no_dates" | t(lang) }}</p>
        {% endif %}
        <div class="mt-3 flex flex-wrap gap-2">
          <a class="btn-secondary btn-sm max-sm:min-h-11" href="{{ '/events/' | lurl(lang) }}">{% icon "calendar-days", "size-4" %} {{ "monthly.events_link" | t(lang) }}</a>
          <a class="btn-ghost btn-sm max-sm:min-h-11" href="{{ '/meetings/' | lurl(lang) }}">{% icon "video", "size-4" %} {{ "monthly.meeting_link" | t(lang) }}</a>
        </div>
      </article>

      {% if m.weekly.length %}
      <article class="card card-pad">
        <h3 class="h-card flex items-center gap-2">{% icon "video", "size-5 text-vine" %} {{ "monthly.weekly" | t(lang) }}</h3>
        <ul class="mt-3 space-y-2" role="list">
          {% for w in m.weekly %}
          <li><strong class="text-ink">{{ w.title }}</strong>{% if w.new %} <span class="badge-new">{{ "monthly.new" | t(lang) }}</span>{% endif %}<span class="block text-sm text-muted">{{ w.when }}{% if w.startsLabel %} · {{ "monthly.weekly_from" | t(lang, { date: w.startsLabel }) }}{% endif %}</span></li>
          {% endfor %}
        </ul>
        <a class="link mt-3 inline-flex min-h-11 items-center gap-1 text-sm font-semibold" href="{{ '/meetings/' | lurl(lang) }}#weekly-open">{{ "monthly.weekly_link" | t(lang) }} {% icon "arrow-right", "size-4" %}</a>
      </article>
      {% endif %}
    </div>
  </div>

  <nav class="mp-pager mp-no-print" aria-label="{{ 'monthly.back_hub' | t(lang) }}">
    {% if m.hasPrev %}<a class="btn-secondary" href="{{ ('/monthly/' + m.prev + '/') | lurl(lang) }}" rel="prev">{% icon "chevron-left", "size-4" %} <span>{{ "monthly.prev" | t(lang) }}<span class="mp-pager-m">{{ (all[m.index - 1]).title }}</span></span></a>{% else %}<span></span>{% endif %}
    {% if m.hasNext %}<a class="btn-secondary mp-pager-next" href="{{ ('/monthly/' + m.next + '/') | lurl(lang) }}" rel="next"><span>{{ "monthly.next" | t(lang) }}<span class="mp-pager-m">{{ (all[m.index + 1]).title }}</span></span> {% icon "chevron-right", "size-4" %}</a>{% endif %}
  </nav>
</section>
