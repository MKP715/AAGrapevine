  { href: "#faq", label: "read.contrib.nav_faq" | t(lang), icon: "circle-help" }
], lang) }}</div>

{#- ---------- Why write (+ who from our Area got published → /published/) ---------- -#}
<section id="why" class="section container-page pt-10 sm:pt-12" aria-labelledby="why-title">
  {{ ui.sectionHead("read.contrib.why_title" | t(lang), "read.contrib.why_sub" | t(lang), "", "", "heart-handshake", { eyebrow: "read.contrib.why_eyebrow" | t(lang), tone: "text-vine", id: "why-title", lang: lang }) }}
  <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
    {% for w in [["message-circle-heart", "bg-gv-soft text-gv", "why1"], ["sprout", "bg-vine-soft text-vine", "why2"], ["globe", "bg-lv-soft text-lv", "why3"]] %}
    <div class="card card-pad">
      <span class="grid size-11 place-items-center rounded-xl {{ w[1] }}">{% icon w[0], "size-5" %}</span>
      <h3 class="h-card mt-3 text-xl">{{ ("read.contrib." + w[2] + "_t") | t(lang) }}</h3>
      <p class="mt-2 leading-relaxed text-muted">{{ ("read.contrib." + w[2]) | t(lang) }}</p>
    </div>
    {% endfor %}
  </div>
  <div class="mt-5">{{ spotCard(db.spotlight | readSpotlight, lang, "contrib") }}</div>
</section>

{#- ---------- What you can send: your story across the row, then the other four ways ---------- -#}
<section id="what" class="section container-page pt-0" aria-labelledby="what-title">
  {{ ui.sectionHead("read.contrib.what_title" | t(lang), "read.contrib.what_sub" | t(lang), "", "", "feather", { eyebrow: "read.contrib.what_eyebrow" | t(lang), id: "what-title", lang: lang }) }}
  <div class="card card-pad grid grid-cols-1 gap-5 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] lg:items-center lg:gap-10">
    <div>
      <span class="grid size-11 place-items-center rounded-xl bg-gv-soft text-gv">{% icon "feather", "size-5" %}</span>
      <h3 class="h-card mt-3 text-2xl">{{ "read.contrib.k_story_t" | t(lang) }}</h3>
      <p class="mt-2 leading-relaxed text-muted">{{ "read.contrib.k_story" | t(lang) }}</p>
    </div>
    <div>
      <ul class="flex flex-wrap gap-2" aria-label="{{ 'read.contrib.k_story_ideas' | t(lang) }}">
        {% for k in ["d1", "d2", "d3", "d4", "d5", "d6", "d7", "d8"] %}<li class="badge-muted text-xs! py-1!">{{ ("read.contrib.dept_" + k) | t(lang) }}</li>{% endfor %}
      </ul>
      <p class="mt-4 flex items-start gap-2 text-sm text-muted">{% icon "lightbulb", "mt-0.5 size-4 shrink-0 text-lv" %}<span>{{ "read.contrib.k_story_tip" | t(lang) }}</span></p>
    </div>
  </div>
  <div class="mt-5 grid grid-cols-1 gap-5 sm:grid-cols-2 xl:grid-cols-4">
    <div class="card card-pad">
      <span class="grid size-11 place-items-center rounded-xl bg-lv-soft text-lv">{% icon "mail", "size-5" %}</span>
      <h3 class="h-card mt-3">{{ "read.contrib.k_letter_t" | t(lang) }}</h3>
      <p class="mt-1 text-sm leading-relaxed text-muted">{{ "read.contrib.k_letter" | t(lang) }}</p>
    </div>
    <div class="card card-pad">
      <span class="grid size-11 place-items-center rounded-xl bg-vine-soft text-vine">{% icon "laugh", "size-5" %}</span>
      <h3 class="h-card mt-3">{{ "read.contrib.k_humor_t" | t(lang) }}</h3>
      <p class="mt-1 text-sm leading-relaxed text-muted">{{ "read.contrib.k_humor" | t(lang) }}</p>
    </div>
    <div class="card card-pad">
      <span class="grid size-11 place-items-center rounded-xl bg-grape-soft text-grape">{% icon "palette", "size-5" %}</span>
      <h3 class="h-card mt-3">{{ "read.contrib.k_art_t" | t(lang) }}</h3>
      <p class="mt-1 text-sm leading-relaxed text-muted">{{ "read.contrib.k_art" | t(lang) }}</p>
      <p class="mt-2 text-sm"><a class="link tap-link" href="{{ gvPhoto }}" target="_blank" rel="noopener">{{ "read.contrib.photo_contest" | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a></p>
    </div>
    <div class="card card-pad">
      <span class="grid size-11 place-items-center rounded-xl bg-gv-soft text-gv">{% icon "mic", "size-5" %}</span>
      <h3 class="h-card mt-3">{{ "read.contrib.k_audio_t" | t(lang) }}</h3>
      <p class="mt-1 text-sm leading-relaxed text-muted">{{ "read.contrib.k_audio" | t(lang) }}</p>
      <p class="mt-2 text-sm"><a class="link tap-link inline-flex items-center gap-1" href="#record">{{ "community.rec.jump" | t(lang) }} {% icon "arrow-down", "size-4" %}</a></p>
    </div>
  </div>
</section>

{#- ---------- How to submit ---------- -#}
<section id="submit" class="section container-page pt-0" aria-labelledby="submit-title">
  {{ ui.sectionHead("read.contrib.how_title" | t(lang), "read.contrib.how_sub" | t(lang), "", "", "send", { eyebrow: "read.contrib.how_eyebrow" | t(lang), id: "submit-title", lang: lang }) }}
  <div class="grid grid-cols-1 gap-5 lg:grid-cols-2 lg:gap-6">
    {% for p in pubOrder %}{{ submitPanel(p, lang) }}{% endfor %}
  </div>
</section>

{#- ---------- Record your story by phone: the ONE home of the story lines (db.audio_project) ----------
    Side by side the two cards are the same height (the grid stretches them; one column where they
    would be narrow — below 1024px, and on larger screens at large text: community.css .cm-rec-pair).
    La Viña's is the longer one (it has the sentence to say): in Grapevine's the steps stay at the
    top, the links at the bottom (the official-page buttons line up) and the extra height is shared
    by the gaps around its "Or record it yourself" box and notes (recordCard, .cm-rec-body). -#}
<section id="record" class="section container-page cm-pairs pt-0" aria-labelledby="record-title">
  {{ ui.sectionHead("community.rec.title" | t(lang), "community.rec.sub" | t(lang), "", "", "mic", { eyebrow: "community.rec.eyebrow" | t(lang), tone: "text-grape", id: "record-title", lang: lang }) }}
  <div class="cm-rec-pair">
    {% for p in pubOrder %}{{ recordCard(p, ap[p], lang) }}{% endfor %}
  </div>
</section>

{#- ---------- Editorial themes & deadlines (db.editorial; a band) ---------- -#}
<section id="deadlines" class="section section-band" aria-labelledby="deadlines-title">
  <div class="container-page cm-pairs">
    {% call ui.sectionHead("read.contrib.deadlines_title" | t(lang), "read.contrib.deadlines_sub" | t(lang), "", "", "calendar-clock", { eyebrow: "read.contrib.deadlines_eyebrow" | t(lang), id: "deadlines-title", lang: lang }) %}{% if gvEd.total or lvEd.total %}{{ ui.freshness(db.editorial.updated, lang) }}{% endif %}{% endcall %}
    {% if gvEd.total or lvEd.total %}
    {#- side by side the two cards are the same height (stretched; one column where they would be
        narrow — below 1024px, and on larger screens at large text: community.css .cm-dl-pair): the
        notes at their feet line up, Grapevine's "Recently closed" sits at its bottom (mt-auto) and
        La Viña's topic tiles grow to fill its card (their words stay centred in them: topicChip) -#}
    <div class="cm-dl-pair">
      {% for p in pubOrder %}
        {% if p == "lv" %}{{ themeList(lvEd, "lv", lang, lvCalendar, lvEd.calendarPdf or (lvTopicsPdf.url if lvTopicsPdf else "")) }}{% else %}{{ themeList(gvEd, "gv", lang, gvCalendar, gvEd.calendarPdf) }}{% endif %}
      {% endfor %}
    </div>
    {% else %}
      {{ ui.emptyState("calendar-clock", "read.contrib.no_themes" | t(lang), "read.contrib.no_themes_text" | t(lang), gvCalendar, "read.contrib.gv_calendar" | t(lang)) }}
      <p class="mt-3 text-center text-sm"><a class="link tap-link" href="{{ lvCalendar }}" target="_blank" rel="noopener">{{ "read.contrib.lv_calendar" | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a></p>
    {% endif %}
    {#- Under both cards (not inside them, so the pair stays equal): the committee's printable flyers -#}
    {% if storyFlyers | length %}
    <p class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-muted">
      <span class="inline-flex items-center gap-1.5 font-semibold text-ink"><span class="text-vine">{% icon "printer", "size-4" %}</span>{{ ("read.contrib.print_flyer" if storyFlyers | length == 1 else "read.contrib.print_flyers") | t(lang) }}</span>
      {%- for f in storyFlyers %}
      {%- set ft = f | tx("title", lang) %}
      <a class="link tap-link" href="{{ f.extra.view_url or f.url }}" target="_blank" rel="noopener"{% if f.lang and f.lang != lang and ft == f.title %} lang="{{ f.lang }}"{% endif %}>{{ ft }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a>{% if not loop.last %}<span aria-hidden="true">·</span>{% endif %}
      {%- endfor %}
    </p>
    {% endif %}
  </div>
</section>

{#- ---------- Tips + anonymity (a short companion that sticks beside the tips from 1024px) ---------- -#}
<section id="tips" class="section container-page" aria-labelledby="tips-title">
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-[minmax(0,1.35fr)_minmax(0,1fr)] lg:gap-10 2xl:grid-cols-[minmax(0,1fr)_30rem] 2xl:gap-12">
    <div class="@container">
      {{ ui.sectionHead("read.contrib.tips_title" | t(lang), "read.contrib.tips_sub" | t(lang), "", "", "lightbulb", { eyebrow: "read.contrib.tips_eyebrow" | t(lang), tone: "text-lv", id: "tips-title", lang: lang }) }}
      <ol class="grid grid-cols-1 gap-3 @lg:grid-cols-2 @6xl:grid-cols-4" role="list">
        {% for n in range(1, 9) %}
        <li class="card flex gap-3 p-4">
          <span class="step-num" aria-hidden="true">{{ n }}</span>
          <div><p class="font-semibold leading-snug text-ink"><span class="sr-only">{{ n }}. </span>{{ ("read.contrib.tip" + n + "_t") | t(lang) }}</p><p class="mt-1 text-sm leading-relaxed text-muted">{{ ("read.contrib.tip" + n) | t(lang) }}</p></div>
        </li>
        {% endfor %}
      </ol>
    </div>
    <aside class="sticky-aside" aria-labelledby="anon-title">
      <div class="card card-pad border-vine/30">
        <h2 id="anon-title" class="card-h"><span class="text-vine">{% icon "shield-check", "size-5" %}</span>{{ "read.contrib.anon_title" | t(lang) }}</h2>
        <p class="mt-2 leading-relaxed text-muted">{{ "read.contrib.anon_text" | t(lang) }}</p>
        <ul class="mt-4 space-y-3 text-sm" role="list">
          {% for n in range(1, 5) %}
          <li class="flex gap-2.5"><span class="mt-0.5 text-vine">{% icon "circle-check", "size-4" %}</span><span class="leading-relaxed text-ink">{{ ("read.contrib.anon" + n) | t(lang) }}</span></li>
          {% endfor %}
        </ul>
        <div class="mt-5 rounded-xl bg-surface-2 p-4 text-sm">
          <p class="eyebrow">{{ "read.contrib.sign_example" | t(lang) }}</p>
          <p class="mt-1 font-display text-lg italic text-ink">{{ "read.contrib.sign_sample" | t(lang) }}</p>
        </div>
      </div>
    </aside>
  </div>
</section>

{#- ---------- Writing workshop invitation (the page's one feature band) ---------- -#}
<section id="workshop" class="section container-page pt-0" aria-labelledby="workshop-title">
  <div class="read-cover--gv relative isolate overflow-hidden rounded-[1.5rem] px-6 py-10 text-white sm:px-10 sm:py-12">
    <svg class="page-hero-vine top-4!" viewBox="0 0 400 260" fill="none" aria-hidden="true">
      <path d="M-10 60 C 80 20, 150 110, 240 70 S 380 40, 420 90" stroke="#c9a57a" stroke-width="5" stroke-linecap="round"/>
      <g fill="#8e6cc9"><circle cx="114" cy="150" r="9"/><circle cx="131" cy="150" r="9"/><circle cx="122" cy="165" r="9"/><circle cx="105" cy="165" r="9"/><circle cx="139" cy="165" r="9"/><circle cx="113" cy="180" r="9"/><circle cx="130" cy="180" r="9"/><circle cx="122" cy="195" r="9"/></g>
    </svg>
    <div class="relative z-10 grid grid-cols-1 items-center gap-8 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <p class="eyebrow flex items-center gap-2 text-white/75">{% icon "users", "size-4 shrink-0" %}<span>{{ "read.contrib.ws_eyebrow" | t(lang) }}</span></p>
        <h2 id="workshop-title" class="h-display mt-2 text-3xl text-balance text-white sm:text-4xl">{{ "read.contrib.ws_title" | t(lang) }}</h2>
        <p class="mt-3 max-w-xl text-lg leading-relaxed text-white/85">{{ "read.contrib.ws_text" | t(lang) }}</p>
        <div class="mt-6 flex flex-wrap gap-2 sm:gap-3">
          <a class="btn-light" href="{{ '/events/' | lurl(lang) }}">{% icon "calendar-days", "size-4" %} {{ "read.contrib.ws_events" | t(lang) }}</a>
          <a class="btn-on-dark" href="{{ '/meetings/' | lurl(lang) }}">{% icon "video", "size-4" %} {{ "read.contrib.ws_meeting" | t(lang) }}</a>
        </div>
      </div>
      <div class="rounded-2xl bg-white/10 p-5 ring-1 ring-white/15 backdrop-blur">
        <p class="text-sm font-semibold text-white">{{ "read.contrib.ws_kit" | t(lang) }}</p>
        {% if writerPdfs.length %}
        <ul class="mt-3 space-y-1">
          {% for p in writerPdfs %}
          {%- set info = p | readPdfTitleInfo(lang) -%}
          {%- set dl = p | readDocLang -%}
          <li><a class="flex min-h-11 items-center gap-3 rounded-xl px-2 py-1.5 text-white/90 no-underline transition hover:bg-white/10" href="{{ p.url }}" target="_blank" rel="noopener">
            <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-white/15">{% icon "file-text", "size-4" %}</span>
            <span class="min-w-0 flex-1">
              <span class="block text-sm font-medium" lang="{{ info.lang }}">{{ info.title }}</span>
              {% if info.gloss %}<span class="block text-xs text-white/70"><span class="sr-only">{{ ("common.auto_translated" if info.machine else "read.title_translation") | t(lang) }}:</span><span lang="{{ info.glossLang }}">{{ info.gloss }}</span></span>{% endif %}
            </span>
            <span class="rounded-md bg-white/15 px-1.5 py-0.5 text-[0.65rem] font-bold uppercase text-white/85"{% if dl %} title="{{ ('lang.' + dl) | t(lang) }}"{% endif %}>{% if dl %}{{ dl }}{% else %}{% icon "file-down", "block size-3.5" %}{% endif %}</span>
            <span class="sr-only">({{ "kind.pdf" | t(lang) | lower }}, {{ "common.external" | t(lang) }})</span>
          </a></li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="mt-2 text-sm text-white/75">{{ "read.contrib.ws_kit_empty" | t(lang) }}</p>
        <a class="btn-on-dark btn-sm mt-3" href="{{ L.gvr_resources }}" target="_blank" rel="noopener">{{ "read.contrib.ws_kit_link" | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a>
        {% endif %}
      </div>
    </div>
    {#- The next writing / recording workshops (cmWorkshops): a date tile in the event's colour
        (eventTone), the title and the place; each opens its card on /events/. A workshop that has
        ended hides itself (data-cm-expire, read.js), and the list with it when none is left. -#}
    {% if workshops | length %}
    <div class="relative z-10 mt-8 border-t border-white/15 pt-6" data-ws-list>
      <h3 class="eyebrow flex items-center gap-2 font-sans text-white/75">{% icon "calendar-days", "size-4 shrink-0" %}<span>{{ "read.contrib.ws_next" | t(lang) }}</span></h3>
      <ul class="read-ws-list mt-3 grid gap-3{{ ' max-w-xl' if workshops | length == 1 }}" style="--n: {{ workshops | length }}" role="list">
        {% for ev in workshops %}
        <li data-cm-expire="{{ ev.expireIso }}">
          <a href="{{ '/events/' | lurl(lang) }}#{{ ev.anchor }}" class="card card-link cm-mini-card ev-accent ev-tone-{{ ev | eventTone }} group h-full">
            <span class="cm-date-tile{{ ' cm-tile-range' if ev.tile.range }}" aria-hidden="true"><span class="cm-tile-mon">{{ ev.tile.mon }}</span><span class="cm-tile-day">{{ ev.tile.day }}</span><span class="cm-tile-wd">{{ ev.tile.wd }}</span></span>
            <span class="min-w-0">
              <span class="block font-display text-lg font-semibold leading-snug text-ink group-hover:text-gv">{{ ev.title }}</span>
              <span class="sr-only">{{ ev.dateLabel }}</span>
              {% if ev.location %}<span class="mt-1 flex items-start gap-1.5 text-sm text-muted{{ ' italic' if ev.locationTba }}">{% set wsIcon = "hourglass" if ev.locationTba else "map-pin" %}{% icon wsIcon, "mt-0.5 size-4 shrink-0 text-faint" %}<span class="min-w-0">{{ ev.location }}</span></span>
              {% elif ev.isOnline %}<span class="mt-1 flex items-start gap-1.5 text-sm text-muted">{% icon "video", "mt-0.5 size-4 shrink-0 text-faint" %}<span class="min-w-0">{{ ("committee.events.online_on" | t(lang, { platform: ev.platform })) if ev.platform else ("committee.events.online" | t(lang)) }}</span></span>{% endif %}
              {% if ev.tentative %}<span class="mt-1.5 block">{{ ui.tentativeBadge(lang) }}</span>{% endif %}
            </span>
          </a>
        </li>
        {% endfor %}
      </ul>
    </div>
    {% endif %}
  </div>
</section>

{#- ---------- FAQ ---------- -#}
<section id="faq" class="section container-page pt-0" aria-labelledby="faq-title">
  {{ ui.sectionHead("read.contrib.faq_title" | t(lang), "read.contrib.faq_sub" | t(lang), "", "", "circle-help", { eyebrow: "read.contrib.nav_faq" | t(lang), id: "faq-title", lang: lang }) }}
  <div class="grid grid-cols-1 items-start gap-3 lg:grid-cols-2 2xl:grid-cols-3">
    {% for n in range(1, 7) %}
    <details class="read-faq card group/faq">
      <summary class="flex min-h-14 cursor-pointer items-center justify-between gap-3 rounded-[var(--radius-card)] px-5 py-4 font-semibold text-ink">
        <span>{{ ("read.contrib.faq" + n + "_q") | t(lang) }}</span>
        <span class="grid size-8 shrink-0 place-items-center rounded-full bg-surface-2 text-muted transition group-open/faq:rotate-45">{% icon "plus", "size-4" %}</span>
      </summary>
      <p class="px-5 pb-5 leading-relaxed text-muted">{{ ("read.contrib.faq" + n + "_a") | t(lang) }}</p>
      {% if n == 6 %}<p class="-mt-3 px-5 pb-5 text-sm"><a class="link tap-link inline-flex items-center gap-1" href="#record">{{ "community.rec.jump" | t(lang) }} {% icon "arrow-up", "size-4" %}</a></p>{% endif %}
    </details>
    {% endfor %}
  </div>
</section>

{#- ---------- Closing call to action: send it (the page-language magazine first) ---------- -#}
<section class="section container-page pt-0" aria-labelledby="cta-title">
  <div class="read-cta rounded-[1.5rem] border border-line px-6 py-10 text-center sm:px-10 sm:py-12">
    <p class="eyebrow flex items-center justify-center gap-2 text-gv">{% icon "send", "size-4 shrink-0" %}<span>{{ "read.contrib.cta_eyebrow" | t(lang) }}</span></p>
    <h2 id="cta-title" class="h-section mt-2 text-balance">{{ "read.contrib.cta_title" | t(lang) }}</h2>
    <p class="mx-auto mt-2 max-w-xl leading-relaxed text-muted">{{ "read.contrib.cta_text" | t(lang) }}</p>
    <div class="mx-auto mt-6 grid max-w-md grid-cols-1 gap-2 sm:flex sm:max-w-none sm:justify-center sm:gap-3">
      {% for p in pubOrder %}
      <a class="{{ 'btn-lv' if p == 'lv' else 'btn-primary' }}" href="{{ L.lv_share_story if p == 'lv' else L.gv_share_story }}" target="_blank" rel="noopener">{% icon "send", "size-4" %} {{ ("read.contrib.send_lv" if p == "lv" else "read.contrib.send_gv") | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a>
      {% endfor %}
    </div>
  </div>
</section>
