---
pagination: { data: languages, size: 1, alias: lang }
permalink: "{{ '/' if lang == 'en' else '/es/' }}contribute/index.html"
layout: layouts/base.njk
pageKey: contribute
titleKey: nav.contribute
descKey: read.contrib.meta_desc
pageScripts: ["/assets/js/read.js"]
---
{#- SHARE YOUR STORY — why write, what to send, how to submit to Grapevine and
    La Viña, upcoming editorial themes & deadlines (db.editorial, synced daily),
    writing tips, anonymity, writing workshops. -#}
{% import "macros/ui.njk" as ui with context %}
{%- set L = site.links -%}
{%- set gvEd = db.editorial.items | readEditorial("gv", lang) -%}
{%- set lvEd = db.editorial.items | readEditorial("lv", lang) -%}
{%- set gvCalendar = L.gv_contribute or (site.sources.grapevine.base + site.sources.grapevine.contribute) -%}
{%- set lvCalendar = site.sources.lavina.base + site.sources.lavina.contribute -%}
{%- set gvAudio = L.gv_audio_project or (L.gv_home + "/audioproject") -%}
{%- set gvPhoto = L.gv_photo_contest or (L.gv_home + "/photocontest") -%}
{%- set writerPdfs = db.pdfs | readWriterKit(4) -%}
{%- set lvTopicsPdf = (db.pdfs | readPdfsMatching("temas de lv|temas sugeridos", 1))[0] -%}
{%- set pubOrder = ["lv", "gv"] if lang == "es" else ["gv", "lv"] -%}

{#- Deadline attributes shared by every countdown element (live-updated by read.js) -#}
{% macro dlAttrs(r, lang) -%}
data-deadline="{{ r.deadline }}" data-t-days="{{ 'read.contrib.due_in' | t(lang) }}" data-t-today="{{ 'read.contrib.due_today' | t(lang) }}" data-t-tomorrow="{{ 'read.contrib.due_tomorrow' | t(lang) }}" data-t-past="{{ 'read.contrib.due_past' | t(lang) }}" data-t-unit1="{{ 'read.contrib.day' | t(lang) }}" data-t-unitn="{{ 'read.contrib.days' | t(lang) }}"
{%- endmacro %}

{% macro dueText(r, lang) -%}
{%- if r.days === none %}{{ "read.contrib.no_deadline" | t(lang) }}
{%- elif r.days < 0 %}{{ "read.contrib.due_past" | t(lang) }}
{%- elif r.days == 0 %}{{ "read.contrib.due_today" | t(lang) }}
{%- elif r.days == 1 %}{{ "read.contrib.due_tomorrow" | t(lang) }}
{%- else %}{{ "read.contrib.due_in" | t(lang, {n: r.days}) }}{% endif -%}
{%- endmacro %}

{#- One publication's editorial calendar: dated themes (Grapevine) and/or
    open-ended suggested topics (La Viña), plus recently closed deadlines. -#}
{% macro themeList(ed, pub, lang, calUrl, calPdf) %}
{%- set isLv = pub == "lv" -%}
<div class="card flex flex-col overflow-hidden {{ 'read-accent-lv' if isLv else 'read-accent-gv' }}">
  <div class="flex flex-wrap items-center justify-between gap-x-3 gap-y-1 border-b border-line px-5 py-4 sm:px-6">
    <h3 class="flex items-center gap-2 font-display text-xl font-semibold">
      <span class="grid size-9 place-items-center rounded-xl {{ 'bg-lv-soft text-lv' if isLv else 'bg-gv-soft text-gv' }}">{% icon "grapes", "size-5" %}</span>
      {{ "La Viña" if isLv else "Grapevine" }}
    </h3>
    <p class="flex flex-wrap items-center gap-x-4 text-sm font-semibold {{ 'text-lv' if isLv else 'text-gv' }}">
      {% if calPdf %}<a class="inline-flex min-h-10 items-center gap-1 hover:underline" href="{{ calPdf }}" target="_blank" rel="noopener">{% icon "file-down", "size-4" %} {{ ("read.contrib.lv_topics_pdf" if isLv else "read.contrib.calendar_pdf") | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a>{% endif %}
      <a class="inline-flex min-h-10 items-center gap-1 hover:underline" href="{{ calUrl }}" target="_blank" rel="noopener">{{ ("read.contrib.lv_list" if isLv else "read.contrib.full_calendar") | t(lang) }} {% icon "arrow-up-right", "size-4" %}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a>
    </p>
  </div>
  <div class="flex flex-1 flex-col gap-3 p-4 sm:p-5">
    {% for r in ed.upcoming %}
      {% if r.isNext %}
      <div class="read-deadline-next read-deadline-row rounded-2xl border border-line bg-surface-2 p-4 pl-5 sm:p-5 sm:pl-6" data-deadline-row {{ dlAttrs(r, lang) }}>
        <p class="eyebrow {{ 'text-lv' if isLv else 'text-gv' }}">{{ "read.contrib.next_deadline" | t(lang) }}</p>
        <div class="mt-2 flex items-start gap-4">
          <div class="read-num grid min-w-[4.75rem] shrink-0 place-items-center rounded-2xl px-2 py-2.5 text-center {{ 'bg-lv text-white dark:text-paper' if isLv else 'bg-gv text-white dark:text-paper' }}">
            <span class="font-display text-4xl font-semibold leading-none" data-days-num>{{ r.days }}</span>
            <span class="mt-1 text-[0.68rem] font-semibold uppercase tracking-wider opacity-90" data-days-unit>{{ ("read.contrib.day" if r.days == 1 else "read.contrib.days") | t(lang) }}</span>
          </div>
          <div class="min-w-0 flex-1">
            <p class="font-display text-xl font-semibold leading-snug text-ink" lang="{{ r.themeLang }}">{{ r.theme }}</p>
            {% if r.original %}<p class="flex items-center gap-1 text-xs italic text-muted">{% if r.machine %}{% icon "languages", "size-3 shrink-0" %}<span class="sr-only">{{ "common.auto_translated" | t(lang) }}:</span>{% endif %}<span lang="{{ r.origLang }}">{{ r.original }}</span></p>{% endif %}
            {% if r.issueLabel %}<p class="mt-1 text-sm text-muted">{{ "read.contrib.for_issue" | t(lang, {issue: r.issueLabel}) }}</p>{% endif %}
            <p class="mt-1 text-sm font-semibold text-ink"><time datetime="{{ r.deadline }}" class="read-deadline-date">{{ r.deadline | fmtDate(lang, "medium") }}</time> · <span data-days-label>{{ dueText(r, lang) }}</span></p>
          </div>
        </div>
        {% if r.summary %}<p class="mt-3 line-clamp-4 text-sm leading-relaxed text-muted" lang="{{ r.summaryLang }}">{{ r.summary }}</p>{% endif %}
        {% if r.summaryMachine %}<p class="auto-note mt-2" title="{{ 'common.auto_translated_help' | t(lang) }}">{% icon "languages", "size-3" %} {{ "common.auto_translated" | t(lang) }}</p>{% endif %}
      </div>
      {% else %}
      <div class="read-deadline-row flex items-start gap-3 rounded-xl px-2 py-2" data-deadline-row {% if r.deadline %}{{ dlAttrs(r, lang) }}{% endif %}>
        <span class="read-num grid w-14 shrink-0 place-items-center rounded-xl border border-line bg-surface py-1.5 text-center leading-tight">
          {% if r.deadline %}<span class="text-[0.65rem] font-semibold uppercase {{ 'text-lv' if isLv else 'text-gv' }}">{{ r.deadline | fmtDate(lang, "monthShort") }}</span><span class="font-display text-xl font-semibold text-ink">{{ r.deadline | fmtDate(lang, "day") }}</span>
          {% else %}<span class="py-1.5 text-muted">{% icon "calendar-range", "size-5" %}</span>{% endif %}
        </span>
        <div class="min-w-0 flex-1">
          <p class="font-semibold leading-snug text-ink"><span lang="{{ r.themeLang }}">{{ r.theme }}</span>{% if r.machine %} <span class="auto-note align-middle" title="{{ 'common.auto_translated' | t(lang) }} — {{ 'common.auto_translated_help' | t(lang) }}">{% icon "languages", "size-3" %}<span class="sr-only">{{ "common.auto_translated" | t(lang) }}</span></span>{% endif %}</p>
          {% if r.original %}<p class="text-xs italic text-muted" lang="{{ r.origLang }}">{{ r.original }}</p>{% endif %}
          <p class="text-xs text-muted">{% if r.issueLabel %}{{ "read.contrib.for_issue" | t(lang, {issue: r.issueLabel}) }} · {% endif %}<span data-days-label>{{ dueText(r, lang) }}</span></p>
        </div>
      </div>
      {% endif %}
    {% endfor %}

    {% if ed.evergreen.length %}
    {%- set EV_SHOW = 8 -%}
    <div class="{{ 'mt-1 border-t border-line pt-4' if ed.upcoming.length }}">
      <p class="flex items-center gap-2 font-semibold text-ink"><span class="{{ 'text-lv' if isLv else 'text-gv' }}">{% icon "feather", "size-5" %}</span>{{ "read.contrib.evergreen_title" | t(lang) }}</p>
      <p class="mt-0.5 text-sm text-muted">{{ ("read.contrib.evergreen_sub_lv" if isLv else "read.contrib.evergreen_sub_gv") | t(lang) }}</p>
      <ul class="mt-3 grid grid-cols-1 gap-2 sm:grid-cols-2">
        {% for r in ed.evergreen | limit(EV_SHOW) %}{{ topicChip(r, lang, isLv) }}{% endfor %}
      </ul>
      {% if ed.evergreen.length > EV_SHOW %}
      <details class="read-more group/ev mt-2">
        <summary class="btn-ghost btn-sm cursor-pointer {{ 'text-lv' if isLv else 'text-gv' }}">
          <span class="group-open/ev:hidden">{{ "read.contrib.all_topics" | t(lang, {n: ed.evergreen.length}) }}</span>
          <span class="hidden group-open/ev:inline">{{ "common.show_less" | t(lang) }}</span>
          {% icon "chevron-down", "size-4 transition group-open/ev:rotate-180" %}
        </summary>
        <ul class="mt-1 grid grid-cols-1 gap-2 sm:grid-cols-2">
          {% for r in ed.evergreen | offset(EV_SHOW) %}{{ topicChip(r, lang, isLv) }}{% endfor %}
        </ul>
      </details>
      {% endif %}
    </div>
    {% endif %}

    {% if not ed.upcoming.length and not ed.evergreen.length %}
      <div class="empty-state flex-1 p-6">
        <span class="mx-auto mb-3 grid size-12 place-items-center rounded-full bg-surface-2 {{ 'text-lv' if isLv else 'text-gv' }}">{% icon "feather", "size-6" %}</span>
        <p class="font-semibold text-ink">{{ "read.contrib.no_upcoming" | t(lang) }}</p>
        <p class="mx-auto mt-1 max-w-sm text-sm">{{ "read.contrib.no_upcoming_text" | t(lang) }}</p>
        <a class="btn-secondary btn-sm mt-4" href="{{ calUrl }}" target="_blank" rel="noopener">{{ ("read.contrib.lv_list" if isLv else "read.contrib.full_calendar") | t(lang) }}</a>
      </div>
    {% endif %}

    {% if ed.past.length %}
    <div class="mt-auto border-t border-line pt-3">
      <p class="flex items-center gap-1.5 px-2 text-xs font-semibold uppercase tracking-wider text-muted">{% icon "history", "size-3.5" %} {{ "read.contrib.recent_past" | t(lang) }}</p>
      <div class="mt-1 space-y-0.5">
        {% for r in ed.past %}
        <div class="read-deadline-row is-past flex items-center justify-between gap-3 rounded-lg px-2 py-1.5 text-sm" data-deadline-row>
          <span class="min-w-0 text-ink" lang="{{ r.themeLang }}">{{ r.theme }}</span>
          <time class="read-deadline-date shrink-0 text-xs text-muted" datetime="{{ r.deadline }}">{{ r.deadline | fmtDate(lang, "short") }}</time>
        </div>
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </div>
  <p class="border-t border-line bg-surface-2 px-5 py-3 text-xs leading-relaxed text-muted sm:px-6">{{ ("read.contrib.lv_note" if isLv else "read.contrib.gv_note") | t(lang) }}</p>
</div>
{% endmacro %}

{#- One open-ended suggested topic -#}
{% macro topicChip(r, lang, isLv) %}
<li class="flex items-start gap-2.5 rounded-xl border border-line bg-surface px-3 py-2.5">
  <span class="mt-0.5 shrink-0 {{ 'text-lv' if isLv else 'text-gv' }}">{% icon "pen-line", "size-4" %}</span>
  <span class="min-w-0">
    <span class="block text-sm font-semibold leading-snug text-ink" lang="{{ r.themeLang }}">{{ r.theme }}{% if r.machine %} <span class="auto-note align-middle" title="{{ 'common.auto_translated' | t(lang) }} — {{ 'common.auto_translated_help' | t(lang) }}">{% icon "languages", "size-3" %}<span class="sr-only">{{ "common.auto_translated" | t(lang) }}</span></span>{% endif %}</span>
    {% if r.original %}<span class="block text-xs italic text-muted" lang="{{ r.origLang }}">{{ r.original }}</span>{% endif %}
  </span>
</li>
{% endmacro %}

{#- How-to-submit panel for one magazine -#}
{% macro submitPanel(pub, lang) %}
{%- set isLv = pub == "lv" -%}
{%- set email = L.lv_email_editorial if isLv else L.gv_email_editorial -%}
{%- set mail = L.lv_mail if isLv else L.gv_mail -%}
<div class="card flex flex-col overflow-hidden">
  <div class="read-cover {{ 'read-cover--lv' if isLv else 'read-cover--gv' }} relative isolate overflow-hidden px-6 py-6 text-white sm:px-7">
    <svg class="read-cover-art w-40!" viewBox="0 0 200 240" fill="none" aria-hidden="true"><g fill="currentColor"><circle cx="82" cy="96" r="17"/><circle cx="116" cy="96" r="17"/><circle cx="66" cy="126" r="17"/><circle cx="100" cy="126" r="17"/><circle cx="134" cy="128" r="17"/><circle cx="82" cy="156" r="17"/><circle cx="116" cy="156" r="17"/><circle cx="100" cy="186" r="17"/></g></svg>
    <p class="text-xs font-semibold uppercase tracking-[0.18em] text-white/70">{{ ("read.contrib.lv_lang" if isLv else "read.contrib.gv_lang") | t(lang) }}</p>
    <h3 class="mt-1 font-display text-2xl font-semibold">{{ ("read.contrib.send_lv" if isLv else "read.contrib.send_gv") | t(lang) }}</h3>
    <a class="btn-light mt-4" href="{{ L.lv_share_story if isLv else L.gv_share_story }}" target="_blank" rel="noopener">{% icon "send", "size-4" %} {{ "read.contrib.submit_online" | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a>
  </div>
  <dl class="flex flex-1 flex-col divide-y divide-line">
    <div class="flex items-start gap-3 px-6 py-4 sm:px-7">
      <dt class="mt-0.5 {{ 'text-lv' if isLv else 'text-gv' }}">{% icon "mail", "size-5" %}<span class="sr-only">{{ "read.contrib.by_email" | t(lang) }}</span></dt>
      <dd class="min-w-0 flex-1">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted">{{ "read.contrib.by_email" | t(lang) }}</p>
        <div class="mt-1 flex items-center justify-between gap-2">
          <a class="link min-w-0 break-all" href="mailto:{{ email }}">{{ email }}</a>
          <button type="button" class="btn-ghost btn-sm -my-1 min-h-9! shrink-0 px-2.5!" data-copy="{{ email }}" aria-label="{{ 'common.copy' | t(lang) }}: {{ email }}">{% icon "copy", "size-4" %}</button>
        </div>
      </dd>
    </div>
    <div class="flex items-start gap-3 px-6 py-4 sm:px-7">
      <dt class="mt-0.5 {{ 'text-lv' if isLv else 'text-gv' }}">{% icon "stamp", "size-5" %}<span class="sr-only">{{ "read.contrib.by_mail" | t(lang) }}</span></dt>
      <dd class="min-w-0 flex-1">
        <p class="text-xs font-semibold uppercase tracking-wider text-muted">{{ "read.contrib.by_mail" | t(lang) }}</p>
        <div class="mt-1 flex items-start justify-between gap-2">
          <address class="min-w-0 not-italic text-ink">{{ mail }}</address>
          <button type="button" class="btn-ghost btn-sm -my-1 min-h-9! shrink-0 px-2.5!" data-copy="{{ mail }}" aria-label="{{ 'common.copy' | t(lang) }}: {{ mail }}">{% icon "copy", "size-4" %}</button>
        </div>
      </dd>
    </div>
    <div class="flex items-start gap-3 px-6 py-4 sm:px-7">
      <dt class="mt-0.5 {{ 'text-lv' if isLv else 'text-gv' }}">{% icon "book-marked", "size-5" %}<span class="sr-only">{{ "read.contrib.guidelines" | t(lang) }}</span></dt>
      <dd class="flex flex-wrap gap-x-4 gap-y-1">
        <a class="link" href="{{ L.lv_guidelines if isLv else L.gv_guidelines }}" target="_blank" rel="noopener">{{ "read.contrib.guidelines" | t(lang) }}</a>
        <a class="link" href="{{ lvCalendar if isLv else gvCalendar }}" target="_blank" rel="noopener">{{ "read.contrib.themes_link" | t(lang) }}</a>
        {% if not isLv %}<a class="link" href="{{ gvAudio }}" target="_blank" rel="noopener">{{ "read.contrib.audio_project" | t(lang) }}</a>{% endif %}
      </dd>
    </div>
  </dl>
</div>
{% endmacro %}

{% call ui.pageHero(lang, "read.contrib.title" | t(lang), "read.contrib.subtitle" | t(lang), "pen-line", "read.contrib.eyebrow" | t(lang)) %}
  <div class="flex flex-wrap gap-2.5">
    {% for p in pubOrder %}
    <a class="{{ 'btn-light' if loop.first else 'btn-on-dark' }}" href="{{ L.lv_share_story if p == 'lv' else L.gv_share_story }}" target="_blank" rel="noopener">{% icon "send", "size-4" %} {{ ("read.contrib.send_lv" if p == "lv" else "read.contrib.send_gv") | t(lang) }}</a>
    {% endfor %}
    <a class="btn-on-dark" href="#deadlines">{% icon "calendar-clock", "size-4" %} {{ "read.contrib.see_themes" | t(lang) }}</a>
  </div>
{% endcall %}

{#- ---------- Why write ---------- -#}
<section class="section container-page pt-6 sm:pt-8" aria-labelledby="why-title">
  {{ ui.sectionHead("read.contrib.why_title" | t(lang), "read.contrib.why_sub" | t(lang), "", "", "heart-handshake") }}
  <div class="grid grid-cols-1 gap-5 md:grid-cols-3">
    {% for w in [["message-circle-heart", "bg-gv-soft text-gv", "why1"], ["sprout", "bg-vine-soft text-vine", "why2"], ["globe", "bg-lv-soft text-lv", "why3"]] %}
    <div class="card card-pad">
      <span class="grid size-12 place-items-center rounded-2xl {{ w[1] }}">{% icon w[0], "size-6" %}</span>
      <h3 class="h-card mt-4 text-xl">{{ ("read.contrib." + w[2] + "_t") | t(lang) }}</h3>
      <p class="mt-2 leading-relaxed text-muted">{{ ("read.contrib." + w[2]) | t(lang) }}</p>
    </div>
    {% endfor %}
  </div>
</section>

{#- ---------- What you can send ---------- -#}
<section class="section container-page pt-0" aria-labelledby="what-title">
  <h2 id="what-title" class="h-section">{{ "read.contrib.what_title" | t(lang) }}</h2>
  <p class="mt-1.5 mb-6 max-w-2xl text-muted">{{ "read.contrib.what_sub" | t(lang) }}</p>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-6">
    <div class="card card-pad lg:col-span-3 lg:row-span-2 flex flex-col">
      <span class="grid size-12 place-items-center rounded-2xl bg-gv-soft text-gv">{% icon "feather", "size-6" %}</span>
      <h3 class="h-card mt-4 text-2xl">{{ "read.contrib.k_story_t" | t(lang) }}</h3>
      <p class="mt-2 leading-relaxed text-muted">{{ "read.contrib.k_story" | t(lang) }}</p>
      <ul class="mt-4 flex flex-wrap gap-2" aria-label="{{ 'read.contrib.k_story_ideas' | t(lang) }}">
        {% for k in ["d1", "d2", "d3", "d4", "d5", "d6", "d7", "d8"] %}<li class="badge-muted text-xs! py-1!">{{ ("read.contrib.dept_" + k) | t(lang) }}</li>{% endfor %}
      </ul>
      <p class="mt-auto pt-5 text-sm text-muted">{% icon "lightbulb", "size-4 inline -mt-0.5 text-lv" %} {{ "read.contrib.k_story_tip" | t(lang) }}</p>
    </div>
    <div class="card card-pad lg:col-span-3">
      <div class="flex items-start gap-4">
        <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-lv-soft text-lv">{% icon "mail", "size-5" %}</span>
        <div><h3 class="h-card">{{ "read.contrib.k_letter_t" | t(lang) }}</h3><p class="mt-1 text-sm leading-relaxed text-muted">{{ "read.contrib.k_letter" | t(lang) }}</p></div>
      </div>
    </div>
    <div class="card card-pad lg:col-span-3">
      <div class="flex items-start gap-4">
        <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-vine-soft text-vine">{% icon "laugh", "size-5" %}</span>
        <div><h3 class="h-card">{{ "read.contrib.k_humor_t" | t(lang) }}</h3><p class="mt-1 text-sm leading-relaxed text-muted">{{ "read.contrib.k_humor" | t(lang) }}</p></div>
      </div>
    </div>
    <div class="card card-pad lg:col-span-3">
      <div class="flex items-start gap-4">
        <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-grape-soft text-grape">{% icon "palette", "size-5" %}</span>
        <div><h3 class="h-card">{{ "read.contrib.k_art_t" | t(lang) }}</h3><p class="mt-1 text-sm leading-relaxed text-muted">{{ "read.contrib.k_art" | t(lang) }}</p>
          <a class="link mt-2 inline-block text-sm" href="{{ gvPhoto }}" target="_blank" rel="noopener">{{ "read.contrib.photo_contest" | t(lang) }}</a></div>
      </div>
    </div>
    <div class="card card-pad lg:col-span-3">
      <div class="flex items-start gap-4">
        <span class="grid size-11 shrink-0 place-items-center rounded-xl bg-gv-soft text-gv">{% icon "mic", "size-5" %}</span>
        <div><h3 class="h-card">{{ "read.contrib.k_audio_t" | t(lang) }}</h3><p class="mt-1 text-sm leading-relaxed text-muted">{{ "read.contrib.k_audio" | t(lang) }}</p>
          <p class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-sm"><a class="link" href="{{ gvAudio }}" target="_blank" rel="noopener">{{ "read.contrib.audio_project" | t(lang) }}</a><a class="link" href="{{ L.lv_share_story }}" target="_blank" rel="noopener" lang="es">Graba tu historia</a></p></div>
      </div>
    </div>
  </div>
</section>

{#- ---------- How to submit ---------- -#}
<section class="section container-page pt-0" aria-labelledby="how-title" id="submit">
  {{ ui.sectionHead("read.contrib.how_title" | t(lang), "read.contrib.how_sub" | t(lang), "", "", "send") }}
  <div class="grid grid-cols-1 gap-6 lg:grid-cols-2">
    {% for p in pubOrder %}{{ submitPanel(p, lang) }}{% endfor %}
  </div>
</section>

{#- ---------- Editorial themes & deadlines (auto-synced) ---------- -#}
<section class="section scroll-mt-20 border-y border-line bg-surface-2/60" id="deadlines" aria-labelledby="deadlines-title">
  <div class="container-page">
    <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
      <div>
        <h2 id="deadlines-title" class="h-section flex items-center gap-2.5"><span class="text-gv">{% icon "calendar-clock", "size-6" %}</span>{{ "read.contrib.deadlines_title" | t(lang) }}</h2>
        <p class="mt-1.5 max-w-2xl text-muted">{{ "read.contrib.deadlines_sub" | t(lang) }}</p>
      </div>
      <span class="badge-vine py-1!">{% icon "refresh-cw", "size-3" %} {{ "common.updates_daily" | t(lang) }}</span>
    </div>
    {% if gvEd.total or lvEd.total %}
    <div class="grid grid-cols-1 items-start gap-6 lg:grid-cols-2">
      {% for p in pubOrder %}
        {% if p == "lv" %}{{ themeList(lvEd, "lv", lang, lvCalendar, lvEd.calendarPdf or (lvTopicsPdf.url if lvTopicsPdf else "")) }}{% else %}{{ themeList(gvEd, "gv", lang, gvCalendar, gvEd.calendarPdf) }}{% endif %}
      {% endfor %}
    </div>
    {% else %}
      {{ ui.emptyState("calendar-clock", "read.contrib.no_themes" | t(lang), "read.contrib.no_themes_text" | t(lang), gvCalendar, "read.contrib.gv_calendar" | t(lang)) }}
      <p class="mt-3 text-center text-sm"><a class="link" href="{{ lvCalendar }}" target="_blank" rel="noopener">{{ "read.contrib.lv_calendar" | t(lang) }}</a></p>
    {% endif %}
  </div>
</section>

{#- ---------- Tips + anonymity ---------- -#}
<section class="section container-page" aria-labelledby="tips-title">
  <div class="grid grid-cols-1 gap-8 lg:grid-cols-[1.35fr_1fr]">
    <div>
      {{ ui.sectionHead("read.contrib.tips_title" | t(lang), "read.contrib.tips_sub" | t(lang), "", "", "lightbulb") }}
      <ol class="grid grid-cols-1 gap-3 sm:grid-cols-2">
        {% for n in range(1, 9) %}
        <li class="card flex gap-3 p-4">
          <span class="read-num grid size-8 shrink-0 place-items-center rounded-full bg-gv-soft font-display text-sm font-semibold text-gv">{{ n }}</span>
          <div><p class="font-semibold leading-snug text-ink">{{ ("read.contrib.tip" + n + "_t") | t(lang) }}</p><p class="mt-1 text-sm leading-relaxed text-muted">{{ ("read.contrib.tip" + n) | t(lang) }}</p></div>
        </li>
        {% endfor %}
      </ol>
    </div>
    <aside class="lg:pt-2" aria-labelledby="anon-title">
      <div class="card card-pad sticky top-24 border-vine/30">
        <span class="grid size-12 place-items-center rounded-2xl bg-vine-soft text-vine">{% icon "shield-check", "size-6" %}</span>
        <h2 id="anon-title" class="mt-4 font-display text-2xl font-semibold">{{ "read.contrib.anon_title" | t(lang) }}</h2>
        <p class="mt-2 leading-relaxed text-muted">{{ "read.contrib.anon_text" | t(lang) }}</p>
        <ul class="mt-4 space-y-3 text-sm">
          {% for n in range(1, 5) %}
          <li class="flex gap-2.5"><span class="mt-0.5 text-vine">{% icon "circle-check", "size-4" %}</span><span class="leading-relaxed text-ink">{{ ("read.contrib.anon" + n) | t(lang) }}</span></li>
          {% endfor %}
        </ul>
        <div class="mt-5 rounded-xl bg-surface-2 p-4 text-sm">
          <p class="eyebrow">{{ "read.contrib.sign_example" | t(lang) }}</p>
          <p class="mt-1 font-display text-lg italic text-ink">{{ "read.contrib.sign_sample" | t(lang) }}</p>
        </div>
      </div>
    </aside>
  </div>
</section>

{#- ---------- Writing workshop invitation ---------- -#}
<section class="container-page pb-4" aria-labelledby="workshop-title">
  <div class="read-cover--gv relative isolate overflow-hidden rounded-[1.5rem] px-6 py-10 text-white sm:px-10 sm:py-12">
    <svg class="page-hero-vine top-4!" viewBox="0 0 400 260" fill="none" aria-hidden="true">
      <path d="M-10 60 C 80 20, 150 110, 240 70 S 380 40, 420 90" stroke="#c9a57a" stroke-width="5" stroke-linecap="round"/>
      <g fill="#8e6cc9"><circle cx="114" cy="150" r="9"/><circle cx="131" cy="150" r="9"/><circle cx="122" cy="165" r="9"/><circle cx="105" cy="165" r="9"/><circle cx="139" cy="165" r="9"/><circle cx="113" cy="180" r="9"/><circle cx="130" cy="180" r="9"/><circle cx="122" cy="195" r="9"/></g>
    </svg>
    <div class="relative z-10 grid grid-cols-1 items-center gap-8 lg:grid-cols-[1.3fr_1fr]">
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.18em] text-white/70">{{ "read.contrib.ws_eyebrow" | t(lang) }}</p>
        <h2 id="workshop-title" class="mt-2 font-display text-3xl font-semibold leading-tight sm:text-4xl">{{ "read.contrib.ws_title" | t(lang) }}</h2>
        <p class="mt-3 max-w-xl text-lg leading-relaxed text-white/85">{{ "read.contrib.ws_text" | t(lang) }}</p>
        <div class="mt-6 flex flex-wrap gap-2.5">
          <a class="btn-light" href="{{ '/events/' | lurl(lang) }}">{% icon "calendar-days", "size-4" %} {{ "read.contrib.ws_events" | t(lang) }}</a>
          <a class="btn-on-dark" href="{{ '/meeting/' | lurl(lang) }}">{% icon "video", "size-4" %} {{ "read.contrib.ws_meeting" | t(lang) }}</a>
        </div>
      </div>
      <div class="rounded-2xl bg-white/10 p-5 ring-1 ring-white/15 backdrop-blur">
        <p class="text-sm font-semibold text-white">{{ "read.contrib.ws_kit" | t(lang) }}</p>
        {% if writerPdfs.length %}
        <ul class="mt-3 space-y-1">
          {% for p in writerPdfs %}
          {%- set info = p | readPdfTitleInfo(lang) -%}
          {%- set dl = p | readDocLang -%}
          <li><a class="flex min-h-11 items-center gap-3 rounded-xl px-2 py-1.5 text-white/90 no-underline transition hover:bg-white/10" href="{{ p.url }}" target="_blank" rel="noopener">
            <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-white/15">{% icon "file-text", "size-4" %}</span>
            <span class="min-w-0 flex-1">
              <span class="block text-sm font-medium" lang="{{ info.lang }}">{{ info.title }}</span>
              {% if info.gloss %}<span class="block text-xs text-white/70" lang="{{ info.glossLang }}">{{ info.gloss }}</span>{% endif %}
            </span>
            <span class="rounded-md bg-white/15 px-1.5 py-0.5 text-[0.65rem] font-bold uppercase text-white/85"{% if dl %} title="{{ ('lang.' + dl) | t(lang) }}"{% endif %}>{{ dl or "PDF" }}</span>
            <span class="sr-only">(PDF, {{ "common.external" | t(lang) }})</span>
          </a></li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="mt-2 text-sm text-white/75">{{ "read.contrib.ws_kit_empty" | t(lang) }}</p>
        <a class="btn-on-dark btn-sm mt-3" href="{{ L.gvr_resources }}" target="_blank" rel="noopener">{{ "read.contrib.ws_kit_link" | t(lang) }}</a>
        {% endif %}
      </div>
    </div>
  </div>
</section>

{#- ---------- FAQ ---------- -#}
<section class="section container-page" aria-labelledby="faq-title">
  <h2 id="faq-title" class="h-section mb-6">{{ "read.contrib.faq_title" | t(lang) }}</h2>
  <div class="grid grid-cols-1 gap-3 lg:grid-cols-2">
    {% for n in range(1, 7) %}
    <details class="read-faq card group/faq">
      <summary class="flex min-h-14 cursor-pointer items-center justify-between gap-3 px-5 py-4 font-semibold text-ink">
        <span>{{ ("read.contrib.faq" + n + "_q") | t(lang) }}</span>
        <span class="grid size-8 shrink-0 place-items-center rounded-full bg-surface-2 text-muted transition group-open/faq:rotate-45">{% icon "plus", "size-4" %}</span>
      </summary>
      <p class="px-5 pb-5 leading-relaxed text-muted">{{ ("read.contrib.faq" + n + "_a") | t(lang) }}</p>
    </details>
    {% endfor %}
  </div>
</section>
