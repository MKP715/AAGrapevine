  { href: "#record", label: "read.contrib.nav_record" | t(lang), icon: "mic" },
  { href: "#deadlines", label: "read.contrib.nav_deadlines" | t(lang), icon: "calendar-clock" },
  { href: "#tips", label: "read.contrib.nav_tips" | t(lang), icon: "lightbulb" },
