---
pagination: { data: languages, size: 1, alias: lang }
permalink: "{{ '/' if lang == 'en' else '/es/' }}shop/index.html"
layout: layouts/base.njk
pageKey: shop
titleKey: read.subs.title
descKey: read.subs.meta_desc
pageScripts: ["/assets/js/shop.js"]
---
{#- SHOP — the ONE page for buying and subscribing. Order (docs: ui.njk): hero → page nav →
    Book of the Month + bulk discounts (db.shop — eleventy/filters/shop.js) → the two magazines →
    subscription prices → Carry the Message (the one feature band) → home groups + order forms →
    catalogs (db.pdfs) with customer service beside them (one band). Every purchase links to the official stores
    (aagrapevine.org / aalavina.org); prices and dates only ever come from synced data, never typed
    here. Other pages show at most a one-line link here (keep it that way). The old /subscribe/
    address is a redirect stub (subscribe-redirect.njk) that keeps its #anchors (#carry,
    #forms-title, #cat-title); /gvr/ links #cat-title, #forms-title, #carry and #catalogs. -#}
{% import "macros/ui.njk" as ui with context %}
{%- set L = site.links -%}
{%- set catalogs = db.pdfs | readCatalogs(lang) -%}
{%- set ctmPdfs = db.pdfs | readPdfsMatching("\\bctm\\b|carry the message|lleva el mensaje", 3) -%}
{%- set forms = db.pdfs | readForms -%}
{%- set pubOrder = ["lv", "gv"] if lang == "es" else ["gv", "lv"] -%}
{%- set shop = db.shop or {} -%}
{%- set botm = shop | shopBotm(lang) -%}
{%- set subs = shop | shopSubs(lang) -%}
{%- set bulk = shop | shopBulk(lang) -%}
{#- one percent in the heading when every book has the same discount -#}
{%- set pctAll = botm[0].pct if (botm.length and (botm.length == 1 or botm[0].pct == botm[1].pct)) else 0 -%}
{#- the last day of the latest offer (the heading's percent stays until every offer has ended) -#}
{%- set botmLast = "" -%}
{%- for b in botm %}{% if b.ends and b.ends > botmLast %}{% set botmLast = b.ends %}{% endif %}{% endfor -%}
{%- set gvIssues = db.articles | readIssues("gv") -%}
{%- set lvIssues = db.articles | readIssues("lv") -%}
{%- set curIssue = {
  gv: (gvIssues[0] | readIssueView(lang)) if gvIssues.length else null,
  lv: (lvIssues[0] | readIssueView(lang)) if lvIssues.length else null
} -%}

{#- Language of a PDF document (not of its title), shown when it differs from the page -#}
{% macro docPill(p, lang) -%}
{%- set dl = p | readDocLang -%}
{%- if dl and dl != lang %}<span class="badge-muted shrink-0 uppercase" title="{{ ('lang.' + dl) | t(lang) }}">{{ dl }}</span>{% endif -%}
{%- endmacro %}

{#- PDF "cover" card (thumbnail if the sync made one, otherwise a styled placeholder) -#}
{% macro pdfCover(p, lang, aspect="aspect-[4/5]") %}
{%- set pub = p | readPub -%}
{%- set info = p | readPdfTitleInfo(lang) -%}
<a href="{{ p.url }}" target="_blank" rel="noopener" class="card card-link group flex flex-col overflow-hidden no-underline">
  <div class="relative {{ aspect }} overflow-hidden rounded-t-[var(--radius-card)] border-b border-line bg-surface-2">
    {% if p.extra and p.extra.thumb %}
      <img src="{{ p.extra.thumb }}" alt="" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover object-top transition duration-300 group-hover:scale-[1.03]">
    {% else %}
      <div class="read-pdf-ph {{ 'read-accent-lv' if pub == 'lv' else 'read-accent-gv' }} absolute inset-0">
        <div class="relative text-center">
          <span class="mx-auto grid size-14 place-items-center rounded-2xl bg-surface/80 shadow-sm">{% icon "book-open", "size-7" %}</span>
          <p class="mt-3 font-display text-lg font-semibold">{{ "La Viña" if pub == "lv" else "Grapevine" }}</p>
          <p class="text-xs font-semibold uppercase tracking-[0.18em] opacity-80">{{ "read.subs.catalog_word" | t(lang) }}</p>
        </div>
      </div>
    {% endif %}
    <span class="absolute left-3 top-3 flex gap-1.5">
      {% if pub == "lv" %}<span class="badge-lv shadow-sm">La Viña</span>{% else %}<span class="badge-gv shadow-sm">Grapevine</span>{% endif %}
      {% if p.is_new %}<span class="badge-new shadow-sm">{{ "common.new" | t(lang) }}</span>{% endif %}
    </span>
  </div>
  <div class="flex flex-1 flex-col gap-1 p-4">
    <h3 class="h-card text-base group-hover:text-gv" lang="{{ info.lang or p.lang }}">{{ info.title }}</h3>
    {% if info.gloss %}{%- set glossNote = ("common.auto_translated" if info.machine else "read.title_translation") | t(lang) -%}
    <p class="flex items-center gap-1 text-xs text-muted" title="{{ glossNote }}">{% if info.machine %}{% icon "languages", "size-3 shrink-0" %}{% endif %}<span class="sr-only">{{ glossNote }}:</span><span lang="{{ info.glossLang }}">{{ info.gloss }}</span></p>{% endif %}
    <p class="flex flex-wrap items-center gap-1.5 text-xs text-muted">{{ docPill(p, lang) }}
      {%- set ex = p.extra or {} -%}
      {%- set meta = [
        (ex.upload_month | readMonth(lang)) if ex.upload_month else ((p.date | readMonth(lang)) if p.date else ""),
        (("read.one_page" if ex.pages == 1 else "common.pages") | t(lang, {n: ex.pages})) if ex.pages else "",
        (ex.size_bytes | fileSize) if ex.size_bytes else ""
      ] -%}
      <span>{{ meta | uniq | join(" · ") }}</span>
    </p>
    <span class="mt-auto inline-flex items-center gap-1 pt-2 text-sm font-semibold text-gv">{% icon "file-down", "size-4" %} {{ "common.open_pdf" | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></span>
  </div>
</a>
{% endmacro %}

{#- Compact PDF row -#}
{% macro pdfRow(p, lang) %}
{%- set info = p | readPdfTitleInfo(lang) -%}
<li>
  <a href="{{ p.url }}" target="_blank" rel="noopener" class="group flex min-h-12 items-center gap-3 rounded-xl px-3 py-2 no-underline transition hover:bg-surface-2">
    <span class="grid size-9 shrink-0 place-items-center rounded-lg {{ 'bg-lv-soft text-lv' if (p | readPub) == 'lv' else 'bg-gv-soft text-gv' }}">{% icon "file-text", "size-4" %}</span>
    <span class="min-w-0 flex-1">
      <span class="block text-sm font-medium text-ink group-hover:text-gv" lang="{{ info.lang or p.lang }}">{{ info.title }}</span>
      {% if info.gloss %}{%- set glossNote = ("common.auto_translated" if info.machine else "read.title_translation") | t(lang) -%}
      <span class="flex min-w-0 items-center gap-1 text-xs text-muted" title="{{ glossNote }}">{% if info.machine %}{% icon "languages", "size-3 shrink-0" %}{% endif %}<span class="sr-only">{{ glossNote }}:</span><span class="min-w-0 truncate" lang="{{ info.glossLang }}">{{ info.gloss }}</span></span>{% endif %}
    </span>
    {{ docPill(p, lang) }}
    {% icon "arrow-up-right", "size-4 shrink-0 text-faint" %}
    <span class="sr-only">({{ "kind.pdf" | t(lang) | lower }}, {{ "common.external" | t(lang) }})</span>
  </a>
</li>
{% endmacro %}

{#- ---------- Book of the Month card (one per publication) ----------
    The book is sold under its own title (lang = the book's language); on the other language's page the
    translated title is a subtitle. Price, percent and dates only come from db.shop. data-shop-offer /
    data-ends drive the live "N days left" and the "offer ended" state (assets/js/shop.js); the text
    rendered here is right for the build day. -#}
{% macro daysText(b, lang) -%}
{%- if b.days === 0 %}{{ "shop.last_day" | t(lang) }}{% elif b.days === 1 %}{{ "shop.ends_tomorrow" | t(lang) }}{% else %}{{ "shop.days_left" | t(lang, { n: b.days }) }}{% endif -%}
{%- endmacro %}
{% macro daysSpan(b, lang, cls="") -%}
<span data-shop-days class="{{ cls }}{{ ' is-urgent' if b.days <= 3 }}" data-t-many="{{ 'shop.days_left' | t(lang) }}" data-t-tomorrow="{{ 'shop.ends_tomorrow' | t(lang) }}" data-t-last="{{ 'shop.last_day' | t(lang) }}">{{ daysText(b, lang) }}</span>
{%- endmacro %}
{% macro botmCard(b, lang) %}
<article class="shop-book @container card overflow-hidden" data-shop-offer{% if b.ends %} data-ends="{{ b.ends }}"{% endif %} aria-labelledby="botm-{{ b.pub }}-title">
  <div class="shop-book-grid">
    <div class="shop-book-art read-cover {{ 'read-cover--lv' if b.isLv else 'read-cover--gv' }}">
      <svg class="read-cover-art" viewBox="0 0 200 240" fill="none" aria-hidden="true"><g fill="currentColor"><circle cx="82" cy="96" r="17"/><circle cx="116" cy="96" r="17"/><circle cx="150" cy="100" r="15"/><circle cx="66" cy="126" r="17"/><circle cx="100" cy="126" r="17"/><circle cx="134" cy="128" r="17"/><circle cx="82" cy="156" r="17"/><circle cx="116" cy="156" r="17"/><circle cx="100" cy="186" r="17"/></g></svg>
      {% if b.image %}
      <img class="shop-book-cover read-cover-frame" src="{{ b.image }}" alt="" width="389" height="600" loading="lazy" decoding="async">
      {% else %}
      <span class="shop-book-cover shop-book-ph read-cover-frame" aria-hidden="true">{% icon "book-open", "size-10" %}<span>{{ b.mag }}</span></span>
      {% endif %}
      {% if b.pct %}<p class="shop-sticker" data-shop-live><span class="shop-sticker-n">{{ b.pct }}%</span> <span class="shop-sticker-w">{{ "shop.sticker_word" | t(lang) }}</span></p>{% endif %}
    </div>
    <div class="flex min-w-0 flex-col p-5 sm:p-6">
      <p class="flex flex-wrap items-center gap-x-2.5 gap-y-1.5">
        <span class="{{ 'badge-lv' if b.isLv else 'badge-gv' }}"{% if b.isLv and lang != 'es' %} lang="es"{% endif %}>{% icon "grapes", "size-3" %} {{ b.mag }}</span>
        {#- the offer's own dates (the store's "October" label can run from mid-September) -#}
        <span class="text-xs font-semibold uppercase tracking-[0.12em] text-muted">{{ ("shop.botm_kicker_dates" | t(lang, { start: b.startsLabel, end: b.endsLabel })) if (b.startsLabel and b.endsLabel) else ("shop.botm_title" | t(lang)) }}</span>
      </p>
      <h3 id="botm-{{ b.pub }}-title" class="mt-2.5 font-display text-2xl font-semibold leading-tight text-balance text-ink sm:text-[1.7rem]" lang="{{ b.itemLang }}">{{ b.title }}</h3>
      {% if b.subtitle %}<p class="mt-1 flex items-start gap-1.5 text-sm text-muted" title="{{ ('common.auto_translated' if b.subtitleMachine else 'shop.title_tr') | t(lang) }}">{% if b.subtitleMachine %}{% icon "languages", "size-3.5 mt-0.5 shrink-0" %}{% endif %}<span class="sr-only">{{ ('common.auto_translated' if b.subtitleMachine else 'shop.title_tr') | t(lang) }}: </span><span class="italic" lang="{{ lang }}">{{ b.subtitle }}</span></p>{% endif %}
      {% if b.blurb %}
      <p class="mt-3 text-[0.95rem] leading-relaxed text-muted"{% if b.blurbLang != lang %} lang="{{ b.blurbLang }}"{% endif %}>{{ b.blurb }}</p>
      {% if b.blurbMachine %}<p class="mt-1.5"><span class="auto-note" title="{{ 'common.auto_translated_help' | t(lang) }}">{% icon "languages", "size-3" %} {{ "common.auto_translated" | t(lang) }}</span></p>{% endif %}
      {% endif %}
      <div class="mt-auto pt-5" data-shop-live>
        {% if b.hasPrices %}
        <p class="flex flex-wrap items-baseline gap-x-3 gap-y-1.5">
          <span class="font-display text-4xl font-semibold leading-none tabular-nums {{ 'text-lv' if b.isLv else 'text-gv' }}"><span class="sr-only">{{ "shop.sale_price" | t(lang) }}: </span>{{ b.sale }}</span>
          <s class="text-lg text-faint tabular-nums"><span class="sr-only">{{ "shop.regular_price" | t(lang) }}: </span>{{ b.price }}</s>
          <span class="badge-vine">{% icon "tag", "size-3" %} {{ "shop.you_save" | t(lang, { amount: b.save }) }}</span>
        </p>
        {% endif %}
        {% if b.ends %}
        <p class="mt-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm font-medium text-ink">
          {% icon "calendar-clock", "size-4 shrink-0 text-muted" %}
          <span>{{ "shop.through" | t(lang, { date: b.endsLabel }) }}</span>
          {% if b.days !== null %}<span aria-hidden="true" class="text-faint">·</span> {{ daysSpan(b, lang, "shop-days") }}{% endif %}
        </p>
        {% endif %}
        <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2.5">
          <a class="{{ 'btn-lv' if b.isLv else 'btn-primary' }} shop-buy" href="{{ b.url }}" target="_blank" rel="noopener">{{ ("shop.buy_pct" | t(lang, { pct: b.pct })) if b.pct else ("shop.buy" | t(lang)) }} {% icon "external-link", "size-4" %}<span class="sr-only"> {{ "shop.at_store" | t(lang, { mag: b.mag }) }} ({{ "common.external" | t(lang) }})</span></a>
          {% if b.pageUrl and b.pageUrl != b.url %}<a class="link inline-flex min-h-11 items-center gap-1 text-sm" href="{{ b.pageUrl }}" target="_blank" rel="noopener">{{ "shop.botm_page" | t(lang) }}<span class="sr-only">: {{ "shop.botm_page_sr" | t(lang, { mag: b.mag }) }} ({{ "common.external" | t(lang) }})</span> {% icon "arrow-up-right", "size-3.5" %}</a>{% endif %}
        </div>
      </div>
      <p class="mt-auto pt-5" data-shop-ended hidden><a class="btn-secondary" href="{{ b.pageUrl or b.url }}" target="_blank" rel="noopener">{% icon "book-open", "size-4" %} {{ "shop.ended" | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a></p>
    </div>
  </div>
</article>
{% endmacro %}

{#- One subscription plan type (Print / Digital / Complete) for one publication × region -#}
{% macro planCard(pub, region, tp, lang, isLv, mag) %}
{%- set icons = { print: "printer", digital: "monitor", complete: "layers", other: "newspaper" } -%}
{%- set pid = "plan-" ~ pub ~ "-" ~ region ~ "-" ~ tp.type -%}
<article class="shop-plan card flex flex-col" aria-labelledby="{{ pid }}">
  <header class="px-5 pt-5 pb-4 sm:px-6">
    <div class="flex items-center gap-3">
      <span class="grid size-11 shrink-0 place-items-center rounded-xl {{ 'bg-lv-soft text-lv' if isLv else 'bg-gv-soft text-gv' }}">{% icon icons[tp.type] or "newspaper", "size-5" %}</span>
      <div class="min-w-0">
        <h4 id="{{ pid }}" class="font-display text-xl font-semibold leading-tight text-ink">{{ tp.name }}</h4>
        {% if tp.type == "complete" %}<p class="text-xs font-semibold uppercase tracking-[0.1em] text-muted">{{ "shop.complete_tag" | t(lang) }}</p>{% endif %}
      </div>
    </div>
    {% if tp.desc %}<p class="mt-3 text-sm leading-relaxed text-muted"{% if tp.descLang and tp.descLang != lang %} lang="{{ tp.descLang }}"{% endif %}>{{ tp.desc }}</p>{% endif %}
  </header>
  <ul class="border-t border-line" role="list" aria-label="{{ 'shop.plans_label' | t(lang, { type: tp.name }) }}">
    {% for tm in tp.terms %}
    <li class="shop-term{{ ' is-best' if tm.best }}">
      <div class="min-w-0 flex-1">
        <p class="flex flex-wrap items-center gap-x-2 gap-y-1">
          <span class="font-semibold text-ink">{{ tm.label }}</span>
          {% if tm.best %}<span class="badge-vine">{% icon "star", "size-3" %} {{ "shop.best_value" | t(lang) }}</span>{% endif %}
        </p>
        {% if tm.perMonth or tm.save %}
        <p class="mt-0.5 flex flex-wrap gap-x-2.5 text-xs leading-snug text-muted">
          {%- if tm.perMonth %}<span class="whitespace-nowrap">{{ "shop.per_month_eq" | t(lang, { amount: tm.perMonth }) }}</span>{% endif -%}
          {%- if tm.save %} <span class="font-medium text-vine">{{ tm.save }}</span>{% endif -%}
        </p>
        {% endif %}
      </div>
      <p class="shrink-0 font-display text-xl font-semibold tabular-nums text-ink">{{ tm.price }}</p>
      <a class="{{ (('btn-lv' if isLv else 'btn-primary') if tm.best else 'btn-secondary') }} btn-sm shrink-0" href="{{ tm.url }}" target="_blank" rel="noopener">{{ "shop.buy_term" | t(lang) }}<span class="sr-only">: {{ "shop.buy_term_sr" | t(lang, { mag: mag, type: tp.name, term: tm.label, price: tm.price }) }} ({{ "common.external" | t(lang) }})</span></a>
    </li>
    {% endfor %}
  </ul>
  {% if tp.volume %}
  <details class="shop-vol group/vol mt-auto border-t border-line">
    <summary class="flex min-h-12 cursor-pointer list-none items-center gap-2 px-5 py-3 text-sm font-semibold text-ink sm:px-6">
      {% icon "users", "size-4 shrink-0 text-muted" %} <span class="flex-1">{{ "shop.volume_title" | t(lang) }}</span> {% icon "chevron-down", "size-4 shrink-0 text-muted transition group-open/vol:rotate-180" %}
    </summary>
    <div class="px-5 pb-5 sm:px-6">
      <p class="text-sm leading-relaxed text-muted">{{ "shop.volume_sub" | t(lang) }}</p>
      <div class="mt-3 overflow-x-auto">
        <table class="shop-table w-full text-sm">
          <caption class="sr-only">{{ "shop.volume_caption" | t(lang) }} — {{ mag }}, {{ tp.name }}</caption>
          <thead><tr><th scope="col">{{ "shop.volume_qty" | t(lang) }}</th>{% for c in tp.volume.cols %}<th scope="col" class="text-right">{{ c }}</th>{% endfor %}</tr></thead>
          <tbody>
            {% for r in tp.volume.rows %}<tr><th scope="row">{{ r.label }}</th>{% for pr in r.prices %}<td class="text-right tabular-nums">{{ pr or "—" }}</td>{% endfor %}</tr>{% endfor %}
          </tbody>
        </table>
      </div>
    </div>
  </details>
  {% endif %}
</article>
{% endmacro %}


{#- A catalog as a horizontal card (cover left, text right) — used when there are only 1–3 -#}
{% macro pdfCoverRow(p, lang) %}
{%- set pub = p | readPub -%}
{%- set info = p | readPdfTitleInfo(lang) -%}
{%- set ex = p.extra or {} -%}
<a href="{{ p.url }}" target="_blank" rel="noopener" class="card card-link group flex items-stretch overflow-hidden no-underline">
  <span class="shop-cat-thumb relative w-28 shrink-0 overflow-hidden border-r border-line bg-surface-2 sm:w-36">
    {% if ex.thumb %}<img src="{{ ex.thumb }}" alt="" loading="lazy" decoding="async" class="absolute inset-0 size-full object-cover object-top transition duration-300 group-hover:scale-[1.03]">
    {% else %}<span class="read-pdf-ph {{ 'read-accent-lv' if pub == 'lv' else 'read-accent-gv' }} absolute inset-0">{% icon "book-open", "relative size-8" %}</span>{% endif %}
  </span>
  <span class="flex min-w-0 flex-1 flex-col gap-1.5 p-4 sm:p-5">
    <span class="flex flex-wrap items-center gap-1.5">
      {% if pub == "lv" %}<span class="badge-lv">La Viña</span>{% else %}<span class="badge-gv">Grapevine</span>{% endif %}
      {% if p.is_new %}<span class="badge-new">{{ "common.new" | t(lang) }}</span>{% endif %}
      {{ docPill(p, lang) }}
    </span>
    <span class="h-card group-hover:text-gv" lang="{{ info.lang or p.lang }}">{{ info.title }}</span>
    {% if info.gloss %}{%- set glossNote = ("common.auto_translated" if info.machine else "read.title_translation") | t(lang) -%}
    <span class="flex items-center gap-1 text-xs text-muted" title="{{ glossNote }}">{% if info.machine %}{% icon "languages", "size-3 shrink-0" %}{% endif %}<span class="sr-only">{{ glossNote }}:</span><span lang="{{ info.glossLang }}">{{ info.gloss }}</span></span>{% endif %}
    {%- set meta = [
      (ex.upload_month | readMonth(lang)) if ex.upload_month else ((p.date | readMonth(lang)) if p.date else ""),
      (("read.one_page" if ex.pages == 1 else "common.pages") | t(lang, {n: ex.pages})) if ex.pages else "",
      (ex.size_bytes | fileSize) if ex.size_bytes else ""
    ] | uniq | select -%}
    {% if meta.length %}<span class="meta-row text-xs text-muted">{% for m in meta %}<span>{{ m }}</span>{% endfor %}</span>{% endif %}
    <span class="mt-auto inline-flex items-center gap-1.5 pt-2 text-sm font-semibold text-gv">{% icon "file-down", "size-4" %} {{ "common.open_pdf" | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></span>
  </span>
</a>
{% endmacro %}

{#- Hero: the page's two main tasks (subscribe, gift). The other sections are in the page nav below,
    so the hero carries no more jumps. Without price data the subscribe button opens the official
    subscribe page instead. "read-hero" (read.css) keeps both buttons on one row on a 390px phone. -#}
{% call ui.pageHero(lang, "read.subs.title" | t(lang), "read.subs.subtitle" | t(lang), "shopping-bag", "read.subs.eyebrow" | t(lang), { class: "read-hero" }) %}
  <div class="hero-actions">
    {% if subs.pubs.length %}
    <a class="btn-light" href="#subscriptions">{% icon "newspaper", "size-4" %} {{ "shop.hero_subs" | t(lang) }}</a>
    {% else %}
    <a class="btn-light" href="{{ L.lv_subscribe if lang == 'es' else L.gv_subscribe }}" target="_blank" rel="noopener">{% icon "grapes", "size-4" %} {{ ("read.subs.sub_lv" if lang == "es" else "read.subs.sub_gv") | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a>
    {% endif %}
    <a class="btn-on-dark" href="#carry">{% icon "gift", "size-4" %} {{ "shop.nav_gift" | t(lang) }}</a>
  </div>
{% endcall %}

{#- In-page navigation (the page is long): the sections in page order (docs: ui.njk pageNav) -#}
<div class="container-page page-overlap">{{ ui.pageNav([
  { href: "#botm" if botm.length else "", label: "shop.nav_botm" | t(lang), icon: "badge-percent" },
  { href: "#bulk" if bulk.rows.length else "", label: "shop.nav_bulk" | t(lang), icon: "package" },
  { href: "#magazines", label: "shop.nav_mags" | t(lang), icon: "grapes" },
  { href: "#subscriptions", label: "shop.nav_subs" | t(lang), icon: "newspaper" },
  { href: "#carry", label: "shop.nav_gift" | t(lang), icon: "gift" },
  { href: "#group", label: "shop.nav_group" | t(lang), icon: "house" },
  { href: "#catalogs", label: "shop.nav_catalogs" | t(lang), icon: "book-open" },
  { href: "#help", label: "shop.nav_help" | t(lang), icon: "phone" }
], lang) }}</div>

{#- ---------- 1. BOOK OF THE MONTH (db.shop.botm) + gift ideas + bulk-book discounts ----------
    Both books (page-language magazine first), each with its own price, dates and store link. The two
    discounts are shown side by side only — the page never says they combine. -#}
{% if botm.length or bulk.rows.length %}
<section id="botm" class="section container-page pt-10 sm:pt-12" aria-labelledby="botm-title">
  <div class="shop-botm">
    {#- "— 20% off" only while the offer runs (assets/js/shop.js swaps it once the last day has passed) -#}
    {%- set botmHead -%}
      {%- if not botm.length %}{{ "shop.bulk_title" | t(lang) }}
      {%- elif pctAll %}<span data-shop-live>{{ "shop.botm_title_pct" | t(lang, { pct: pctAll }) }}</span><span data-shop-ended hidden>{{ "shop.botm_title" | t(lang) }}</span>
      {%- else %}{{ "shop.botm_title" | t(lang) }}{% endif -%}
    {%- endset -%}
    <div{% if botm.length and pctAll and botmLast %} data-shop-offer data-ends="{{ botmLast }}"{% endif %}>
      {{ ui.sectionHead(botmHead | safe, ("shop.botm_sub" | t(lang)) if botm.length else "", "", "", "badge-percent", { eyebrow: ("shop.botm_eyebrow" if botm.length else "shop.nav_bulk") | t(lang), tone: "text-lv", id: "botm-title", lang: lang }) }}
    </div>
    {% if botm.length %}
    <div class="grid grid-cols-1 gap-5 {{ 'xl:grid-cols-2' if botm.length > 1 }}">
      {% for b in botm %}{{ botmCard(b, lang) }}{% endfor %}
    </div>
    {% endif %}
    <div class="mt-5 grid grid-cols-1 gap-5 {{ 'lg:grid-cols-[1fr_1.25fr] lg:items-start' if (botm.length and bulk.rows.length) }}">
      {% if botm.length %}
      <div class="card card-pad">
        <h3 class="card-h"><span class="text-grape">{% icon "library-big", "size-5" %}</span>{{ "shop.collect_title" | t(lang) }}</h3>
        <p class="mt-2 text-sm leading-relaxed text-muted">{{ "shop.collect_text" | t(lang) }}</p>
        <p class="eyebrow mt-5 flex items-center gap-2 text-lv">{% icon "gift", "size-4" %} {{ "shop.gift_title" | t(lang) }}</p>
        <ul class="mt-2.5 space-y-2.5" role="list">
          {% for g in [["hand-heart", "gift_sponsee"], ["sprout", "gift_newcomer"], ["users", "gift_table"]] %}
          <li class="flex items-start gap-3 text-sm leading-relaxed text-ink"><span class="mt-0.5 grid size-7 shrink-0 place-items-center rounded-lg bg-lv-soft text-lv">{% icon g[0], "size-4" %}</span><span>{{ ("shop." + g[1]) | t(lang) }}</span></li>
          {% endfor %}
        </ul>
      </div>
      {% endif %}
      {% if bulk.rows.length %}
      <div id="bulk" class="card card-pad">
        {% if botm.length %}<h3 class="card-h"><span class="text-vine">{% icon "package", "size-5" %}</span>{{ "shop.bulk_title" | t(lang) }}</h3>{% endif %}
        <p class="{{ 'mt-2' if botm.length }} text-sm leading-relaxed text-muted">{{ "shop.bulk_sub" | t(lang) }}</p>
        {#- (the roles keep it a table for screen readers where shop.css stacks its cells at large text on a phone) -#}
        <table class="shop-table shop-bulk mt-4 w-full text-sm" role="table">
          <caption class="sr-only">{{ "shop.bulk_title" | t(lang) }}</caption>
          <thead role="rowgroup"><tr role="row"><th scope="col" role="columnheader">{{ "shop.bulk_qty" | t(lang) }}</th><th scope="col" role="columnheader" class="text-right">{{ "shop.bulk_off" | t(lang) }}</th></tr></thead>
          <tbody role="rowgroup">{% for r in bulk.rows %}<tr role="row"><th scope="row" role="rowheader">{{ r.label }}</th><td role="cell" class="text-right font-semibold text-vine tabular-nums">{{ "shop.off_each" | t(lang, { amount: r.off }) }}</td></tr>{% endfor %}</tbody>
        </table>
        <p class="mt-3 text-xs leading-relaxed text-muted">{% if bulk.note %}{{ bulk.note }} {% endif %}{{ "shop.final_price" | t(lang) }}</p>
        {% if bulk.source %}<p class="mt-2 text-xs"><a class="link tap-link inline-flex items-center gap-1" href="{{ bulk.source }}" target="_blank" rel="noopener">{{ "shop.bulk_source" | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span> {% icon "arrow-up-right", "size-3.5" %}</a></p>{% endif %}
      </div>
      {% endif %}
    </div>
  </div>
</section>
{% endif %}

{#- ---------- 2. The two magazines: what you are buying ---------- -#}
<section id="magazines" class="section container-page{{ ' pt-0' if (botm.length or bulk.rows.length) else ' pt-10 sm:pt-12' }}" aria-labelledby="mags-title">
  {{ ui.sectionHead("read.subs.mags_title" | t(lang), "read.subs.mags_sub" | t(lang), "", "", "grapes", { eyebrow: "shop.nav_mags" | t(lang), tone: "text-lv", id: "mags-title", lang: lang }) }}
  <div class="grid grid-cols-1 gap-5 lg:grid-cols-2 lg:gap-6">
    {% for p in pubOrder %}
    {%- set isLv = p == "lv" -%}
    <article class="card flex flex-col overflow-hidden" aria-labelledby="mag-{{ p }}">
      {%- set ci = curIssue[p] -%}
      {#- the issue name inside a sentence: "octubre de 2026" on /es/ (as on the home page) -#}
      {%- set ciInSentence = (ci.label | readInSentence(lang, p)) if ci else "" -%}
      <header class="read-cover read-cover-head {{ 'read-cover--lv' if isLv else 'read-cover--gv' }} relative isolate overflow-hidden p-6 text-white sm:p-7">
        <svg class="read-cover-art" viewBox="0 0 200 240" fill="none" aria-hidden="true"><g fill="currentColor"><circle cx="82" cy="96" r="17"/><circle cx="116" cy="96" r="17"/><circle cx="150" cy="100" r="15"/><circle cx="66" cy="126" r="17"/><circle cx="100" cy="126" r="17"/><circle cx="134" cy="128" r="17"/><circle cx="82" cy="156" r="17"/><circle cx="116" cy="156" r="17"/><circle cx="100" cy="186" r="17"/></g></svg>
        <div class="shop-mag-row flex items-start gap-5">
          <div class="min-w-0 flex-1">
            <p class="read-cover-kicker text-xs font-semibold uppercase tracking-[0.18em] text-white/75">{{ ("read.subs.lv_kicker" if isLv else "read.subs.gv_kicker") | t(lang) }}</p>
            <h3 id="mag-{{ p }}" class="read-cover-title mt-1 flex items-center gap-2 font-display font-semibold">{% icon "grapes", "read-cover-icon size-7 shrink-0" %} <span class="min-w-0">{{ "La Viña" if isLv else "AA Grapevine" }}</span></h3>
            <p class="mt-2 max-w-md text-white/85">{{ ("read.subs.lv_desc" if isLv else "read.subs.gv_desc") | t(lang) }}</p>
          </div>
          {% if ci and ci.cover %}
          <a class="read-cover-frame shop-mag-cover mt-1 block shrink-0 rotate-2" href="{{ '/read/' | lurl(lang) }}#{{ p }}-current" title="{{ 'read.subs.see_issue' | t(lang, {issue: ciInSentence}) }}">
            <img src="{{ ci.cover }}" width="480" height="686" loading="lazy" alt="{{ 'read.cover_alt' | t(lang, {pub: ('La Viña' if isLv else 'Grapevine'), issue: ciInSentence}) }}" class="block aspect-[7/10] w-full rounded-[0.3rem] object-cover">
          </a>
          {% endif %}
        </div>
        <ul class="mt-5 flex flex-wrap gap-2 text-xs font-semibold">
          {% for f in (["f_every2", "f_spanish", "f_since96"] if isLv else ["f_monthly", "f_english", "f_since44"]) %}
          <li class="rounded-full bg-white/12 px-3 py-1 ring-1 ring-white/20">{{ ("read.subs." + f) | t(lang) }}</li>
          {% endfor %}
        </ul>
      </header>
      {#- Prices and the Buy links are in the price table below (once); here only the store and the apps. -#}
      <div class="mt-auto flex flex-wrap gap-2 p-5 sm:p-6">
        <a class="{{ 'btn-lv' if isLv else 'btn-primary' }}" href="{{ L.lv_store if isLv else L.gv_store }}" target="_blank" rel="noopener">{% icon "store", "size-4" %} {{ "read.subs.store_btn" | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a>
        <a class="btn-secondary" href="{{ L.lv_apps if isLv else L.gv_apps }}" target="_blank" rel="noopener">{% icon "smartphone", "size-4" %} {{ "read.subs.apps_btn" | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a>
      </div>
    </article>
    {% endfor %}
  </div>
</section>

{#- ---------- 3. SUBSCRIPTIONS & PRICES (db.shop.subscriptions) ----------
    Publication × region switch (native radio groups driven by Alpine: arrow keys move between the
    options, as with any radio group). Without JavaScript the switch stays hidden (x-cloak) and every
    publication's U.S. prices show, each under its own heading. One card per plan type; each term with
    its price, the monthly equivalent, the saving against the shortest term, "Best value" on the lowest
    monthly equivalent, and a Buy link to the official product page. -#}
<section id="subscriptions" class="section container-page pt-0" aria-labelledby="subs-title"{% if subs.pubs.length %} x-data="shopSubs({{ { first: subs.first, avail: subs.avail } | dump }})"{% endif %}>
  {{ ui.sectionHead("shop.subs_title" | t(lang), "shop.subs_sub" | t(lang), "", "", "newspaper", { eyebrow: "shop.subs_eyebrow" | t(lang), id: "subs-title", lang: lang }) }}
  {% if subs.pubs.length %}
  {%- set showPub = subs.pubs.length > 1 -%}
  {%- set showRegion = subs.regions.length > 1 -%}
  {% if showPub or showRegion %}
  <div class="shop-controls" x-cloak>
    {% if showPub %}
    <fieldset class="shop-seg-field">
      <legend class="shop-seg-legend">{{ "shop.pick_pub" | t(lang) }}</legend>
      <div class="shop-seg">
        {% for p in subs.pubs %}
        <label class="shop-seg-opt shop-seg-{{ p.pub }}"><input type="radio" name="shop-pub" value="{{ p.pub }}" x-model="pub"{% if loop.first %} checked{% endif %}><span{% if p.isLv and lang != 'es' %} lang="es"{% endif %}>{% icon "grapes", "size-4 shrink-0" %} {{ p.mag }}</span></label>
        {% endfor %}
      </div>
    </fieldset>
    {% endif %}
    {% if showRegion %}
    <fieldset class="shop-seg-field">
      <legend class="shop-seg-legend">{{ "shop.pick_region" | t(lang) }}</legend>
      <div class="shop-seg">
        {% for r in subs.regions %}
        <label class="shop-seg-opt" x-show="has('{{ r }}')"><input type="radio" name="shop-region" value="{{ r }}" x-model="region"{% if r == "us" %} checked{% endif %}><span>{{ ("shop.region_" + r) | t(lang) }}</span></label>
        {% endfor %}
      </div>
    </fieldset>
    {% endif %}
  </div>
  {% endif %}
  {% for p in subs.pubs %}{% for r in p.regions %}
  {%- set isDefault = r.region == p.defaultRegion -%}
  {%- set cols = r.types.length -%}
  <div class="shop-panel" data-pub="{{ p.pub }}" data-region="{{ r.region }}"{% if not isDefault %} x-cloak{% endif %} x-show="show('{{ p.pub }}', '{{ r.region }}')">
    <h3 class="shop-panel-title"><span class="{{ 'text-lv' if p.isLv else 'text-gv' }}">{% icon "grapes", "size-5" %}</span> <span{% if p.isLv and lang != 'es' %} lang="es"{% endif %}>{{ p.mag }}</span> <span class="text-faint" aria-hidden="true">·</span> <span class="text-muted">{{ ("shop.region_" + r.region) | t(lang) }}</span></h3>
    <div class="grid grid-cols-1 gap-5 {{ 'md:grid-cols-2 xl:grid-cols-3 shop-plans-3' if cols >= 3 else ('md:grid-cols-2' if cols == 2 else 'md:max-w-xl') }}">
      {% for tp in r.types %}{{ planCard(p.pub, r.region, tp, lang, p.isLv, p.mag) }}{% endfor %}
    </div>
    <p class="mt-4 flex flex-wrap items-center gap-x-5 gap-y-1 text-sm">
      {% if r.url %}<a class="link tap-link inline-flex items-center gap-1" href="{{ r.url }}" target="_blank" rel="noopener">{{ "shop.all_plans" | t(lang, { mag: p.mag, region: ("shop.region_" + r.region) | t(lang) }) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span> {% icon "arrow-up-right", "size-3.5" %}</a>{% endif %}
      {% if r.region != "us" %}<span class="text-muted">{{ "shop.conversion_note" | t(lang) }}</span>{% endif %}
    </p>
  </div>
  {% endfor %}{% endfor %}
  {% if shop.updated %}<p class="mt-6 flex items-start gap-2 text-xs leading-relaxed text-muted">{% icon "info", "size-4 shrink-0" %}<span>{{ "shop.prices_note" | t(lang, { stores: "aagrapevine.org / aalavina.org", date: shop.updated | fmtDate(lang, "medium") }) }}</span></p>{% endif %}
  {% else %}
  {{ ui.emptyState("store", "shop.empty_title" | t(lang), "shop.empty_text" | t(lang), L.lv_subscribe if lang == "es" else L.gv_subscribe, ("read.subs.sub_lv" if lang == "es" else "read.subs.sub_gv") | t(lang)) }}
  <p class="mt-3 text-center text-sm"><a class="link tap-link" href="{{ L.gv_subscribe if lang == 'es' else L.lv_subscribe }}" target="_blank" rel="noopener">{{ ("read.subs.sub_gv" if lang == "es" else "read.subs.sub_lv") | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a></p>
  {% endif %}
</section>

{#- ---------- 4. Carry the Message: the page's one feature band ---------- -#}
<section id="carry" class="border-y border-line bg-lv-soft/60" aria-labelledby="ctm-title">
  <div class="container-page section grid grid-cols-1 items-center gap-10 lg:grid-cols-[1.2fr_1fr]">
    <div>
      <p class="eyebrow flex items-center gap-2 text-lv">{% icon "gift", "size-4 shrink-0" %}<span>{{ "read.subs.ctm_eyebrow" | t(lang) }}</span></p>
      <h2 id="ctm-title" class="h-display mt-2 text-3xl text-balance sm:text-4xl">{{ "read.subs.ctm_title" | t(lang) }}</h2>
      <p class="lead measure mt-4">{{ "read.subs.ctm_text" | t(lang) }}</p>
      <ul class="shop-ctm-ways mt-6 grid grid-cols-1 gap-3" role="list">
        {% for w in [["landmark", "ctm_w1"], ["hospital", "ctm_w2"], ["sprout", "ctm_w3"], ["map", "ctm_w4"]] %}
        <li class="flex items-center gap-3 rounded-xl bg-surface p-3 shadow-[var(--shadow-card)]"><span class="grid size-9 shrink-0 place-items-center rounded-lg bg-lv-soft text-lv">{% icon w[0], "size-4" %}</span><span class="min-w-0 text-sm font-medium text-ink">{{ ("read.subs." + w[1]) | t(lang) }}</span></li>
        {% endfor %}
      </ul>
      <div class="mt-7 flex flex-wrap gap-2 sm:gap-3">
        <a class="btn-lv" href="{{ L.carry_the_message }}" target="_blank" rel="noopener">{% icon "gift", "size-4" %} {{ "read.subs.ctm_btn" | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a>
        <a class="btn-secondary" href="{{ '/gvr/' | lurl(lang) }}">{{ "read.subs.ctm_gvr" | t(lang) }} {% icon "arrow-right", "size-4" %}</a>
      </div>
    </div>
    <div class="card card-pad">
      <h3 class="card-h"><span class="text-lv">{% icon "hand-heart", "size-5" %}</span>{{ "read.subs.ctm_how_title" | t(lang) }}</h3>
      <ol class="mt-4 space-y-3" role="list">
        {% for n in range(1, 4) %}
        <li class="flex gap-3"><span class="step-num" aria-hidden="true">{{ n }}</span><span class="pt-0.5 text-sm leading-relaxed text-muted"><span class="sr-only">{{ n }}. </span>{{ ("read.subs.ctm_how" + n) | t(lang) }}</span></li>
        {% endfor %}
      </ol>
      {% if ctmPdfs.length %}
      <p class="eyebrow mt-6">{{ "read.subs.ctm_flyers" | t(lang) }}</p>
      <ul class="-mx-3 mt-2">{% for p in ctmPdfs %}{{ pdfRow(p, lang) }}{% endfor %}</ul>
      {% endif %}
    </div>
  </div>
</section>

{#- ---------- 5. Home group subscriptions + the official order forms ---------- -#}
<section id="group" class="section container-page" aria-labelledby="group-title">
  {{ ui.sectionHead("read.subs.group_title" | t(lang), "read.subs.group_sub" | t(lang), "", "", "house", { eyebrow: "shop.nav_group" | t(lang), tone: "text-lv", id: "group-title", lang: lang }) }}
  <ol class="grid grid-cols-1 gap-x-8 gap-y-5 sm:grid-cols-2 xl:grid-cols-4" role="list">
    {% for n in range(1, 5) %}
    <li class="flex gap-3">
      <span class="step-num" aria-hidden="true">{{ n }}</span>
      <div class="min-w-0"><p class="font-semibold text-ink"><span class="sr-only">{{ n }}. </span>{{ ("read.subs.group" + n + "_t") | t(lang) }}</p><p class="mt-0.5 text-sm leading-relaxed text-muted">{{ ("read.subs.group" + n) | t(lang) }}</p></div>
    </li>
    {% endfor %}
  </ol>
  {#- @container: the Grapevine and La Viña form lists sit side by side when the card is wide -#}
  <div class="card card-pad @container mt-8 sm:mt-10" role="region" aria-labelledby="forms-title">
    <h3 id="forms-title" class="card-h"><span>{% icon "clipboard-list", "size-5" %}</span>{{ "read.subs.forms_title" | t(lang) }}</h3>
    <p class="mt-1 text-sm text-muted">{{ "read.subs.forms_sub" | t(lang) }}</p>
    {% if forms.gv.length or forms.lv.length %}
    <div class="grid grid-cols-1 gap-x-8 @2xl:grid-cols-2">
    {% for pub in pubOrder %}{% if forms[pub].length %}
    <div class="min-w-0">
      <p class="mt-4 flex items-center gap-2 text-xs font-semibold uppercase tracking-wider {{ 'text-lv' if pub == 'lv' else 'text-gv' }}">{% icon "grapes", "size-3.5" %} {{ "La Viña" if pub == "lv" else "Grapevine" }}</p>
      <ul class="-mx-3 mt-1">{% for f in forms[pub] | limit(6) %}{{ pdfRow(f, lang) }}{% endfor %}</ul>
    </div>
    {% endif %}{% endfor %}
    </div>
    {% else %}
    <p class="mt-4 rounded-xl bg-surface-2 p-4 text-sm text-muted">{{ "read.subs.forms_empty" | t(lang) }}</p>
    {% endif %}
    <p class="mt-3 flex flex-wrap gap-x-5 border-t border-line pt-3 text-sm"><a class="link tap-link" href="{{ L.gvr_resources }}" target="_blank" rel="noopener">{{ "read.subs.all_gvr" | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a><a class="link tap-link" href="{{ L.rlv_resources }}" target="_blank" rel="noopener">{{ "read.subs.all_rlv" | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a></p>
  </div>
</section>

{#- ---------- 6. Catalogs (db.pdfs) + 7. customer service: one band ----------
    From 1024px customer service sits on the RIGHT of the catalogs: two equal columns with 1–3
    catalogs (the usual case; with ONE catalog the catalog column stops at 42rem from 1536px, so the
    card never stretches empty and customer service gets the room), or a 20rem / 24rem column beside
    the cover grid when there are more. Both columns open with the same section head (eyebrow + h2 +
    intro). Customer service is a sticky-aside, so it stays in view beside a taller catalog column.
    Below 1024px it comes after the catalogs and the store links (DOM order = phone order).
    Catalogs: 1–3 are horizontal cards (cover left, text right); more are a cover grid, older ones
    in a list. -#}
{%- set fewCats = catalogs.length and catalogs.length <= 3 -%}
<div class="section section-band">
  <div class="container-page {{ 'layout-aside' if catalogs.length > 3 else ('shop-cat-help' ~ (' is-one' if catalogs.length == 1 else '')) }}">
    <section id="catalogs" class="min-w-0" aria-labelledby="cat-title">
      {% call ui.sectionHead("read.subs.cat_title" | t(lang), "read.subs.cat_sub" | t(lang), "", "", "book-open", { eyebrow: "shop.cat_eyebrow" | t(lang), id: "cat-title", lang: lang }) %}{% if catalogs.length %}{{ ui.freshness(db.pdfs.updated, lang) }}{% endif %}{% endcall %}
      {% if fewCats %}
      {#- one: the card fills its column from 1024px · two: side by side on tablets and from 1536px ·
          three: one per row (no orphan on a last row) -#}
      <div class="grid grid-cols-1 gap-5 {{ 'max-w-2xl lg:max-w-none' if catalogs.length == 1 else ('md:grid-cols-2 lg:grid-cols-1 2xl:grid-cols-2' if catalogs.length == 2) }}">
        {% for p in catalogs %}{{ pdfCoverRow(p, lang) }}{% endfor %}
      </div>
      {% elif catalogs.length %}
      <div class="grid grid-cols-2 gap-4 sm:grid-cols-4 sm:gap-5 min-[1800px]:grid-cols-8">
        {% for p in catalogs | limit(8) %}{{ pdfCover(p, lang) }}{% endfor %}
      </div>
      {% if catalogs.length > 8 %}
      <details class="read-faq group/cat mt-5">
        <summary class="btn-secondary btn-sm cursor-pointer">{{ ("read.subs.older_catalogs_one" if catalogs.length == 9 else "read.subs.older_catalogs") | t(lang, {n: catalogs.length - 8}) }} {% icon "chevron-down", "size-4 transition group-open/cat:rotate-180" %}</summary>
        <ul class="card mt-3 p-2">{% for p in catalogs | offset(8) %}{{ pdfRow(p, lang) }}{% endfor %}</ul>
      </details>
      {% endif %}
      {% else %}
      {{ ui.emptyState("book-open", "read.subs.cat_empty" | t(lang), "read.subs.cat_empty_text" | t(lang)) }}
      {% endif %}
      <div class="mt-6 grid grid-cols-1 gap-2 sm:flex sm:flex-wrap sm:items-center sm:gap-3">
        {% for pub in pubOrder %}<a class="btn-secondary" href="{{ L.lv_store if pub == 'lv' else L.gv_store }}" target="_blank" rel="noopener">{% icon "store", "size-4" %} {{ ("read.subs.lv_store" if pub == "lv" else "read.subs.gv_store") | t(lang) }}<span class="sr-only"> ({{ "common.external" | t(lang) }})</span></a>{% endfor %}
      </div>
    </section>

    {#- Customer service: the same section head as the catalogs, then one card with the numbers, laid
        out in shop.css by the card's width (.shop-help-list: label over number on phones, one row
        each from 24rem, three tiles side by side from 34rem — 56rem with relaxed text spacing) -#}
    <section id="help" class="sticky-aside" aria-labelledby="help-title">
      {{ ui.sectionHead("read.subs.help_title" | t(lang), "read.subs.help_text" | t(lang), "", "", "phone", { eyebrow: "shop.nav_help" | t(lang), id: "help-title", lang: lang }) }}
      <div class="card card-pad shop-help">
        <ul class="shop-help-list" role="list">
          {#- pick(): the page language's number when config/site.yml has one (support_phone_intl_es:
              the Spanish international desk on /es/), else the plain key. support_phone_es is the
              Spanish toll-free line and is shown on both pages. -#}
          {% for ph in [["support_phone_us", "help_us"], ["support_phone_es", "help_es"], ["support_phone_intl", "help_intl"]] %}
          {%- set num = L | pick(lang, ph[0]) -%}
          {% if num %}
          <li>
            <p class="min-w-0 text-xs font-semibold uppercase tracking-wider text-muted">{{ ("read.subs." + ph[1]) | t(lang) }}</p>
            <a class="tap-link shrink-0 items-center font-display text-xl font-semibold whitespace-nowrap text-ink no-underline hover:text-gv" href="{{ num | readTel }}">{{ num }}</a>
          </li>
          {% endif %}
          {% endfor %}
        </ul>
