---
pagination: { data: languages, size: 1, alias: lang }
permalink: "{{ '/' if lang == 'en' else '/es/' }}districts/index.html"
layout: layouts/base.njk
pageKey: districts
titleKey: nav.districts
descKey: community.districts.meta_desc
pageScripts: ["/assets/js/community.js"]
---
{% import "macros/ui.njk" as ui with context %}
{#- For district committee members: directory (content/districts.yml → db.districts),
    the District Service Kit (feeds, calendar, digest, poster) and a self-filling
    GV/LV report template — including the published writers from our Area (db.spotlight,
    last 60 days, Area 65 first, then the rest of Texas), also shown as a card next to it. -#}
{%- set districts = db.districts.items | cmDistricts -%}
{%- set other = lang | otherLang -%}
{%- set rssUrl = '/feed.xml' | lurl(lang) | siteUrl(site) -%}
{%- set icsUrl = '/events.ics' | lurl(lang) | siteUrl(site) -%}
{%- set rd = db | cmReport(meeting) -%}
{%- set contact = site.contact_email -%}
{%- set W = rd.writers -%}

{% call ui.pageHero(lang, "nav.districts" | t(lang), "community.districts.hero_sub" | t(lang), "map", "community.districts.eyebrow" | t(lang)) %}
<div class="hero-actions cm-hero-tight">
  <a class="btn-light" href="#kit">{% icon "package-open", "size-4" %} {{ "community.districts.btn_kit" | t(lang) }}</a>
  <a class="btn-on-dark" href="#report">{% icon "clipboard-list", "size-4" %} {{ "community.districts.btn_report" | t(lang) }}</a>
</div>
{% endcall %}

{#- ============ How it works (tucks into the hero's faded edge) ============ -#}
<section class="container-page page-overlap" aria-labelledby="how-title">
  <h2 id="how-title" class="sr-only">{{ "community.districts.how_title" | t(lang) }}</h2>
  <ol class="grid gap-4 md:grid-cols-3" role="list">
    {% for s in [{ n: "s1", icon: "refresh-cw", cls: "bg-gv-soft text-gv" }, { n: "s2", icon: "rss", cls: "bg-lv-soft text-lv" }, { n: "s3", icon: "megaphone", cls: "bg-vine-soft text-vine" }] %}
    <li class="card card-pad relative flex gap-4">
      <span class="grid size-11 shrink-0 place-items-center rounded-xl {{ s.cls }}">{% icon s.icon, "size-5" %}</span>
      <div>
        <p class="text-xs font-bold uppercase tracking-wider text-muted">{{ loop.index }}</p>
        <h3 class="h-card">{{ ("community.districts." + s.n + "_t") | t(lang) }}</h3>
        <p class="mt-1 text-sm leading-relaxed text-muted">{{ ("community.districts." + s.n + "_d") | t(lang) }}</p>
      </div>
    </li>
    {% endfor %}
  </ol>
</section>

{#- ============ Directory ============ -#}
<section class="section container-page" aria-labelledby="dir-title">
  <div class="mb-6">
    <h2 id="dir-title" class="h-section flex items-center gap-2.5"><span class="text-gv">{% icon "map-pin", "size-6" %}</span>{{ "community.districts.dir_title" | t(lang) }}</h2>
    <p class="mt-1.5 max-w-2xl text-muted">{{ "community.districts.dir_sub" | t(lang) }}</p>
  </div>
  {#- grid-cards-fit: 1 → 2 → 3 → 4 → 5 columns as the screen grows; a short list stretches
      to fill the row instead of leaving empty columns. -#}
  <ul class="grid-cards-fit" role="list">
    {% for d in districts %}
    {#- `name` and `meets` come translated from the pipeline (i18n.name / i18n.meets).
        One "auto-translated" note per card, next to the first field that really is a
        machine translation (i.e. differs from what the chair wrote). -#}
    {%- set name = d | tx("name", lang) -%}
    {%- set meets = d | tx("meets", lang) -%}
    {%- set isMt = d | machineFor(lang) -%}
    {%- set mtName = isMt and name and name != d.name -%}
    {%- set mtMeets = isMt and meets and meets != d.meets and not mtName -%}
    {%- set isEs = d.language == "es" -%}
    {%- set hasDetails = d.website or d.gvr_contact or meets -%}
    <li class="card relative flex flex-col overflow-hidden {{ 'cm-district-es' if isEs }}">
      <div class="flex flex-1 flex-col p-5 sm:p-6">
        {#- The language pill never breaks inside itself: on a narrow card it drops under the number. -#}
        <div class="flex flex-wrap items-start justify-between gap-x-3 gap-y-2">
          <p class="leading-none">
            <span class="block text-xs font-bold uppercase tracking-[0.14em] text-muted">{{ "community.districts.district" | t(lang) }}</span>
            <span class="mt-1 block font-display text-5xl font-semibold text-ink">{{ d.number }}</span>
          </p>
          {% if isEs %}<span class="badge-lv whitespace-nowrap">{% icon "languages", "size-3" %} {{ "community.districts.lang_es" | t(lang) }}</span>
          {% elif d.language == "both" %}<span class="badge-grape whitespace-nowrap">{% icon "languages", "size-3" %} {{ "community.districts.lang_both" | t(lang) }}</span>
          {% elif d.language == "en" %}<span class="badge-muted whitespace-nowrap">{{ "community.districts.lang_en" | t(lang) }}</span>{% endif %}
        </div>
        {% if name %}<p class="mt-3 font-semibold text-ink">{{ name }}{% if mtName %} {{ ui.autoNote(d, lang) }}{% endif %}</p>{% endif %}
        {% if hasDetails %}
        <dl class="mt-4 space-y-2 text-sm">
          {% if meets %}<div class="flex gap-2"><dt class="flex items-center gap-1.5 text-muted">{% icon "clock", "size-4" %}<span class="sr-only">{{ "community.districts.meets" | t(lang) }}</span></dt><dd class="text-ink">{{ meets }}{% if mtMeets %} {{ ui.autoNote(d, lang) }}{% endif %}</dd></div>{% endif %}
          {% if d.website %}<div class="flex gap-2"><dt class="flex items-center text-muted">{% icon "globe", "size-4" %}<span class="sr-only">{{ "community.districts.website" | t(lang) }}</span></dt><dd class="min-w-0"><a class="link break-all" href="{{ d.website }}" target="_blank" rel="noopener">{{ d.website | hostname or d.website }}</a></dd></div>{% endif %}
          {% if d.gvr_contact %}<div class="flex gap-2"><dt class="flex items-center text-muted">{% icon "mail", "size-4" %}<span class="sr-only">{{ "community.districts.contact" | t(lang) }}</span></dt><dd class="min-w-0"><a class="link break-all" href="mailto:{{ d.gvr_contact }}">{{ d.gvr_contact }}</a></dd></div>{% endif %}
        </dl>
        {% else %}
        <p class="mt-4 text-sm leading-relaxed text-muted">{{ "community.districts.no_details" | t(lang) }}</p>
        <p class="mt-auto pt-4"><a class="btn-secondary btn-sm" href="{{ contact | cmMailto('community.districts.update_subject' | t(lang, { n: d.number }), 'community.districts.missing_body' | t(lang)) }}">{% icon "send", "size-4" %} {{ "community.districts.update_btn" | t(lang) }}</a></p>
        {% endif %}
      </div>
    </li>
    {% endfor %}
    {#- Always offer the "missing district" call to action (it is the whole list when empty). -#}
    <li class="flex flex-col justify-center rounded-[var(--radius-card)] border-2 border-dashed border-line bg-surface/60 p-6 {{ 'col-span-full items-center text-center' if not (districts | length) else 'items-start' }}">
      <span class="grid size-11 place-items-center rounded-full bg-gv-soft text-gv">{% icon "map-pin-plus", "size-5" %}</span>
      <h3 class="h-card mt-3">{{ ("community.districts.missing_title" if districts | length else "community.districts.empty_title") | t(lang) }}</h3>
      <p class="mt-1 max-w-sm text-sm leading-relaxed text-muted">{{ "community.districts.missing_text" | t(lang) }}</p>
      <a class="btn-primary btn-sm mt-4" href="{{ contact | cmMailto('community.districts.missing_subject' | t(lang), 'community.districts.missing_body' | t(lang)) }}">{% icon "mail", "size-4" %} {{ "community.districts.missing_btn" | t(lang) }}</a>
    </li>
  </ul>
</section>

{#- ============ District Service Kit ============ -#}
<section id="kit" class="scroll-mt-20 bg-surface-2/60 py-12 sm:py-16" aria-labelledby="kit-title">
  <div class="container-page">
    <div class="mb-8 flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="eyebrow">{{ "nav.service" | t(lang) }}</p>
        <h2 id="kit-title" class="h-section mt-1">{{ "community.districts.kit_title" | t(lang) }}</h2>
        <p class="mt-1.5 max-w-2xl text-muted">{{ "community.districts.kit_sub" | t(lang) }}</p>
      </div>
    </div>
    {#- 2 × 2 cards; from 1536px three columns: feed | calendar | digest + poster stacked
        (the two link cards are short; the feed and calendar cards need room for their URLs). -#}
    <div class="cm-kit grid grid-cols-1 gap-5 md:grid-cols-2">
      {#- RSS -#}
      <article class="card card-pad flex min-w-0 flex-col">
        <div class="flex items-center gap-3">
          <span class="grid size-11 place-items-center rounded-xl bg-lv-soft text-lv">{% icon "rss", "size-5" %}</span>
          <h3 class="h-card">{{ "community.districts.kit_rss_t" | t(lang) }}</h3>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-muted">{{ "community.districts.kit_rss_d" | t(lang) }}</p>
        <ul class="mt-4 space-y-2" role="list">
          {% for f in [{ l: "en", url: '/feed.xml' | siteUrl(site), label: "community.sub.rss_en" }, { l: "es", url: '/es/feed.xml' | siteUrl(site), label: "community.sub.rss_es" }] %}
          <li class="flex items-center gap-2 rounded-xl border border-line bg-paper p-1.5 pl-3">
            <span class="w-7 shrink-0 text-xs font-bold uppercase text-muted">{{ f.l }}</span>
            <code class="min-w-0 flex-1 truncate text-xs text-ink" title="{{ f.url }}">{{ f.url | cmShortUrl }}</code>
            <button type="button" class="btn-secondary btn-sm shrink-0" data-copy="{{ f.url }}" aria-label="{{ 'community.sub.copy_rss' | t(lang) }} — {{ f.label | t(lang) }}">{% icon "copy", "size-4" %} {{ "common.copy" | t(lang) }}</button>
          </li>
          {% endfor %}
        </ul>
        <p class="mt-3 flex gap-2 text-xs leading-relaxed text-muted">{% icon "info", "size-4 shrink-0" %} {{ "community.districts.kit_rss_slack" | t(lang) }}</p>
      </article>
      {#- Calendar -#}
      <article class="card card-pad flex min-w-0 flex-col">
        <div class="flex items-center gap-3">
          <span class="grid size-11 place-items-center rounded-xl bg-vine-soft text-vine">{% icon "calendar-plus", "size-5" %}</span>
          <h3 class="h-card">{{ "community.districts.kit_ics_t" | t(lang) }}</h3>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-muted">{{ "community.districts.kit_ics_d" | t(lang) }}</p>
        <div class="mt-4 flex items-center gap-2 rounded-xl border border-line bg-paper p-1.5 pl-3">
          <code class="min-w-0 flex-1 truncate text-xs text-ink" title="{{ icsUrl }}">{{ icsUrl | cmShortUrl }}</code>
          <button type="button" class="btn-secondary btn-sm shrink-0" data-copy="{{ icsUrl }}" aria-label="{{ 'community.sub.copy_ics' | t(lang) }}">{% icon "copy", "size-4" %} {{ "common.copy" | t(lang) }}</button>
        </div>
        <div class="mt-auto flex flex-wrap gap-2 pt-4">
          <a class="btn-secondary btn-sm" href="https://calendar.google.com/calendar/render?cid={{ icsUrl | cmWebcal | urlencode }}" target="_blank" rel="noopener">{% icon "calendar", "size-4" %} {{ "community.districts.kit_ics_google" | t(lang) }}</a>
          <a class="btn-secondary btn-sm" href="{{ icsUrl | cmWebcal }}">{% icon "calendar-check", "size-4" %} {{ "community.districts.kit_ics_apple" | t(lang) }}</a>
        </div>
      </article>
      <div class="cm-kit-stack">
      {#- Digest -#}
      <article class="card card-pad flex min-w-0 flex-col">
        <div class="flex items-center gap-3">
          <span class="grid size-11 place-items-center rounded-xl bg-gv-soft text-gv">{% icon "message-circle", "size-5" %}</span>
          <h3 class="h-card">{{ "community.districts.kit_digest_t" | t(lang) }}</h3>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-muted">{{ "community.districts.kit_digest_d" | t(lang) }}</p>
        <p class="mt-auto pt-4"><a class="btn-primary btn-sm" href="{{ '/digest/' | lurl(lang) }}">{% icon "newspaper", "size-4" %} {{ "community.districts.kit_digest_btn" | t(lang) }}</a></p>
      </article>
      {#- Poster -#}
      <article class="card card-pad flex min-w-0 flex-col">
        <div class="flex items-center gap-3">
          <span class="grid size-11 place-items-center rounded-xl bg-grape-soft text-grape">{% icon "qr-code", "size-5" %}</span>
          <h3 class="h-card">{{ "community.districts.kit_poster_t" | t(lang) }}</h3>
        </div>
        <p class="mt-3 text-sm leading-relaxed text-muted">{{ "community.districts.kit_poster_d" | t(lang) }}</p>
        <p class="mt-auto pt-4"><a class="btn-secondary btn-sm" href="{{ '/share/' | lurl(lang) }}">{% icon "printer", "size-4" %} {{ "community.districts.kit_poster_btn" | t(lang) }}</a></p>
      </article>
      </div>
    </div>
  </div>
</section>

{#- ============ District report template ============ -#}
{#- Report + a sidebar (tips, published writers): 20rem from 1024px, 22rem from 1536px; from
    1800px the sidebar's two cards sit side by side so the report keeps a comfortable width. -#}
<section id="report" class="section container-page scroll-mt-20" aria-labelledby="report-title" x-data="reportBox('{{ lang }}')">
  <div class="cm-rp-layout">
    <div class="min-w-0">
      <h2 id="report-title" class="h-section flex items-center gap-2.5"><span class="text-gv">{% icon "clipboard-list", "size-6" %}</span>{{ "community.districts.report_title" | t(lang) }}</h2>
      <p class="mt-1.5 max-w-2xl text-muted">{{ "community.districts.report_sub" | t(lang) }}</p>

      <div class="card mt-6 overflow-hidden">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-line bg-surface-2/60 px-4 py-3 sm:px-5">
          <fieldset class="min-w-0" x-cloak>
            <legend class="sr-only">{{ "community.districts.report_lang" | t(lang) }}</legend>
            <div class="grid grid-cols-2 gap-1 rounded-full border border-line bg-surface p-1">
              <label class="cm-seg"><input type="radio" name="report-lang" class="sr-only" :checked="rl === 'en'" @change="rl = 'en'" {% if lang == 'en' %}checked{% endif %}><span lang="en">{{ "community.lang_name_en" | t(lang) }}</span></label>
              <label class="cm-seg"><input type="radio" name="report-lang" class="sr-only" :checked="rl === 'es'" @change="rl = 'es'" {% if lang == 'es' %}checked{% endif %}><span lang="es">{{ "community.lang_name_es" | t(lang) }}</span></label>
            </div>
          </fieldset>
          <button type="button" class="btn-primary btn-sm" data-copy-from="#report-{{ lang }}" :data-copy-from="'#report-' + rl">{% icon "copy", "size-4" %} {{ "community.districts.report_copy" | t(lang) }}</button>
        </div>
        {% for l in [lang, other] %}
        <pre id="report-{{ l }}" class="cm-report m-0 px-4 py-4 font-sans sm:px-6 sm:py-5" x-show="rl === '{{ l }}'"{% if l != lang %} x-cloak{% endif %} role="region" aria-label="{{ 'community.districts.report_label' | t(lang) }} ({{ ('community.lang_name_' + l) | t(lang) }})"><span lang="{{ l }}">{{ rd | cmReportText(l, site) }}</span></pre>
        {% endfor %}
        <p class="flex items-center gap-2 border-t border-line px-4 py-3 text-xs text-muted sm:px-6">{% icon "info", "size-4" %} {{ "community.districts.report_note" | t(lang) }}</p>
      </div>
    </div>

    <div class="cm-rp-side lg:pt-20">
    <aside class="rounded-2xl border border-line p-5" aria-labelledby="tips-title">
      <div>
        <h3 id="tips-title" class="h-card flex items-center gap-2">{% icon "lightbulb", "size-5 text-lv" %} {{ "community.districts.tips_title" | t(lang) }}</h3>
        <ul class="mt-3 space-y-3 text-sm leading-relaxed text-muted" role="list">
          {% for k in ["tip1", "tip2", "tip3", "tip4", "tip5"] %}
          <li class="flex gap-2.5">{% icon "check", "size-4 mt-0.5 shrink-0 text-vine" %}<span>{{ ("community.districts." + k) | t(lang) }}</span></li>
          {% endfor %}
        </ul>
        <div class="mt-5 flex flex-wrap gap-2 border-t border-line pt-4">
          <a class="btn-secondary btn-sm" href="{{ site.links.carry_the_message }}" target="_blank" rel="noopener">{% icon "gift", "size-4" %} {{ "community.districts.ctm" | t(lang) }}</a>
          <a class="btn-secondary btn-sm" href="{{ '/gvr/' | lurl(lang) }}">{% icon "badge-check", "size-4" %} {{ "nav.gvr" | t(lang) }}</a>
        </div>
      </div>
    </aside>

    {#- Published writers from our Area — the same list as the report's item, with links -#}
    {% if W %}
    <div class="card card-pad">
      <h3 id="writers-title" class="h-card flex items-center gap-2">{% icon "award", "size-5 text-lv" %} {{ "community.writers.card_title" | t(lang) }}</h3>
      <p class="mt-1 text-sm leading-relaxed text-muted">{{ "community.writers.card_sub" | t(lang, { n: W.days }) }}</p>
      <h4 class="eyebrow mt-4 flex items-center gap-1.5">{% icon "map-pin", "size-3.5" %} {{ "community.writers.group_neta65" | t(lang) }}</h4>
      {% if W.neta65 | length %}
      <ul class="mt-2 space-y-3" role="list">
        {% for it in W.neta65 | limit(6) %}
        {%- set isLv = it.source == "lavina" or it.extra.publication == "lv" -%}
        {%- set place = it | cmWriterPlace(lang) -%}
        <li class="text-sm">
          <a class="font-semibold leading-snug text-ink no-underline hover:text-gv hover:underline" href="{{ it.url }}" target="_blank" rel="noopener">{{ it | tx("title", lang) }}<span class="sr-only"> {{ "community.new_tab" | t(lang) }}</span></a>
          <p class="text-ink">{{ it | cmWriterName(lang) }}{% if place %}<span class="text-muted"> · {{ place }}</span>{% endif %}</p>
          <p class="mt-0.5 flex flex-wrap items-center gap-x-2 gap-y-0.5 text-xs text-muted"><span class="{{ 'badge-lv' if isLv else 'badge-gv' }}">{{ "La Viña" if isLv else "Grapevine" }}</span>{% if it.extra.issue_label %}<span>{{ it | cmItemIssue(lang) }}</span>{% endif %}{{ ui.autoNote(it, lang) }}</p>
        </li>
        {% endfor %}
      </ul>
      {% if (W.neta65 | length) > 6 %}<p class="mt-2 text-sm text-muted">{{ "community.digest.and_more" | t(lang, { n: (W.neta65 | length) - 6 }) }}</p>{% endif %}
      {% else %}
      <p class="mt-2 text-sm leading-relaxed text-muted">{{ ("community.writers.card_none" if W.texas | length else "community.writers.card_empty") | t(lang) }}</p>
      {% endif %}
      {% if W.texas | length %}
      <h4 class="eyebrow mt-5 flex items-center gap-1.5">{% icon "map-pin", "size-3.5" %} {{ "community.writers.group_texas" | t(lang) }}</h4>
      <ul class="mt-2 space-y-1.5 text-sm" role="list">
        {% for it in W.texas | limit(5) %}
        {%- set place = it | cmWriterPlace(lang) -%}
        <li class="leading-snug"><a class="font-medium text-ink no-underline hover:text-gv hover:underline" href="{{ it.url }}" target="_blank" rel="noopener">{{ it | tx("title", lang) }}<span class="sr-only"> {{ "community.new_tab" | t(lang) }}</span></a> <span class="text-muted">— {{ it | cmWriterName(lang) }}{% if place %}, {{ place }}{% endif %}</span></li>
        {% endfor %}
      </ul>
      {% if (W.texas | length) > 5 %}<p class="mt-2 text-sm text-muted">{{ "community.digest.and_more" | t(lang, { n: (W.texas | length) - 5 }) }}</p>{% endif %}
      {% endif %}
      {#- Full-width buttons: the card is narrow (20–22rem), so the labels get the whole row. -#}
      <div class="mt-5 flex flex-wrap gap-2 border-t border-line pt-4">
        <a class="btn-secondary btn-sm w-full text-center" href="{{ '/published/' | lurl(lang) }}">{% icon "award", "size-4 shrink-0" %} {{ "community.writers.see_all" | t(lang, { n: W.allDays }) }}</a>
        {% if not (W.neta65 | length) %}<a class="btn-secondary btn-sm w-full text-center" href="{{ '/contribute/' | lurl(lang) }}">{% icon "pen-line", "size-4 shrink-0" %} {{ "community.writers.write_cta" | t(lang) }}</a>{% endif %}
      </div>
    </div>
    {% endif %}
    </div>
  </div>
</section>
