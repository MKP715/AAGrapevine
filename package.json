{
  "name": "neta65-grapevine-lavina",
  "version": "2.0.0",
  "private": true,
  "description": "NETA 65 Grapevine / La Viña Committee website — bilingual, self-updating (GitHub Actions + Eleventy).",
  "license": "GPL-3.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "eleventy",
    "start": "eleventy --serve --quiet",
    "clean": "node -e \"require('fs').rmSync('_site',{recursive:true,force:true})\"",
    "sync": "python -m scripts.sync.run_all",
    "fixtures": "python -m scripts.dev.make_fixtures"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tailwindcss/cli": "^4.3.3",
    "alpinejs": "^3.17.4",
    "glightbox": "^3.3.1",
    "js-yaml": "^5.4.2",
    "lite-youtube-embed": "^0.3.4",
    "lucide-static": "^1.47.0",
    "markdown-it": "^15.0.2",
    "minisearch": "^7.2.0",
    "qrcode": "^1.5.4",
    "tailwindcss": "^4.3.3"
  }
}
